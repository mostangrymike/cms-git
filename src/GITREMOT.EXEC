/* M262: bounded GitHub HTTPS remote metadata. */
address cms
parse arg action rest
action=translate(strip(action))

if action='' | action='-V' | action='--VERBOSE' then do
 if strip(rest)\='' then do
  say 'Usage: GIT REMOTE [-v|--verbose]'
  exit 4
 end
 call loadremotes
 if result\='OK' then exit 8
 if remote.0=0 then do
  say 'No remotes configured'
  exit 0
 end
 do i=1 to remote.0
  say remote.name.i 'https://github.com/'remote.path.i'.git'
 end
 exit 0
end

if action='ADD' then do
 parse var rest name url extra
 if name='' | url='' | extra\='' then do
  say 'Usage: GIT REMOTE ADD name https://github.com/owner/repository.git'
  exit 4
 end
 call validname name
 if result\='OK' then do
  say 'GITREMOT: invalid remote name'
  exit 4
 end
 call parseurl url
 if result='ERROR' then do
  say 'GITREMOT: expected a GitHub HTTPS repository URL'
  exit 4
 end
 path=result
 if length(name)+8+length(path)>80 then do
  say 'GITREMOT: name and URL do not fit a CMS record'
  exit 4
 end
 call loadremotes
 if result\='OK' then exit 8
 do i=1 to remote.0
  if translate(remote.name.i)=translate(name) then do
   say 'GITREMOT: remote already exists' name
   exit 8
  end
 end
 if remote.0>=8 then do
  say 'GITREMOT: maximum of 8 remotes reached'
  exit 8
 end
 oldcount=remote.0
 do i=1 to oldcount
  oldname.i=remote.name.i
  oldpath.i=remote.path.i
 end
 remote.0=oldcount+1
 idx=remote.0
 remote.name.idx=name
 remote.path.idx=path
 call writeremotes
 if result\='OK' then do
  call restoreold
  say 'GITREMOT: remote save failed'
  exit 8
 end
 say 'Added remote' name 'https://github.com/'path'.git'
 exit 0
end

if action='GET' then do
 parse var rest name extra
 if name='' | extra\='' then do
  say 'Usage: GIT REMOTE GET name'
  exit 4
 end
 call validname name
 if result\='OK' then exit 4
 call loadremotes
 if result\='OK' then exit 8
 do i=1 to remote.0
  if translate(remote.name.i)=translate(name) then do
   say 'REMOTE-DATA' remote.name.i 'github.com' remote.path.i
   exit 0
  end
 end
 say 'GITREMOT: remote not found' name
 exit 8
end

if action='REMOVE' | action='RM' then do
 parse var rest name extra
 if name='' | extra\='' then do
  say 'Usage: GIT REMOTE REMOVE name'
  exit 4
 end
 call validname name
 if result\='OK' then exit 4
 call loadremotes
 if result\='OK' then exit 8
 oldcount=remote.0
 found=0
 do i=1 to oldcount
  oldname.i=remote.name.i
  oldpath.i=remote.path.i
  if translate(remote.name.i)=translate(name) then found=i
 end
 if found=0 then do
  say 'GITREMOT: remote not found' name
  exit 8
 end
 drop nextname. nextpath.
 n=0
 do i=1 to oldcount
  if i\=found then do
   n=n+1
   nextname.n=oldname.i
   nextpath.n=oldpath.i
  end
 end
 remote.0=n
 do i=1 to n
  remote.name.i=nextname.i
  remote.path.i=nextpath.i
 end
 call writeremotes
 if result\='OK' then do
  call restoreold
  say 'GITREMOT: remote removal failed'
  exit 8
 end
 say 'Removed remote' name
 exit 0
end

say 'Usage: GIT REMOTE [-v|--verbose] | ADD name URL | GET name'
say '       GIT REMOTE REMOVE name'
exit 4

loadremotes:
 drop remote.name. remote.path.
 remote.0=0
 'STATE GITMETA REPO A'
 if rc\=0 then do
  say 'GITREMOT: initialize a repository first'
  return 'ERROR'
 end
 'STATE GITREMOT REPO A'
 if rc=28 then return 'OK'
 if rc\=0 then do
  say 'GITREMOT: cannot inspect remote database RC' rc
  return 'ERROR'
 end
 drop rm.
 'EXECIO * DISKR GITREMOT REPO A 1 (STEM RM. FINIS'
 if rc\=0 | rm.0<1 | rm.1\='GITREMOT 1' then do
  say 'GITREMOT: invalid remote database header'
  return 'ERROR'
 end
 do j=2 to rm.0
  if words(rm.j)\=3 | word(rm.j,1)\='REMOTE' then do
   say 'GITREMOT: invalid remote record' j
   return 'ERROR'
  end
  n=word(rm.j,2)
  p=word(rm.j,3)
  call validname n
  if result\='OK' then return 'ERROR'
  call validpath p
  if result\='OK' then return 'ERROR'
  do k=1 to remote.0
   if translate(remote.name.k)=translate(n) then do
    say 'GITREMOT: duplicate remote name' n
    return 'ERROR'
   end
  end
  remote.0=remote.0+1
  idx=remote.0
  remote.name.idx=n
  remote.path.idx=p
 end
 if remote.0>8 then return 'ERROR'
 return 'OK'

writeremotes:
 drop wr.
 if remote.0=0 then do
  'STATE GITREMOT REPO A'
  if rc=0 then 'ERASE GITREMOT REPO A'
  if rc\=0 & rc\=28 then return 'ERROR'
  return 'OK'
 end
 wr.1='GITREMOT 1'
 do wi=1 to remote.0
  idx=wi+1
  wr.idx='REMOTE' remote.name.wi remote.path.wi
  if length(wr.idx)>80 then return 'ERROR'
 end
 wr.0=remote.0+1
 'STATE GITREMOT REPO A'
 hadfile=rc=0
 if rc\=0 & rc\=28 then return 'ERROR'
 if hadfile then do
  drop bakfile.
  'EXECIO * DISKR GITREMOT REPO A 1 (STEM BAKFILE. FINIS'
  if rc\=0 then return 'ERROR'
  oldfile.0=BAKFILE.0
  do bi=1 to BAKFILE.0
   oldfile.bi=BAKFILE.bi
  end
 end
 if hadfile then do
  'ERASE GITREMOT REPO A'
  if rc\=0 then return 'ERROR'
 end
 'EXECIO' wr.0 'DISKW GITREMOT REPO A 1 (STEM WR. FINIS'
 if rc\=0 then do
  if hadfile then call writeoldfile
  return 'ERROR'
 end
 drop verifyfile.
 'EXECIO * DISKR GITREMOT REPO A 1 (STEM VERIFYFILE. FINIS'
 if rc\=0 | verifyfile.0\=wr.0 then do
  if hadfile then call restoreoldfile
  else 'ERASE GITREMOT REPO A'
  return 'ERROR'
 end
 do vi=1 to wr.0
  if verifyfile.vi\=wr.vi then do
   if hadfile then call restoreoldfile
   else 'ERASE GITREMOT REPO A'
   return 'ERROR'
  end
 end
 return 'OK'

restoreold:
 remote.0=oldcount
 do ri=1 to oldcount
  remote.name.ri=oldname.ri
  remote.path.ri=oldpath.ri
 end
 return

restoreoldfile:
 'STATE GITREMOT REPO A'
 if rc=0 then 'ERASE GITREMOT REPO A'
 call writeoldfile
 return

writeoldfile:
 'EXECIO' oldfile.0 'DISKW GITREMOT REPO A 1 (STEM OLDFILE. FINIS'
 return

parseurl:
 parse arg u
 upperurl=translate(u)
 if left(upperurl,19)\='HTTPS://GITHUB.COM/' then return 'ERROR'
 p=substr(u,20)
 if p='' | pos('?',p)>0 | pos('#',p)>0 | pos('@',p)>0 |,
    pos(':',p)>0 | pos('%',p)>0 | pos('\\',p)>0 then return 'ERROR'
 if right(translate(p),4)='.GIT' then p=left(p,length(p)-4)
 call validpath p
 if result\='OK' then return 'ERROR'
 return p

validpath:
 parse arg p
 slash=pos('/',p)
 if slash<2 | slash=length(p) |,
    pos('/',substr(p,slash+1))>0 then return 'ERROR'
 owner=substr(p,1,slash-1)
 repo=substr(p,slash+1)
 if length(owner)>39 | length(repo)>39 then return 'ERROR'
 if owner='.' | owner='..' | repo='.' | repo='..' then return 'ERROR'
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-'
 if verify(translate(owner),allowed)\=0 |,
    verify(translate(repo),allowed)\=0 then return 'ERROR'
 if pos('..',owner)>0 | pos('..',repo)>0 then return 'ERROR'
 if right(owner,1)='.' | right(repo,1)='.' then return 'ERROR'
 return 'OK'

validname:
 parse arg n
 if n='' | length(n)>16 | n='.' | n='..' | pos('..',n)>0 then return 'ERROR'
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-'
 if verify(translate(n),allowed)\=0 then return 'ERROR'
 if left(n,1)='.' | right(n,1)='.' then return 'ERROR'
 return 'OK'

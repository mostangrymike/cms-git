if command = 'HISTORYFIRSTSUBJECTS-REF-FULL' then do
   address command 'EXEC GITVREF HISTFSUBJ' rest
   exit rc
end
if command = 'HISTORYFIRSTBODIES-REF-FULL' then do
   address command 'EXEC GITVREF HISTFBODY' rest
   exit rc
end
if command = 'HISTORYFIRSTLOG-REF-FULL' then do
   address command 'EXEC GITVREF HISTFLOG' rest
   exit rc

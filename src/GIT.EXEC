end
if command = 'HISTORYTRANSITIONS-REF-FULL' then do
   address command 'EXEC GITVREF HISTTRANS' rest
   exit rc
end
if command = 'HISTORYREPORT-REF-FULL' then do
   address command 'EXEC GITVREF HISTREPORT' rest
   exit rc
end
if command = 'HISTORYBOUNDS-REF-FULL' then do
   address command 'EXEC GITVREF HISTBOUNDS' rest
   exit rc
end
if command = 'HISTORYCHRONOLOGY-REF-FULL' then do
   address command 'EXEC GITVREF HISTCHRON' rest
   exit rc
end
if command = 'HISTORYACTORS-REF-FULL' then do
   address command 'EXEC GITVREF HISTACTORS' rest

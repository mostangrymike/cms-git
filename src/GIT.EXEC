   address command 'EXEC GITVREF READ' rest
   exit rc
end
if command = 'DIR-REF-FULL' then do
   address command 'EXEC GITVREF DIR' rest
   exit rc
end
if command = 'IMPORT-OBJECT' then do
   call gitimport rest
   exit result
end
if command = 'FETCH-DISCOVER' then do
   'EXEC GITFETCH DISCOVER' rest
   exit rc
end
if command = 'FETCH-POST' then do
   'EXEC GITPOST POST' rest
   exit rc
end
if command = 'FETCH-STORE' then do
   'EXEC GITPOST STORE' rest
   exit rc
end
if command = 'FETCH-PACK' then do
   'EXEC GITFPACK' rest
   exit rc
end
if command = 'FETCH-IMPORT' then do
   'EXEC GITFIMP' rest
   exit rc
end
if command = 'FETCH-ACTIVATE' then do
   'EXEC GITFACT' rest
   exit rc
end
if command = 'FETCH-TRACK' then do
   parse var rest trackremote trackbranch trackoid expectedoid extra
   if trackremote='' | trackbranch='' | trackoid='' | extra\='' then do
      say 'Usage: GIT FETCH-TRACK remote branch new-oid [expected-old-oid]'
      exit 4
   end
   if expectedoid='' then,
      expectedoid='0000000000000000000000000000000000000000'
   call validremotename trackremote
   if result\='OK' then do
      say 'GIT: invalid remote name'
      exit 4
   end
   call validbranch trackbranch
   if result\='OK' then do
      say 'GIT: invalid remote branch name'
      exit 4
   end
   trackingref='refs/remotes/'||trackremote||'/'||trackbranch
   if length(trackingref)>35 then do
      say 'GIT: remote-tracking ref exceeds the REF2 record limit'
      exit 4
   end
   trackoid=translate(trackoid)
   expectedoid=translate(expectedoid)
   if length(trackoid)\=40 | length(expectedoid)\=40 |,
      verify(trackoid,'0123456789ABCDEF')\=0 |,
      verify(expectedoid,'0123456789ABCDEF')\=0 |,
      trackoid='0000000000000000000000000000000000000000' then do
      say 'GIT: invalid remote-tracking object-id'
      exit 4
   end
   'EXEC GITUPD' trackingref trackoid expectedoid
   exit rc
end
/* M273: fetch, verify and apply one fast-forward pull to a clean flat tree. */
if command='PULL' then do
   /* No-arg pull: resolve remote, bridge and port from GITREMOT config. */
   if strip(rest)='' then do
      drop remout.
      remout.0=0
      'PIPE CMS EXEC GITREMOT | STEM REMOUT.'
      if rc\=0 | remout.0=0 then do
         say 'GIT PULL: no remote configured; use GIT REMOTE ADD first'
         exit 8
      end
      pullremote=word(remout.1,1)
      call readbridge
      if result\='OK' then do
         say 'GIT PULL: invalid GITBRIDG CONFIG record'
         exit 8
      end
      pullbridge=bridgehost
      pullport=bridgeport
      pullpack='PULLNX01'
      pullindex='PULLIX01'
      pullbranch='HEAD'
      pullextra=''
   end
   else do
      parse var rest pullremote pullbridge pullport pullpack pullindex,
          pullbranch pullextra
   end
   if pullremote='' | pullbridge='' | pullport='' | pullpack='' |,
      pullindex='' | pullextra\='' then do
      say 'Usage: GIT PULL remote bridge port pack index [branch|HEAD]'
      say '   or: GIT PULL  (uses first configured remote and default bridge)'
      exit 4
   end
   if pullbranch='' then pullbranch='HEAD'
   call validremotename pullremote
   if result\='OK' then exit 4
   call validbranch pullbranch
   if result\='OK' then exit 4
   pullport=strip(pullport)
   if datatype(pullport,'W')\=1 | pullport<1 | pullport>65535 then exit 4
   pullbridge=strip(pullbridge)
   bridgechars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   bridgechars=bridgechars||'0123456789.-'
   if pullbridge='' | length(pullbridge)>255 |,
      verify(pullbridge,bridgechars)\=0 then exit 4
   pullpack=translate(pullpack)
   pullindex=translate(pullindex)
   cmsnames='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
   if length(pullpack)<1 | length(pullpack)>8 |,
      verify(pullpack,cmsnames)\=0 |,
      length(pullindex)<1 | length(pullindex)>8 |,
      verify(pullindex,cmsnames)\=0 | pullpack=pullindex then do
      say 'GIT PULL: pack and index names must be distinct CMS filenames'
      exit 4
   end
   if objectfm='' then exit 8
   /* The pack, stage, index and newly installed loose objects coexist
      during activation, so the free-space check waits until the fetched
      size is known. Project state and fetch artifacts live on G. */
   /* A failed pull deliberately retains its pack, stage and index for
      recovery.  A retry with the same fixed names would otherwise stop at
      "already exists", so clear stale pull artifacts up front and say so. */
   stale.1=pullpack 'PACK G'
   stale.2=pullpack 'META G'
   stale.3=pullpack 'STAGE' objectfm
   stale.4=pullindex 'INDEX' objectfm
   do sci=1 to 4
      parse var stale.sci sfn sft sfm
      'STATE' sfn sft sfm
      if rc=0 then do
         'ERASE' sfn sft sfm
         if rc\=0 then do
            say 'GIT PULL: cannot erase stale' sfn sft sfm
            exit 8
         end
         say 'GIT PULL: erased stale' sfn sft sfm
      end
      else if rc\=28 then do
         say 'GIT PULL: cannot inspect' sfn sft sfm
         exit 8
      end
   end
   drop headout.
   headout.0=0
   'PIPE CMS EXEC GITVREF HEAD | STEM HEADOUT.'
   if rc\=0 | headout.0\=1 then exit 8
   parse var headout.1 pullhead extra
   if extra\='' | left(pullhead,11)\='refs/heads/' then exit 8
   currentbranch=substr(pullhead,12)
   call validbranch currentbranch
   if result\='OK' then exit 8
   /* HEAD means "the current branch"; the fetch must name it explicitly so
      the later remote-branch match check can compare like with like. */
   if translate(pullbranch)='HEAD' then pullrequest=currentbranch
   else do
      if left(pullbranch,11)='refs/heads/' then,
         pullrequested=substr(pullbranch,12)
      else pullrequested=pullbranch
      call validbranch pullrequested
      if result\='OK' | pullrequested\=currentbranch then do
         say 'GIT PULL: selected remote branch must match the current branch'
         exit 8
      end
      pullrequest=pullrequested
   end
   drop statusout.
   statusout.0=0
   'PIPE CMS EXEC GITWT STATUS --SHORT | STEM STATUSOUT.'
   if rc\=0 then do
      say 'GIT PULL: cannot verify a clean worktree'
      exit 8
   end
   do si=1 to statusout.0
      /* CMS diagnostics captured by PIPE are not worktree state. */
      if left(statusout.si,3)='DMS' then iterate
      if left(statusout.si,2)\='##' then do
         say 'GIT PULL: local worktree has changes; no fetch started'
         exit 8
      end
   end
   /* Tell the server which commit we already have so it can include the
      connecting commit chain.  A depth-1 pack omits parent commits, which
      makes the later ancestry check impossible.  Read the tip straight from
      REF2: GITVREF RESOLVE also loads the native object store, which a
      shallow loose-object repository does not populate. */
   call localbranchtip currentbranch
   pullhave=result
   if pullhave='' then,
      say 'GIT PULL: no local tip; requesting a shallow depth-1 pack'
   drop fetchout.
   fetchout.0=0
   fetchcmd='EXEC GITFPACK'||' '||pullremote||' '||pullbridge||' '||,
       pullport||' '||pullpack||' '||pullrequest
   if pullhave\='' then fetchcmd=fetchcmd||' HAVE '||pullhave
   'PIPE CMS' fetchcmd '| STEM FETCHOUT.'
   if rc\=0 then do
      say 'GIT PULL: fetch failed; local refs and workfiles unchanged'
      exit rc
   end
   /* CMS PIPE STEM wraps long output at column 80, even inside an OID.
      Progress lines are not part of the verified-result record. */
   fetchline=''
   do fi=1 to fetchout.0
      fline=strip(fetchout.fi)
      if left(fline,9)='GITFPACK:' then iterate
      fetchline=fetchline||fline
   end
   if words(fetchline)\=11 |,
      word(fetchline,1)\='FETCH' | word(fetchline,2)\='PACK' |,
      word(fetchline,3)\='VERIFIED' |,
      translate(word(fetchline,4))\=translate(pullremote) |,
      word(fetchline,8)\='BYTES' | word(fetchline,10)\='OBJECTS' |,
      datatype(word(fetchline,9),'W')\=1 |,
      datatype(word(fetchline,11),'W')\=1 then do
      say 'GIT PULL: verified fetch result framing failed'
      exit 8
   end
   pullbranchref=word(fetchline,5)
   pullnew=translate(word(fetchline,6))
   if word(fetchline,7)\=pullpack | length(pullnew)\=40 |,
      verify(pullnew,'0123456789ABCDEF')\=0 |,
      left(pullbranchref,11)\='refs/heads/' then do
      say 'GIT PULL: verified fetch did not identify one branch tip'
      exit 8
   end
   branchfromremote=substr(pullbranchref,12)
   call validbranch branchfromremote
   if result\='OK' | branchfromremote\=currentbranch then do
      say 'GIT PULL: remote branch does not match current branch'
      exit 8
   end
   /* The server returns a valid empty pack when the local tip already
      contains everything it asked for.  Nothing to import or activate. */
   if word(fetchline,11)=0 then do
      if pullhave=pullnew then do
         say 'Already up to date' pullnew
         exit 0
      end
      say 'GIT PULL: server returned an empty pack for a new tip'
      exit 8
   end
   /* Peak usage is roughly pack + stage + index + loose objects.  Reject
      before import when the selected disk cannot hold about five times
      the fetched pack, plus a fixed metadata allowance. */
   pullbytes=word(fetchline,9)
   call freespace objectfm
   if result='ERROR' then do
      say 'GIT PULL: cannot inspect object disk' objectfm
      exit 8
   end
   needblocks=(pullbytes % 4096) * 5 + 1024
   if result < needblocks then do
      say 'GIT PULL: object disk' objectfm 'has' result 'free blocks;'||,
          needblocks 'required for this pull'
      exit 8
   end
   'EXEC GIT FETCH-IMPORT' pullpack objectfm
   if rc\=0 then do
      say 'GIT PULL: import failed; pack retained for recovery'
      exit rc
   end
   incopt=''
   if pullhave\='' then incopt=' INCREMENTAL'
   'EXEC GIT FETCH-ACTIVATE' pullpack pullindex objectfm||incopt
   if rc\=0 then do
      say 'GIT PULL: activation failed; stage and index retained'
      exit rc
   end
   call localbranchtip currentbranch
   pullold=result
   zeros='0000000000000000000000000000000000000000'
   /* An unborn branch has no local tip: the first pull creates it.  The
      ref updater only takes this path when HEAD still names this branch and
      no branch record exists, so a missing tip cannot overwrite another
      branch. */
   if pullold='' then pullold=zeros
   if pullold\=zeros &,
      (length(pullold)\=40 | verify(pullold,'0123456789ABCDEF')\=0) then exit 8
   if pullnew=pullold then do
      say 'Already up to date' pullold
      exit 0
   end
   if pullold\=zeros then do
      drop ancestorout.
      ancestorout.0=0
      ancestorcmd='EXEC GITVREF IS-ANCESTOR'||' '||pullold||' '||pullnew
      'PIPE CMS' ancestorcmd '| STEM ANCESTOROUT.'
      /* CMS PIPE STEM wraps at column 80, including inside an OID. */
      ancestorline=''
      do ai=1 to ancestorout.0
         ancestorline=ancestorline||strip(ancestorout.ai)
      end
      if rc\=0 |,
         ancestorline\='ANCESTOR YES' pullold pullnew then do
         say 'GIT PULL: remote tip is not a fast-forward; local refs unchanged'
         exit 8
      end
   end
   pullcheckcmd='EXEC GITWT CHECK-PULL'||' '||currentbranch||' '||,
       pullold||' '||pullnew
   drop pullcheckout.
   pullcheckout.0=0
   'PIPE CMS' pullcheckcmd '| STEM PULLCHECKOUT.'
   if rc\=0 then do
      say 'GIT PULL: worktree preflight failed; local refs unchanged'
      exit 8
   end
   trackingref='refs/remotes/'||pullremote||'/'||branchfromremote
   if length(trackingref)>35 then do
      say 'GIT PULL: remote-tracking ref exceeds the REF2 limit'
      exit 8
   end
   'EXECIO * DISKR GITREF2 REPO G 1 (STEM PULLREFS. FINIS'
   if rc\=0 | PULLREFS.0<2 | PULLREFS.1\='REF2 1' then exit 8
   oldtracking='0000000000000000000000000000000000000000'
   trackcount=0
   do ri=2 to PULLREFS.0
      if word(PULLREFS.ri,1)='REF' &,
         word(PULLREFS.ri,2)=trackingref then do
         if words(PULLREFS.ri)\=3 then exit 8
         oldtracking=translate(word(PULLREFS.ri,3))
         trackcount=trackcount+1
      end
   end
   if trackcount>1 | length(oldtracking)\=40 |,
      verify(oldtracking,'0123456789ABCDEF')\=0 then exit 8
   'EXEC GIT FETCH-TRACK' pullremote branchfromremote pullnew oldtracking
   if rc\=0 then do
      say 'GIT PULL: remote-tracking ref update failed; local branch unchanged'
      exit rc
   end
   'EXEC GITUPD PULL-HEAD' currentbranch pullold pullnew
   if rc\=0 then do
      say 'GIT PULL: branch unchanged; tracking ref records fetched tip'
      exit rc
   end
   say 'PULL COMPLETE' pullremote branchfromremote pullold pullnew
   say 'PULL PACK RETAINED' pullpack 'INDEX' pullindex objectfm
   exit 0
end
/* M281: push local commits to a remote Git repository. */
if command='PUSH' then do
   'EXEC GITPUSH' rest
   exit rc
end
/* M274: clone a GitHub repository into an empty CMS file area. */
if command='CLONE' then do
   parse var rest cloneurl clonefm clonearg1 clonearg2 cloneextra
   if cloneurl='' | cloneextra\='' then do
      say 'Usage: GIT CLONE <https-url> [object-filemode] [bridge] [port]'
      exit 4
   end
   if clonefm='' then clonefm='G'
   clonefm=translate(clonefm)
   if verify(clonefm,'ABCDEFGHIJKLMNOPQRSTUVWXYZ')\=0 then do
      say 'GIT CLONE: invalid object filemode'
      exit 4
   end
   if clonefm\='G' then do
      say 'GIT CLONE: this installation stores project data on filemode G'
      exit 4
   end
   call readbridge
   if result\='OK' then do
      say 'GIT CLONE: invalid GITBRIDG CONFIG record'
      exit 8
   end
   clonebridge=bridgehost
   cloneport=bridgeport
   if clonearg1\='' then clonebridge=clonearg1
   if clonearg2\='' then cloneport=clonearg2
   clonebridge=strip(clonebridge)
   cloneport=strip(cloneport)
   bridgechars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   bridgechars=bridgechars||'0123456789.-'
   if clonebridge='' | length(clonebridge)>255 |,
      verify(clonebridge,bridgechars)\=0 then do
      say 'GIT CLONE: invalid bridge host'
      exit 4
   end
   if datatype(cloneport,'W')\=1 | cloneport<1 | cloneport>65535 then do
      say 'GIT CLONE: invalid bridge port'
      exit 4
   end
   'STATE GITMETA REPO G'
   if rc=0 then do
      say 'GIT CLONE: repository already initialized; use GIT PULL to resume'
      exit 8
   end
   if rc\=28 then do
      say 'GIT CLONE: cannot inspect repository metadata RC' rc
      exit 8
   end
   /* GITREMOT needs repository metadata, so parse and discover before
      INIT.  Use the advertised HEAD symref so the initial branch matches
      the repository default instead of assuming "main". */
   call parsecloneurl cloneurl
   if result='ERROR' then do
      say 'GIT CLONE: expected a GitHub HTTPS repository URL'
      exit 4
   end
   clonepath=result
   drop disco.
   disco.0=0
   discocmd='EXEC GITFETCH DISCOVER' clonebridge cloneport 'github.com',
       clonepath 'HEAD'
   'PIPE CMS' discocmd '| STEM DISCO.'
   clonebranch=''
   cloneoid=''
   cloneoidcount=0
   clonepass=0
   do ci=1 to disco.0
      if word(disco.ci,1)='FETCH' & word(disco.ci,2)='OID' &,
         words(disco.ci)=3 then do
         candidate=translate(word(disco.ci,3))
         if length(candidate)=40 &,
            verify(candidate,'0123456789ABCDEF')=0 then do
            cloneoidcount=cloneoidcount+1
            cloneoid=candidate
         end
      end
      if word(disco.ci,1)='FETCH' & word(disco.ci,2)='DEFAULT' &,
         word(disco.ci,3)='BRANCH' & words(disco.ci)=4 then do
         branchref=word(disco.ci,4)
         if left(branchref,11)='refs/heads/' then,
            clonebranch=substr(branchref,12)
      end
      if disco.ci='M169 FETCH DISCOVERY PASS' then clonepass=clonepass+1
   end
   if cloneoidcount\=1 | clonepass\=1 then do
      say 'GIT CLONE: default-branch discovery framing failed'
      exit 8
   end
   call validbranch clonebranch
   if result\='OK' then do
      say 'GIT CLONE: remote did not advertise a usable default branch'
      exit 8
   end
   'EXEC GIT INIT' clonefm clonebranch
   if rc\=0 then do
      say 'GIT CLONE: repository initialization failed'
      exit rc
   end
   'EXEC GIT REMOTE ADD origin' cloneurl
   if rc\=0 then do
      say 'GIT CLONE: remote configuration failed'
      'ERASE GITMETA REPO G'
      'ERASE GITREF2 REPO G'
      exit rc
   end
   'EXEC GIT PULL origin' clonebridge cloneport 'PULLNX01 PULLIX01 HEAD'
   if rc\=0 then do
      say 'GIT CLONE: initial pull failed; repository partially initialized'
      say 'GIT CLONE: after correcting the failure, run: GIT PULL'
      exit rc
   end
   say 'GIT CLONE COMPLETE' cloneurl
   exit 0
end
if command = 'PACK-CENSUS' then do
   if strip(rest)\='' then do
      say 'Usage: GIT PACK-CENSUS'
      exit 4
   end
   'GITPCENS'
   exit rc
end
/* Named output uses CMS STATE before a FILEDEF can manufacture an
 * apparent input stream for a file that is not yet on disk. */
if command = 'PACK-IMPORT' | command = 'PACK-INDEX' then do
   parse upper var rest target extra
   if target = '' then do
      if command = 'PACK-IMPORT' then 'GITPIMP IMPORT'
      else 'GITPIDX BUILD'
      exit rc
   end
   valid='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@$#'
   first='ABCDEFGHIJKLMNOPQRSTUVWXYZ@$#'
   if extra \= '' | length(target)>8 | length(target)<1 then do
      say 'Usage: GIT' command '[new CMS filename]'
      exit 4
   end
   if verify(target,valid)\=0 |,
      verify(substr(target,1,1),first)\=0 then do
      say 'GIT: invalid CMS output filename'
      exit 4
   end
   if command = 'PACK-IMPORT' then do
      ftype='STAGE'
      dd='OBJOUT'
   end
   else do
      ftype='INDEX'
      dd='IDXOUT'
   end
   'STATE' target ftype 'A'
   staterc=rc
   if staterc=0 then do
      say 'GIT: output already exists' target ftype 'A'
      exit 8
   end
   if staterc\=28 then do
      say 'GIT: output STATE failed RC' staterc
      exit 8
   end
   'FILEDEF' dd 'DISK' target ftype 'A (RECFM V LRECL 80'
   if rc\=0 then do
      say 'GIT: output FILEDEF failed'
      exit 8
   end
   if command = 'PACK-IMPORT' then 'GITPIMP IMPORT CHECKED'
   else 'GITPIDX BUILD CHECKED'
   workrc=rc
   'FILEDEF' dd 'CLEAR'
   exit workrc
end
if command = 'PACK-CAT' then do
   parse var rest oid extra
   oid=translate(strip(oid))
   if extra\='' | length(oid)\=40 |,
      verify(oid,'0123456789ABCDEF')\=0 then do
      say 'Usage: GIT PACK-CAT object-id'
      exit 4
   end
   'GITPCAT CAT' oid
   exit rc
end
if command = 'PACK-TREE' then do
   parse var rest oid extra
   oid=translate(strip(oid))
   if extra\='' | length(oid)\=40 |,
      verify(oid,'0123456789ABCDEF')\=0 then do
      say 'Usage: GIT PACK-TREE tree-oid'
      exit 4
   end
   'GITPTRE WALK' oid
   exit rc
end
if command = 'GC' | command = 'REPACK' then do
   'EXEC GITGC' command rest
   exit rc
end
if command = 'CHECKOUT-FILE' then do
   'EXEC GITWT CHECKOUT' rest
   exit rc
end
if command = 'CHECKOUT-TREE' then do
   'EXEC GITWT CHECKOUT-TREE' rest
   exit rc
end
if command = 'STATUS' then do
   'EXEC GITWT STATUS' rest
   exit rc
end
if command = 'DIFF' then do
   'EXEC GITWT DIFF' rest
   exit rc
end
if command = 'RESET' then do
   'EXEC GITWT RESET' rest
   exit rc
end
if command = 'RESTORE' then do
   parse var rest restoreopt restorepaths
   if translate(restoreopt)='--SOURCE' then do
      parse var restorepaths restorespec restoretarget sourcepaths
      if restorespec='' | translate(restoretarget)\='--WORKTREE' |,
         strip(sourcepaths)='' then do
         say 'Usage: GIT RESTORE --source revision --worktree [--] path...'
         exit 4
      end
      address command 'EXEC GITWT RESTORE-WORKTREE --SOURCE' restorespec,
         sourcepaths
      exit rc
   end
   if left(translate(restoreopt),9)='--SOURCE=' then do
      restorespec=substr(restoreopt,10)
      parse var restorepaths restoretarget sourcepaths
      if restorespec='' | translate(restoretarget)\='--WORKTREE' |,
         strip(sourcepaths)='' then do
         say 'Usage: GIT RESTORE --source revision --worktree [--] path...'
         exit 4
      end
      address command 'EXEC GITWT RESTORE-WORKTREE --SOURCE' restorespec,
         sourcepaths
      exit rc
   end
   if translate(restoreopt)='--WORKTREE' then do
      if strip(restorepaths)='' then do
         say 'Usage: GIT RESTORE --worktree [--] path...'
         exit 4
      end
      address command 'EXEC GITWT RESTORE-WORKTREE' restorepaths
      exit rc
   end
   if translate(restoreopt)\='--STAGED' | strip(restorepaths)='' then do
      say 'Usage: GIT RESTORE --staged [--] path...'
      exit 4
   end
   address command 'EXEC GITWT RESET' restorepaths
   exit rc
end
if command = 'ADD' then do
   'EXEC GITWT ADD' rest
   exit rc
end
if command = 'COMMIT-STAGED' then do
   'EXEC GITWT COMMIT' rest
   exit rc
end
if command = 'COMMIT' then do
   'EXEC GIT COMMIT-CURRENT' rest
   exit rc
end
if command = 'COMMIT-STAGED-REF' then do
   parse var rest cref expected copts
   cref=strip(cref)
   expected=translate(strip(expected))
   copts=strip(copts)
   if cref='' | expected='' | copts='' then do
      say 'Usage: GIT COMMIT-STAGED-REF ref expected-old options'
      exit 4
   end
   if length(expected)\=40 |,
      verify(expected,'0123456789ABCDEF')\=0 then do
      say 'GIT: invalid expected old object-id' expected
      exit 4
   end
   drop cr.
   cr.0=0
   'PIPE CMS EXEC GITWT COMMIT' copts '| STEM cr.'
   crc=rc
   do cri=1 to cr.0
      say cr.cri
   end
   if crc\=0 then exit crc
   parents=0
   commits=0
   parent=''
   newcommit=''
   do cri=1 to cr.0
      if word(cr.cri,1)='COMMIT-STAGED' &,
         word(cr.cri,2)='PARENT' & words(cr.cri)=3 then do
         parents=parents+1
         parent=translate(word(cr.cri,3))
      end
      if word(cr.cri,1)='COMMIT-STAGED' &,
         word(cr.cri,2)='COMMIT' & words(cr.cri)=3 then do
         commits=commits+1
         newcommit=translate(word(cr.cri,3))
      end
   end
   if parents\=1 | commits\=1 then do
      say 'GIT: staged commit output framing failed'
      exit 8
   end
   if parent\=expected then do
      say 'GIT: staged commit parent differs from expected old'
      say 'EXPECTED' expected
      say 'PARENT' parent
      exit 8
   end
   address command 'EXEC GIT UPDATE-REF' cref newcommit expected
   urc=rc
   if urc\=0 then do
      say 'COMMIT-STAGED-REF CAS FAIL RC' urc
      exit urc
   end
   drop vr.
   verified=0
   headseen=0
   'EXECIO * DISKR GITREF2 REPO G 1 (STEM VR. FINIS'
   vrc=rc
   if vrc=0 & vr.0>=3 & vr.1='REF2 1' then do
      do vri=2 to vr.0
         if word(vr.vri,1)='HEAD' then do
            if words(vr.vri)=2 then headseen=headseen+1
            else verified=-99
         end
         else if word(vr.vri,1)='REF' then do
            if words(vr.vri)\=3 then verified=-99
            else if word(vr.vri,2)=cref &,
               translate(word(vr.vri,3))=newcommit then,
               verified=verified+1
         end
         else verified=-99
      end
   end
   if vrc\=0 | headseen\=1 | verified\=1 then do
      say 'GIT: post-CAS ref verification failed; rolling back'
      address command 'EXEC GIT UPDATE-REF' cref expected newcommit
      if rc\=0 then say 'GIT: post-CAS rollback failed'
      else say 'GIT: post-CAS rollback restored expected old'
      exit 8
   end
   say 'COMMIT-STAGED-REF REF' cref
   say 'COMMIT-STAGED-REF OLD' expected
   say 'COMMIT-STAGED-REF NEW' newcommit
   say 'COMMIT-STAGED-REF CAS PASS'
   exit 0
end
if command = 'COMMIT-CURRENT' then do
   copts=strip(rest)
   if copts='' then do
      say 'Usage: GIT COMMIT-CURRENT -T seconds -Z zone -M message'
      exit 4
   end
   drop hr.
   'EXECIO * DISKR GITREF2 REPO G 1 (STEM HR. FINIS'
   if rc\=0 | hr.0<3 | hr.1\='REF2 1' then do
      say 'GIT: cannot read current REF2 state'
      exit 8
   end
   headref=''
   headcount=0
   oldoid=''
   oldcount=0
   do hi=2 to hr.0
      if word(hr.hi,1)='HEAD' then do
         if words(hr.hi)\=2 then do
            say 'GIT: invalid HEAD record'
            exit 8
         end
         headcount=headcount+1
         headref=word(hr.hi,2)
      end
   end
   if headcount\=1 | left(headref,11)\='refs/heads/' then do
      say 'GIT: invalid symbolic HEAD'
      exit 8
   end
   do hi=2 to hr.0
      if word(hr.hi,1)='REF' & word(hr.hi,2)=headref then do
         if words(hr.hi)\=3 then do
            say 'GIT: invalid current branch record'
            exit 8
         end
         oldcount=oldcount+1
         oldoid=translate(word(hr.hi,3))
      end
   end
   if oldcount\=1 | length(oldoid)\=40 |,
      verify(oldoid,'0123456789ABCDEF')\=0 then do
      say 'GIT: current branch is unresolved'
      exit 8
   end
   /* Run the integrated commit directly: GITWT itself uses PIPE stages,
      which cannot be nested inside a PIPE CMS stage.  The CAS wrapper
      preserves safety; read the advanced ref back to learn the new tip. */
   cmd='EXEC GIT COMMIT-STAGED-REF' headref oldoid copts
   address command cmd
   ccrc=rc
   if ccrc\=0 then exit ccrc
   drop nr.
   'EXECIO * DISKR GITREF2 REPO G 1 (STEM NR. FINIS'
   nrc=rc
   newcount=0
   newcommit=''
   if nrc=0 & nr.0>=3 & nr.1='REF2 1' then do
      do nri=2 to nr.0
         if word(nr.nri,1)='REF' & word(nr.nri,2)=headref then do
            if words(nr.nri)\=3 then newcount=-99
            else do
               newcount=newcount+1
               newcommit=translate(word(nr.nri,3))
            end
         end
      end
   end
   if nrc\=0 | newcount\=1 | length(newcommit)\=40 |,
      verify(newcommit,'0123456789ABCDEF')\=0 |,
      newcommit=oldoid then do
      say 'GIT: integrated commit result framing failed'
      exit 8
   end
   address command 'EXEC GITWT ACCEPT'
   arc=rc
   if arc\=0 then do
      say 'GIT: worktree accept failed; rolling back current branch'
      address command 'EXEC GIT UPDATE-REF' headref oldoid newcommit
      if rc\=0 then say 'GIT: current branch rollback failed'
      else say 'GIT: current branch rollback restored old commit'
      exit 8
   end
   say 'COMMIT-CURRENT REF' headref
   say 'COMMIT-CURRENT OLD' oldoid
   say 'COMMIT-CURRENT NEW' newcommit
   say 'COMMIT-CURRENT WORKTREE CLEAN'
   exit 0
end

if command = 'HEAD' then do
   if words(rest) \= 0 then exit 4
   call head_readhead
   if result \= 'OK' then exit 8
   say headref
   call head_resolve
   if result \= 'OK' then exit 8
   say headoid
   exit 0
end
if command = 'CHECKOUT' then do
   parse var rest legacy_name legacy_extra
   if legacy_name = '' | legacy_extra \= '' then do
      say 'Usage: GITHEAD CHECKOUT branch'
      exit 4
   end
   call head_validbranch legacy_name
   if result \= 'OK' then exit 4
   call head_readrefs
   if result \= 'OK' then exit 8
   found = 0
   target = ''
   do i = 1 to rr.0
      if word(rr.i,2) = legacy_name then do
         found = found + 1
         target = word(rr.i,3)
      end
   end
   if found = 0 then do
      say 'GITHEAD: branch not found' legacy_name
      exit 8
   end
   if found > 1 then do
      say 'GITHEAD: duplicate branch records' legacy_name
      exit 8
   end
   newref = 'refs/heads/' || legacy_name
   call head_writehead newref
   if result \= 'OK' then exit 8
   say newref
   say target
   exit 0
end

if command = 'VERIFY-OBJECT' | command = 'CAT-OBJECT' then do
   parse var rest oid extra
   oid = translate(oid)
   if oid = '' | extra \= '' | length(oid) \= 40 then do
      say 'Usage: GIT' command 'object-id'
      exit 4
   end
   call readobject oid
   if result \= 'OK' then exit 8
   call hashstored objtype, datahex
   actualoid = result
   if actualoid = 'HASHERROR' then exit 8
   if actualoid \= storedoid then do
      say 'GIT: corrupt object' oid '- content hash mismatch'
      exit 8
   end
   if command = 'VERIFY-OBJECT' then do
      say oid 'OK'
      exit 0
   end
   say 'OID' storedoid
   say 'TYPE' objtype
   say 'DATA' datahex
   exit 0
end

/* M165 plumbing: hash/store an authenticated raw tree hex file. */
if command = 'WRITE-TREE-HEXFILE' then do
   parse var rest fn ft fm extra
   if fn='' | ft='' | fm='' | extra\='' then do
      say 'Usage: GIT WRITE-TREE-HEXFILE fn ft fm'
      exit 4
   end
   fn=translate(fn)
   ft=translate(ft)
   fm=translate(fm)
   drop th.
   'EXECIO * DISKR' fn ft fm '1 (STEM TH. FINIS'
   if rc\=0 then do
      say 'GIT: cannot read tree hex file'
      exit 8
   end
   datahex=''
   if th.0=1 & th.1='EMPTY' then nop
   else do i=1 to th.0
      if word(th.i,1)\='HEX' | words(th.i)\=2 then do
         say 'GIT: malformed tree hex record'
         exit 8
      end
      h=translate(word(th.i,2))
      if h='' | length(h)>64 | length(h)//2\=0 |,
         verify(h,'0123456789ABCDEF')\=0 then do
         say 'GIT: invalid tree hex record'
         exit 8
      end
      datahex=datahex||h
   end
   call hashstored 'TREE',datahex
   treeoid=result
   if treeoid='HASHERROR' then exit 8
   call storeobject treeoid,'TREE',datahex
   if result\='OK' then exit 8
   say treeoid
   exit 0
end

/* M4 tree writer: one or more mode/name/OID triples. */
if command = 'WRITE-TREE' then do
   wc = words(rest)
   if wc < 3 | wc // 3 \= 0 then do
      say 'Usage: GIT WRITE-TREE mode name oid [mode name oid ...]'
      exit 4
   end
   count = wc % 3
   do i = 1 to count
      p = (i-1)*3
      mode.i = word(rest,p+1)
      name.i = word(rest,p+2)
      oid.i = translate(word(rest,p+3))
      if mode.i \= '100644' & mode.i \= '100755' &,
         mode.i \= '120000' & mode.i \= '40000' then do
         say 'GIT: unsupported tree mode' mode.i
         exit 4
      end
      if name.i = '' | pos('/',name.i) > 0 |,
         name.i = '.' | name.i = '..' then do
         say 'GIT: invalid tree entry name' name.i
         exit 4
      end
      if length(oid.i) \= 40 |,
         verify(oid.i,'0123456789ABCDEF') \= 0 then do
         say 'GIT: invalid tree entry object-id' oid.i
         exit 4
      end
      call readobject oid.i
      if result \= 'OK' then exit 8
      if mode.i = '40000' & objtype \= 'TREE' then do
         say 'GIT: tree mode requires TREE object' oid.i
         exit 8
      end
      if mode.i \= '40000' & objtype \= 'BLOB' then do
         say 'GIT: file mode requires BLOB object' oid.i
         exit 8
      end
      call toasciihex name.i
      namehex.i = result
      sortkey.i = x2c(namehex.i)
      if mode.i = '40000' then sortkey.i = sortkey.i || x2c('2F')
   end
   do pass = 1 to count-1
      do i = 1 to count-pass
         j = i + 1
         if sortkey.i >> sortkey.j then do
            t=mode.i; mode.i=mode.j; mode.j=t
            t=name.i; name.i=name.j; name.j=t
            t=oid.i; oid.i=oid.j; oid.j=t
            t=namehex.i; namehex.i=namehex.j; namehex.j=t
            t=sortkey.i; sortkey.i=sortkey.j; sortkey.j=t
         end
      end
   end
   datahex = ''
   do i = 1 to count
      call toasciihex mode.i || ' '
      datahex = datahex || result || namehex.i || '00' || oid.i
   end
   call hashstored 'TREE', datahex
   treeoid = result
   if treeoid = 'HASHERROR' then exit 8
   call storeobject treeoid, 'TREE', datahex
   if result \= 'OK' then exit 8
   say treeoid
   exit 0
end

/*
 * COMMIT-TREE keeps the original one-argument deterministic form and adds
 * explicit proof-level options.  Values containing blanks use underscore as
 * the CMS command-line separator escape; underscores are converted to blanks.
 *
 * GIT COMMIT-TREE tree [-P parent ...] [-A identity] [-C identity]
 *      [-T seconds] [-Z timezone] [-M message]
 */
if command = 'COMMIT-TREE' then do
   treeoid = translate(word(rest,1))
   if treeoid = '' | length(treeoid) \= 40 |,
      verify(treeoid,'0123456789ABCDEF') \= 0 then do
      say 'Usage: GIT COMMIT-TREE tree [-P parent] [-A identity] ...'
      exit 4
   end
   call readobject treeoid
   if result \= 'OK' then exit 8
   if objtype \= 'TREE' then do
      say 'GIT: object is not requested tree' treeoid
      exit 8
   end

   author = 'CMS Git <cms@example.invalid>'
   committer = author
   stamp = '0'
   zone = '+0000'
   message = 'Initial commit'
   parent.0 = 0

   i = 2
   do while i <= words(rest)
      opt = translate(word(rest,i))
      if i = words(rest) then do
         say 'GIT: missing value for COMMIT-TREE option' word(rest,i)
         exit 4
      end
      val = word(rest,i+1)
      if opt = '-P' then do
         poid = translate(val)
         if length(poid) \= 40 | verify(poid,'0123456789ABCDEF') \= 0 then do
            say 'GIT: invalid parent object-id' val
            exit 4
         end
         call readobject poid
         if result \= 'OK' then exit 8
         if objtype \= 'COMMIT' then do
            say 'GIT: parent is not a COMMIT object' poid
            exit 8
         end
         parent.0 = parent.0 + 1
         n = parent.0
         parent.n = poid
      end
      else if opt = '-A' then author = translate(val,' ','_')
      else if opt = '-C' then committer = translate(val,' ','_')
      else if opt = '-T' then stamp = val
      else if opt = '-Z' then zone = val
      else if opt = '-M' then message = translate(val,' ','_')
      else do
         say 'GIT: unknown COMMIT-TREE option' word(rest,i)
         exit 4
      end
      i = i + 2
   end

   if verify(stamp,'0123456789') \= 0 | stamp = '' then do
      say 'GIT: invalid commit timestamp' stamp
      exit 4
   end
   if length(zone) \= 5 |,
      (substr(zone,1,1) \= '+' & substr(zone,1,1) \= '-') |,
      verify(substr(zone,2),'0123456789') \= 0 then do
      say 'GIT: invalid commit timezone' zone
      exit 4
   end
   zhour = substr(zone,2,2) + 0
   zmin = substr(zone,4,2) + 0
   if zhour > 23 | zmin > 59 then do
      say 'GIT: invalid commit timezone' zone
      exit 4
   end
   if author = '' | committer = '' then do
      say 'GIT: author and committer identities must not be empty'
      exit 4
   end

   lower = translate(treeoid,'abcdef','ABCDEF')
   call toasciihex 'tree ' || lower
   datahex = result || '0A'
   do i = 1 to parent.0
      lowerp = translate(parent.i,'abcdef','ABCDEF')
      call toasciihex 'parent ' || lowerp
      datahex = datahex || result || '0A'
   end
   call toasciihex 'author ' || author || ' ' || stamp || ' ' || zone
   datahex = datahex || result || '0A'
   call toasciihex 'committer ' || committer || ' ' || stamp || ' ' || zone
   datahex = datahex || result || '0A0A'
   call toasciihex message
   datahex = datahex || result || '0A'
   call hashstored 'COMMIT', datahex
   commitoid = result
   if commitoid = 'HASHERROR' then exit 8
   call storeobject commitoid, 'COMMIT', datahex
   if result \= 'OK' then exit 8
   say commitoid
   exit 0
end

if command = 'HASH-OBJECT' | command = 'WRITE-OBJECT' then do
   parse var rest fn ft fm extra
   if fn = '' | ft = '' | extra \= '' then do
      say 'Usage: GIT' command 'filename filetype [filemode]'
      exit 4
   end
   /* CMS file identifiers are case-insensitive; normalize them only here. */
   fn = translate(fn)
   ft = translate(ft)
   fm = translate(fm)
   if fm = '' then fm = '*'
   drop line.
   'EXECIO * DISKR' fn ft fm '1 (STEM LINE. FINIS STRIP'
   if rc \= 0 then do
      say 'GIT: cannot read' fn ft fm
      exit rc
   end
   hex = ''
   do i = 1 to line.0
      call toasciihex line.i
      if i > 1 then hex = hex || '0A'
      hex = hex || result
   end
   call hashstored 'BLOB', hex
   oid = result
   if oid = 'HASHERROR' then exit 8
   if command = 'HASH-OBJECT' then do
      say oid
      exit 0
   end
   call storeobject oid, 'BLOB', hex
   if result \= 'OK' then exit 8
   say oid
   exit 0
end

if command = 'HASH-WORKFILE' |,
   command = 'WRITE-WORKFILE' then do
   parse var rest fn ft fm final extra
   if fn = '' | ft = '' | extra \= '' then do
      say 'Usage: GIT' command 'fn ft fm final-lf'
      exit 4
   end
   fn = translate(fn)
   ft = translate(ft)
   fm = translate(fm)
   if fm = '' then fm = 'A'
   if final \= '0' & final \= '1' then do
      say 'GIT: final-lf must be 0 or 1'
      exit 4
   end
   drop wline.
   'EXECIO * DISKR' fn ft fm '1 (STEM WLINE. FINIS'
   if rc \= 0 then do
      say 'GIT: cannot read workfile' fn ft fm
      exit rc
   end
   hex = ''
   do i = 1 to wline.0
      text = strip(wline.i,'T')
      call toasciihex text
      if i > 1 then hex = hex || '0A'
      hex = hex || result
   end
   if final = '1' then hex = hex || '0A'
   call hashstored 'BLOB', hex
   oid = result
   if oid = 'HASHERROR' then exit 8
   if command = 'HASH-WORKFILE' then do
      say oid
      exit 0
   end
   call storeobject oid, 'BLOB', hex
   if result \= 'OK' then exit 8
   say oid
   exit 0
end

say 'GIT: unknown command' command
exit 4

storeobject: procedure expose objectfm
   parse upper arg oid, type, datahex
   objfn = substr(oid,1,8)
   'STATE' objfn 'GITOBJ' objectfm
   if rc = 0 then do
      drop old.
      'EXECIO * DISKR' objfn 'GITOBJ' objectfm '1 (STEM OLD. FINIS'
      if rc \= 0 then do
         say 'GIT: cannot inspect existing object' objfn
         return 'ERROR'
      end
      if old.0 < 1 | word(old.1,1) \= 'OID' |,
         word(old.1,2) \= oid then do
         say 'GIT: object filename collision' objfn
         return 'ERROR'
      end
   end
   drop out.
   out.1 = 'OID' oid
   out.2 = 'TYPE' type
   out.3 = 'SIZE' length(datahex) % 2
   n = 3
   pos = 1
   do while pos <= length(datahex)
      take = min(128,length(datahex)-pos+1)
      n = n + 1
      out.n = 'DATA' substr(datahex,pos,take)
      pos = pos + take
   end
   out.0 = n
   'EXECIO' out.0 'DISKW' objfn 'GITOBJ' objectfm ,
      '1 (STEM OUT. FINIS'
   if rc \= 0 then do
      say 'GIT: cannot store object' oid
      return 'ERROR'
   end
   return 'OK'

readobject: procedure expose storedoid objtype datahex objectfm
   parse upper arg oid
   objfn = substr(oid,1,8)
   drop obj.
   'EXECIO * DISKR' objfn 'GITOBJ' objectfm '1 (STEM OBJ. FINIS'
   if rc \= 0 then do
      say 'GIT: object not found' oid
      return 'ERROR'
   end
   if obj.0 < 3 | word(obj.1,1) \= 'OID' |,
      word(obj.2,1) \= 'TYPE' then do
      say 'GIT: corrupt object' oid '- invalid record layout'
      return 'ERROR'
   end
   storedoid = word(obj.1,2)
   objtype = word(obj.2,2)
   if length(storedoid) \= 40 | storedoid \= oid then do
      say 'GIT: corrupt object' oid '- stored OID mismatch'
      return 'ERROR'
   end
   if objtype \= 'BLOB' & objtype \= 'TREE' &,
      objtype \= 'COMMIT' then do
      say 'GIT: unsupported object type' objtype
      return 'ERROR'
   end
   datahex = ''
   if obj.0 = 3 & word(obj.3,1) = 'DATA' then do
      datahex = word(obj.3,2)
   end
   else do
      if word(obj.3,1) \= 'SIZE' then do
         say 'GIT: corrupt object' oid '- SIZE record missing'
         return 'ERROR'
      end
      size = word(obj.3,2)
      if datatype(size,'W') \= 1 | size < 0 then do
         say 'GIT: corrupt object' oid '- invalid SIZE'
         return 'ERROR'
      end
      do i = 4 to obj.0
         if word(obj.i,1) \= 'DATA' then do
            say 'GIT: corrupt object' oid '- invalid DATA record'
            return 'ERROR'
         end
         chunk = word(obj.i,2)
         if length(chunk) > 128 then do
            say 'GIT: corrupt object' oid '- DATA chunk too long'
            return 'ERROR'
         end
         datahex = datahex || chunk
      end
      if length(datahex) % 2 \= size then do
         say 'GIT: corrupt object' oid '- SIZE mismatch'
         return 'ERROR'
      end
   end
   if length(datahex) // 2 \= 0 |,
      verify(datahex,'0123456789ABCDEF') \= 0 then do
      say 'GIT: corrupt object' oid '- invalid DATA hex'
      return 'ERROR'
   end
   return 'OK'

toasciihex: procedure
   parse arg text
   e2ahex = '000102031A091A7F1A1A1A0B0C0D0E0F' ||,
            '101112131A1A081A18191A1A1C1D1E1F' ||,
            '1A1A1C1A1A0A171B1A1A1A1A1A050607' ||,
            '1A1A161A1A1E1A041A1A1A1A14151A1A' ||,
            '20A6E180EB909FE2AB8B9B2E3C282B7C' ||,
            '26A9AA9CDBA599E3A89E21242A293B5E' ||,
            '2D2FDFDC9ADDDE989DACBA2C255F3E3F' ||,
            'D78894B0B1B2FCD6FB603A2340273D22' ||,
            'F861626364656667686996A4F3AFAEC5' ||,
            '8C6A6B6C6D6E6F7071729787CE93F1FE' ||,
            'C87E737475767778797AEFC0DA5BF2F9' ||,
            'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4' ||,
            '7B414243444546474849CBCABEE8ECED' ||,
            '7D4A4B4C4D4E4F505152A1ADF5F4A38F' ||,
            '5CE7535455565758595AA0858EE9E4D1' ||,
            '30313233343536373839B3F7F0FAA7FF'
   e2a = x2c(e2ahex)
   bytes = x2c('000102030405060708090A0B0C0D0E0F' ||,
               '101112131415161718191A1B1C1D1E1F' ||,
               '202122232425262728292A2B2C2D2E2F' ||,
               '303132333435363738393A3B3C3D3E3F' ||,
               '404142434445464748494A4B4C4D4E4F' ||,
               '505152535455565758595A5B5C5D5E5F' ||,
               '606162636465666768696A6B6C6D6E6F' ||,
               '707172737475767778797A7B7C7D7E7F' ||,
               '808182838485868788898A8B8C8D8E8F' ||,
               '909192939495969798999A9B9C9D9E9F' ||,
               'A0A1A2A3A4A5A6A7A8A9AAABACADAEAF' ||,
               'B0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF' ||,
               'C0C1C2C3C4C5C6C7C8C9CACBCCCDCECF' ||,
               'D0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF' ||,
               'E0E1E2E3E4E5E6E7E8E9EAEBECEDEEEF' ||,
               'F0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF')
   return c2x(translate(text,e2a,bytes))

hashstored: procedure
   parse upper arg type, datahex
   bodylen = length(datahex) % 2
   dec = bodylen
   dechex = ''
   do i = 1 to length(dec)
      digit = substr(dec,i,1)
      dechex = dechex || d2x(digit+48,2)
   end
   if type = 'BLOB' then prefix = '626C6F6220'
   else if type = 'TREE' then prefix = '7472656520'
   else if type = 'COMMIT' then prefix = '636F6D6D697420'
   else return 'HASHERROR'
   streamhex = prefix || dechex || '00' || datahex
   total = length(streamhex) % 2
   header = right(d2x(total),8,'0')
   'MAKEBUF'
   if rc < 0 then return 'HASHERROR'
   queue header
   pos = 1
   do while pos <= length(streamhex)
      remain = length(streamhex) - pos + 1
      take = min(128,remain)
      queue substr(streamhex,pos,take)
      pos = pos + take
   end
   'GITSTRM'
   src = rc
   if src \= 0 then do
      'DROPBUF'
      return 'HASHERROR'
   end
   pull oid
   'DROPBUF'
   return oid

branchnamefromhead: procedure
   parse arg headline
   headref=strip(headline)
   if left(headref,11)\='refs/heads/' then return 'ERROR'
   branchname=substr(headref,12)
   call validbranch branchname
   if result\='OK' then return 'ERROR'
   return branchname

validremotename: procedure
   parse arg remote
   allowed='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   allowed=allowed||'0123456789._-'
   if remote='' | length(remote)>16 | remote='.' | remote='..' |,
      verify(remote,allowed)\=0 | pos('..',remote)>0 |,
      left(remote,1)='.' | right(remote,1)='.' then return 'ERROR'
   return 'OK'

/* Validate a bounded GitHub HTTPS repository URL and return owner/repo. */
parsecloneurl:
   parse arg cu
   upperurl=translate(cu)
   if left(upperurl,19)\='HTTPS://GITHUB.COM/' then return 'ERROR'
   p=substr(cu,20)
   if p='' | pos('?',p)>0 | pos('#',p)>0 | pos('@',p)>0 |,
      pos(':',p)>0 | pos('%',p)>0 | pos('\\',p)>0 then return 'ERROR'
   if right(translate(p),4)='.GIT' then p=left(p,length(p)-4)
   slash=pos('/',p)
   if slash<2 | slash=length(p) then return 'ERROR'
   if pos('/',substr(p,slash+1))>0 then return 'ERROR'
   owner=substr(p,1,slash-1)
   repo=substr(p,slash+1)
   if length(owner)>39 | length(repo)>39 then return 'ERROR'
   allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-'
   if verify(translate(owner),allowed)\=0 |,
      verify(translate(repo),allowed)\=0 then return 'ERROR'
   if pos('..',owner)>0 | pos('..',repo)>0 then return 'ERROR'
   if left(owner,1)='.' | left(repo,1)='.' |,
      right(owner,1)='.' | right(repo,1)='.' then return 'ERROR'
   return p

/* Default plain-HTTP to TLS bridge endpoint.  GITBRIDG CONFIG G may hold
   one record: BRIDGE <host> <port>.  The defaults match the documented
   VMnet gateway; override the file when the bridge listens elsewhere. */
readbridge:
   bridgehost='192.168.200.1'
   bridgeport='8443'
   'STATE GITBRIDG CONFIG G'
   if rc=28 then return 'OK'
   if rc\=0 then return 'ERROR'
   drop bridgeline.
   'EXECIO * DISKR GITBRIDG CONFIG G 1 (STEM BRIDGELINE. FINIS'
   if rc\=0 | bridgeline.0\=1 then return 'ERROR'
   parse var bridgeline.1 btag bhost bport bextra
   if translate(btag)\='BRIDGE' | bhost='' | bport='' |,
      bextra\='' then return 'ERROR'
   if datatype(bport,'W')\=1 | bport<1 | bport>65535 then return 'ERROR'
   bchars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   bchars=bchars||'0123456789.-'
   if length(bhost)>255 | verify(bhost,bchars)\=0 then return 'ERROR'
   bridgehost=bhost
   bridgeport=bport
   return 'OK'

/* Return the free 4K block count of one accessed R/W 4096-byte disk. */
freespace:
   fs.0=0
   'PIPE CMS QUERY DISK' objectfm '| STEM FS.'
   if rc\=0 then return 'ERROR'
   fscount=0
   fsfree=''
   do fsi=1 to fs.0
      if word(fs.fsi,3)=objectfm & word(fs.fsi,4)='R/W' &,
         word(fs.fsi,7)='4096' & words(fs.fsi)>=11 then do
         fscount=fscount+1
         fsfree=word(fs.fsi,10)
      end
   end
   if fscount\=1 | datatype(fsfree,'W')\=1 then return 'ERROR'
   return fsfree

initrefs:
   parse arg ibranch
   if ibranch='' then ibranch='main'
   'STATE GITREF2 REPO G'
   if rc=0 then return 'EXISTS'
   if rc\=28 then return 'ERROR'
   initial.0=2
   initial.1='REF2 1'
   initial.2='HEAD refs/heads/'||ibranch
   'EXECIO 2 DISKW GITREF2 REPO G 1 (STEM INITIAL. FINIS'
   if rc\=0 then return 'ERROR'
   drop initial.
   'EXECIO * DISKR GITREF2 REPO G 1 (STEM INITIAL. FINIS'
   if rc\=0 | initial.0\=2 | initial.1\='REF2 1' |,
      initial.2\=('HEAD refs/heads/'||ibranch) then return 'ERROR'
   return 'OK'

validtag: procedure
   parse arg vt, mode
   tagchars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   tagchars=tagchars||'0123456789._/-'
   if mode='PATTERN' then tagchars=tagchars||'*?'
   if vt='' | length(vt)>25 | verify(vt,tagchars)\=0 |,
      pos('//',vt)>0 | pos('..',vt)>0 |,
      left(vt,1)='/' | right(vt,1)='/' |,
      right(vt,1)='.' | right(vt,5)='.lock' then return 'ERROR'
   do vi=1 to words(translate(vt,' ','/'))
      part=word(translate(vt,' ','/'),vi)
      if part='' | part='.' | part='..' | left(part,1)='.' |,
         right(part,1)='.' | right(part,5)='.lock' then return 'ERROR'
   end
   return 'OK'

validbranch: procedure
   parse arg vb, mode
   refchars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   refchars=refchars||'0123456789._/-'
   if mode='PATTERN' then refchars=refchars||'*?'
   if vb='' | length(vb)>24 | verify(vb,refchars)\=0 |,
      pos('//',vb)>0 | pos('..',vb)>0 |,
      left(vb,1)='/' | right(vb,1)='/' then return 'ERROR'
   do vi=1 to words(translate(vb,' ','/'))
      part=word(translate(vb,' ','/'),vi)
      if part='' | part='.' | part='..' | left(part,1)='.' |,
         right(part,1)='.' | right(part,5)='.lock' then return 'ERROR'
   end
   return 'OK'

resolvetagtarget: procedure expose rs.
   parse arg wanted
   if wanted='HEAD' then do
      call queryref 'HEAD'
      if result\='OK' then return 'ERROR'
      call pickresolved 'HEAD'
      if result='ERROR' then return 'ERROR'
      resolvedoid=result
   end
   else do
      call resolvestart wanted
      if result='ERROR' | result='HEAD' then return 'ERROR'
      resolvedoid=translate(result)
   end
   if length(resolvedoid)\=40 |,
      verify(resolvedoid,'0123456789ABCDEF')\=0 then return 'ERROR'
   return resolvedoid

resolvestart: procedure expose rs.
   parse arg wanted
   if wanted='HEAD' then return 'HEAD'
   direct=translate(wanted)
   if length(direct)=40 &,
      verify(direct,'0123456789ABCDEF')=0 then return direct
   startchars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
   startchars=startchars||'0123456789._/-'
   if wanted='' | length(wanted)>35 |,
      verify(wanted,startchars)\=0 then return 'ERROR'
   call queryref wanted
   if result\='OK' then return 'ERROR'
   call pickresolved wanted
   if result='ERROR' then return 'ERROR'
   resolvedoid=result
   if length(resolvedoid)\=40 |,
      verify(resolvedoid,'0123456789ABCDEF')\=0 then return 'ERROR'
   return resolvedoid

pickresolved:
   /* GITVREF RESOLVE prints a verified-ref record and then the object id
      on its own line.  Accept either framing but never guess between
      conflicting records. */
   parse arg pqspec
   pfound=0
   pbare=0
   pbareconflict=0
   pbareoid=''
   poid=''
   do pri=1 to rs.0
      pline=strip(rs.pri)
      if words(pline)=4 & word(pline,1)='VERIFIED' &,
         word(pline,2)='REF' & word(pline,3)=pqspec then do
         pfound=pfound+1
         poid=translate(word(pline,4))
      end
      else do
         pcand=translate(pline)
         if length(pcand)=40 &,
            verify(pcand,'0123456789ABCDEF')=0 then do
            if pbare>0 & pbareoid\=pcand then pbareconflict=1
            pbare=pbare+1
            pbareoid=pcand
         end
      end
   end
   if pbareconflict=1 then return 'ERROR'
   if pfound=1 then do
      if pbare>0 & pbareoid\=poid then return 'ERROR'
      return poid
   end
   if pfound=0 & pbare=1 then return pbareoid
   return 'ERROR'

queryref: procedure expose rs.
   parse arg qspec
   drop rs.
   rs.0=0
   cmd='EXEC GITVREF RESOLVE' qspec
   'PIPE CMS' cmd '| STEM RS.'
   if rc\=0 then return 'ERROR'
   return 'OK'

localbranchtip:
   /* Cheap REF2-only lookup of one local branch tip.  Unlike GITVREF RESOLVE
      this does not touch the native object store, so it works in a shallow
      loose-object repository. */
   parse arg lbtbranch
   lbtref='refs/heads/'||lbtbranch
   lbtip=''
   drop lbt.
   lbt.0=0
   'EXECIO * DISKR GITREF2 REPO G 1 (STEM LBT. FINIS'
   if rc\=0 | lbt.0<2 | lbt.1\='REF2 1' then return ''
   do lbti=2 to lbt.0
      if words(lbt.lbti)=3 & word(lbt.lbti,1)='REF' &,
         word(lbt.lbti,2)=lbtref then,
         lbtip=translate(word(lbt.lbti,3))
   end
    if length(lbtip)\=40 |,
       verify(lbtip,'0123456789ABCDEF')\=0 then lbtip=''
    return lbtip

head_validbranch: procedure
   parse arg name
   if name = '' | name = '.' | name = '..' | pos('/',name) > 0 |,
      pos(' ',name) > 0 | pos('..',name) > 0 | pos('~',name) > 0 |,
      pos('^',name) > 0 | pos(':',name) > 0 | pos('?',name) > 0 |,
      pos('*',name) > 0 | pos('[',name) > 0 | right(name,1) = '.' then do
      say 'GITHEAD: invalid branch name' name
      return 'ERROR'
   end
   return 'OK'

head_readrefs: procedure expose rr.
   'STATE GITREFS REPO G'
   if rc \= 0 then do
      say 'GITHEAD: refs database not found'
      return 'ERROR'
   end
   drop rr.
   'EXECIO * DISKR GITREFS REPO G 1 (STEM RR. FINIS'
   if rc \= 0 then return 'ERROR'
   do i = 1 to rr.0
      if words(rr.i) \= 3 then do
         say 'GITHEAD: corrupt refs record' i
         return 'ERROR'
      end
      tag = word(rr.i,1)
      rname = word(rr.i,2)
      oid = word(rr.i,3)
      if tag \= 'BRANCH' | rname = '' |,
         length(oid) \= 40 | verify(oid,'0123456789ABCDEF') \= 0 then do
         say 'GITHEAD: corrupt refs record' i
         return 'ERROR'
      end
   end
   return 'OK'

head_readhead: procedure expose headref
   drop hm.
   'EXECIO * DISKR GITMETA REPO G 1 (STEM HM. FINIS'
   if rc \= 0 then do
      say 'GITHEAD: repository metadata not found'
      return 'ERROR'
   end
   headref = ''
   found = 0
   do i = 1 to hm.0
      if word(hm.i,1) = 'HEAD' then do
         found = found + 1
         headref = word(hm.i,2)
      end
   end
   if found \= 1 | left(headref,11) \= 'refs/heads/' then do
      say 'GITHEAD: invalid symbolic HEAD'
      return 'ERROR'
   end
   return 'OK'

head_resolve: procedure expose headref headoid rr.
   call head_readrefs
   if result \= 'OK' then return 'ERROR'
   name = substr(headref,12)
   found = 0
   headoid = ''
   do i = 1 to rr.0
      if word(rr.i,2) = name then do
         found = found + 1
         headoid = word(rr.i,3)
      end
   end
   if found \= 1 then do
      say 'GITHEAD: symbolic HEAD does not resolve' headref
      return 'ERROR'
   end
   return 'OK'

head_writehead: procedure
   parse arg newref
   drop hm.
   'EXECIO * DISKR GITMETA REPO G 1 (STEM HM. FINIS'
   if rc \= 0 then do
      say 'GITHEAD: repository metadata not found'
      return 'ERROR'
   end
   found = 0
   do i = 1 to hm.0
      if word(hm.i,1) = 'HEAD' then do
         found = found + 1
         slot = i
      end
   end
   if found \= 1 then do
      say 'GITHEAD: invalid symbolic HEAD metadata'
      return 'ERROR'
   end
   hm.slot = 'HEAD' newref
   'EXECIO' hm.0 'DISKW GITMETA REPO G 1 (STEM HM. FINIS'
   if rc \= 0 then do
      say 'GITHEAD: cannot write repository metadata'
      return 'ERROR'
   end
   return 'OK'

legacybranch:
   parse arg lb_args
   lb_words = words(lb_args)
   if lb_words = 0 then do
      call head_readhead
      if result \= 'OK' then return 8
      call legacy_readrefs
      if result \= 'OK' then return 8
      do lb_i = 1 to lb_refcount
         lb_mark = ' '
         if headref = 'refs/heads/' || lb_refname.lb_i then,
            lb_mark = '*'
         say lb_mark lb_refname.lb_i lb_refoid.lb_i
      end
      return 0
   end
   if lb_words \= 2 then do
      say 'Usage: GITREF BRANCH [name commit-object-id]'
      return 4
   end
   lb_name = word(lb_args,1)
   lb_oid = translate(word(lb_args,2))
   call legacy_validbranch lb_name
   if result \= 'OK' then return 4
   if length(lb_oid) \= 40 |,
      verify(lb_oid,'0123456789ABCDEF') \= 0 then do
      say 'GITREF: invalid branch object-id' word(lb_args,2)
      return 4
   end
   call legacy_requirecommit lb_oid
   if result \= 'OK' then return 8
   call legacy_readrefs
   if result \= 'OK' then return 8
   do lb_i = 1 to lb_refcount
      if lb_refname.lb_i = lb_name then do
         say 'GITREF: branch already exists' lb_name
         return 8
      end
   end
   lb_refcount = lb_refcount + 1
   lb_n = lb_refcount
   lb_refname.lb_n = lb_name
   lb_refoid.lb_n = lb_oid
   call legacy_writerefs
   if result \= 'OK' then return 8
   say 'refs/heads/' || lb_name lb_oid
   return 0

legacy_validbranch: procedure
   parse arg name
   if name = '' | name = '.' | name = '..' | pos('/',name) > 0 |,
      pos(' ',name) > 0 | pos('..',name) > 0 | pos('~',name) > 0 |,
      pos('^',name) > 0 | pos(':',name) > 0 | pos('?',name) > 0 |,
      pos('*',name) > 0 | pos('[',name) > 0 | right(name,1) = '.' then do
      say 'GITREF: invalid branch name' name
      return 'ERROR'
   end
   return 'OK'

legacy_requirecommit: procedure expose objectfm
   parse upper arg oid
   fn = substr(oid,1,8)
   drop obj.
   'EXECIO * DISKR' fn 'GITOBJ' objectfm '1 (STEM OBJ. FINIS'
   if rc \= 0 then do
      say 'GITREF: object not found' oid
      return 'ERROR'
   end
   if obj.0 < 2 | word(obj.1,1) \= 'OID' | word(obj.1,2) \= oid |,
      word(obj.2,1) \= 'TYPE' then do
      say 'GITREF: invalid object record' oid
      return 'ERROR'
   end
   if word(obj.2,2) \= 'COMMIT' then do
      say 'GITREF: branch target is not a COMMIT object' oid
      return 'ERROR'
   end
   return 'OK'

legacy_readrefs: procedure expose lb_refcount lb_refname. lb_refoid.
   drop lb_refname. lb_refoid.
   lb_refcount = 0
   'STATE GITREFS REPO G'
   if rc \= 0 then return 'OK'
   drop lb_rr.
   'EXECIO * DISKR GITREFS REPO G 1 (STEM LB_RR. FINIS'
   if rc \= 0 then return 'ERROR'
   do lb_i = 1 to lb_rr.0
      if words(lb_rr.lb_i) \= 3 then do
         say 'GITREF: corrupt refs record' lb_i
         return 'ERROR'
      end
      lb_tag = word(lb_rr.lb_i,1)
      lb_name = word(lb_rr.lb_i,2)
      lb_oid = word(lb_rr.lb_i,3)
      if lb_tag \= 'BRANCH' | lb_name = '' |,
         length(lb_oid) \= 40 |,
         verify(lb_oid,'0123456789ABCDEF') \= 0 then do
         say 'GITREF: corrupt refs record' lb_i
         return 'ERROR'
      end
      lb_refcount = lb_refcount + 1
      lb_n = lb_refcount
      lb_refname.lb_n = lb_name
      lb_refoid.lb_n = lb_oid
   end
   return 'OK'

legacy_writerefs: procedure expose lb_refcount lb_refname. lb_refoid.
   drop lb_wr.
   lb_wr.0 = lb_refcount
   do lb_i = 1 to lb_refcount
      lb_wr.lb_i = 'BRANCH' lb_refname.lb_i lb_refoid.lb_i
   end
   'EXECIO' lb_wr.0 'DISKW GITREFS REPO G 1 (STEM LB_WR. FINIS'
   if rc \= 0 then return 'ERROR'
   return 'OK'

/* M293: inlined GITCRED credential handler. */
gitcredential:
   address cms
   gc_tokenalphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
   gc_tokenalphabet=gc_tokenalphabet||'0123456789_-'
   parse arg gc_args
   parse var gc_args gc_action gc_rest
   gc_action=translate(strip(gc_action))

if gc_action='STATUS' then do
 if strip(gc_rest)\='' then exit 4
 call gc_readcredential
 if result\='OK' then exit 8
 if gc_present=0 then do
  say 'No GitHub credential stored'
  exit 0
 end
 if gc_storedmode='APIKEY' then gc_modeout='API key'
 else gc_modeout='username/password credential'
 say 'GitHub' gc_modeout 'stored for' gc_storeduser
 exit 0
end

if gc_action='REMOVE' then do
 if strip(gc_rest)\='' then do
  say 'Usage: GIT CREDENTIAL REMOVE'
  exit 4
 end
 'STATE GHCRED REPO G'
 if rc=28 then do
  say 'No GitHub credential stored'
  exit 0
 end
 if rc\=0 then exit 8
 'ERASE GHCRED REPO G'
 if rc\=0 then do
  say 'GITCRED: cannot remove credential file'
  exit 8
 end
 say 'Removed stored GitHub credential'
 exit 0
end

if gc_action='IMPORT' then do
 parse var gc_rest gc_username gc_extra
 if gc_username='' | gc_extra\='' then do
  say 'Usage: GIT CREDENTIAL IMPORT github-user'
  exit 4
 end
 call gc_validuser gc_username
 if result\='OK' then do
  say 'GITCRED: invalid GitHub user name'
  exit 4
 end
 'STATE GHTOKEN REPO G'
 if rc\=0 then do
  say 'GITCRED: create GHTOKEN REPO G with one TOKEN record first'
  exit 8
 end
 drop gc_input.
 'EXECIO * DISKR GHTOKEN REPO G 1 (STEM GC_INPUT. FINIS'
 if rc\=0 | gc_input.0\=1 then do
  say 'GITCRED: token input must contain exactly one record'
  exit 8
 end
 parse var gc_input.1 gc_label gc_secret
 gc_secret=strip(gc_secret)
 if (translate(gc_label)\='TOKEN' & translate(gc_label)\='APIKEY') |,
    gc_secret='' then do
  say 'GITCRED: input record must begin TOKEN or APIKEY'
  exit 8
 end
 call gc_validsecret gc_secret
 if result\='OK' then do
  say 'GITCRED: API key has invalid characters or length'
  exit 8
 end
 gc_credentialmode='APIKEY'
 call gc_storecredential
 if result\='OK' then do
  say 'GITCRED: could not store API key'
  exit 8
 end
 'ERASE GHTOKEN REPO G'
 if rc\=0 then do
  say 'GITCRED: stored credential; temporary input remains'
  exit 8
 end
 say 'Stored GitHub API key for' gc_username
 exit 0
end

if gc_action='IMPORT-USERPASS' then do
 if strip(gc_rest)\='' then do
  say 'Usage: GIT CREDENTIAL IMPORT-USERPASS'
  exit 4
 end
 'STATE GHPASS REPO G'
 if rc\=0 then do
  say 'GITCRED: create GHPASS REPO G with USER and PASSWORD records'
  exit 8
 end
 drop gc_input.
 'EXECIO * DISKR GHPASS REPO G 1 (STEM GC_INPUT. FINIS'
 if rc\=0 | gc_input.0\=2 then do
  say 'GITCRED: input must contain exactly two records'
  exit 8
 end
 parse var gc_input.1 gc_userlabel gc_username
 parse var gc_input.2 gc_passlabel gc_secret
 gc_username=strip(gc_username)
 gc_secret=strip(gc_secret)
 if words(gc_input.1)\=2 | translate(gc_userlabel)\='USER' |,
    words(gc_input.2)\=2 | translate(gc_passlabel)\='PASSWORD' then do
  say 'GITCRED: expected USER name and PASSWORD token records'
  exit 8
 end
 call gc_validuser gc_username
 if result\='OK' then do
  say 'GITCRED: invalid GitHub user name'
  exit 4
 end
 call gc_validsecret gc_secret
 if result\='OK' then do
  say 'GITCRED: password field must contain a GitHub token'
  exit 8
 end
 gc_credentialmode='USERPASS'
 call gc_storecredential
 if result\='OK' then do
  say 'GITCRED: could not store username/password credential'
  exit 8
 end
 'ERASE GHPASS REPO G'
 if rc\=0 then do
  say 'GITCRED: stored credential; temporary input remains'
  exit 8
 end
 say 'Stored GitHub username/password credential for' gc_username
 exit 0
end

say 'Usage: GIT CREDENTIAL STATUS | IMPORT user | IMPORT-USERPASS'
say '       GIT CREDENTIAL REMOVE'
exit 4

gc_storecredential:
 'STATE GHCRED REPO G'
 if rc=0 then do
  say 'GITCRED: remove the existing credential before replacing it'
  return 'ERROR'
 end
 if rc\=28 then return 'ERROR'
 drop gc_output.
 gc_output.1='GHCRED 2'
 gc_output.2='MODE' gc_credentialmode
 gc_output.3='USER' gc_username
 gc_output.4='SECRET-LENGTH' length(gc_secret)
 gc_n=4
 gc_pos=1
 gc_part=0
 do while gc_pos<=length(gc_secret)
  gc_part=gc_part+1
  gc_n=gc_n+1
  if gc_part=1 then gc_label='SECRET'
  else gc_label='SECRET+' gc_part
  gc_output.gc_n=gc_label substr(gc_secret,gc_pos,64)
  gc_pos=gc_pos+64
 end
 gc_output.0=gc_n
 'EXECIO' gc_output.0 'DISKW GHCRED REPO G 1 (STEM GC_OUTPUT. FINIS'
 if rc\=0 then do
  'STATE GHCRED REPO G'
  if rc=0 then 'ERASE GHCRED REPO G'
  return 'ERROR'
 end
 call gc_readcredential
 if result\='OK' | gc_present\=1 | gc_username\=gc_storeduser |,
    gc_credentialmode\=gc_storedmode | gc_secret\=gc_storedsecret then do
  'ERASE GHCRED REPO G'
  return 'ERROR'
 end
 return 'OK'

gc_readcredential:
 gc_present=0
 gc_storeduser=''
 gc_storedsecret=''
 gc_storedmode=''
 'STATE GHCRED REPO G'
 if rc=28 then return 'OK'
 if rc\=0 then return 'ERROR'
 drop gc_cred.
 'EXECIO * DISKR GHCRED REPO G 1 (STEM GC_CRED. FINIS'
 if rc\=0 | gc_cred.0<4 then return 'ERROR'
 if gc_cred.1='GHCRED 1' then do
  gc_storedmode='APIKEY'
  gc_userrec=2
  gc_lenrec=3
  gc_firstsecret=4
  gc_lenlabel='TOKEN-LENGTH'
  gc_chunkprefix='TOKEN'
 end
 else if gc_cred.1='GHCRED 2' then do
  if words(gc_cred.2)\=2 | word(gc_cred.2,1)\='MODE' then,
   return 'ERROR'
  gc_storedmode=word(gc_cred.2,2)
  if gc_storedmode\='APIKEY' & gc_storedmode\='USERPASS' then,
   return 'ERROR'
  gc_userrec=3
  gc_lenrec=4
  gc_firstsecret=5
  gc_lenlabel='SECRET-LENGTH'
  gc_chunkprefix='SECRET'
 end
 else return 'ERROR'
 if words(gc_cred.gc_userrec)\=2 | word(gc_cred.gc_userrec,1)\='USER' then,
  return 'ERROR'
 gc_storeduser=strip(word(gc_cred.gc_userrec,2))
 call gc_validuser gc_storeduser
 if result\='OK' then return 'ERROR'
 if words(gc_cred.gc_lenrec)\=2 |,
    word(gc_cred.gc_lenrec,1)\=gc_lenlabel then return 'ERROR'
 gc_secretlength=word(gc_cred.gc_lenrec,2)
 if datatype(gc_secretlength,'W')\=1 | gc_secretlength<1 |,
    gc_secretlength>240 then return 'ERROR'
 gc_chunks=(gc_secretlength+63)%64
 if gc_cred.0\=gc_firstsecret+gc_chunks-1 then return 'ERROR'
 do gc_ci=1 to gc_chunks
  gc_rec=gc_firstsecret+gc_ci-1
  parse var gc_cred.gc_rec gc_clabel gc_cvalue
  gc_cvalue=strip(gc_cvalue)
  if gc_ci=1 then gc_expected=gc_chunkprefix
  else gc_expected=gc_chunkprefix||'+'||(gc_ci-1)
  gc_wantlen=gc_secretlength-((gc_ci-1)*64)
  if gc_wantlen>64 then gc_wantlen=64
  if words(gc_cred.gc_rec)\=2 | gc_clabel\=gc_expected |,
     length(gc_cvalue)\=gc_wantlen then return 'ERROR'
  call gc_validsecret gc_cvalue
  if result\='OK' then return 'ERROR'
  gc_storedsecret=gc_storedsecret||gc_cvalue
 end
 if length(gc_storedsecret)\=gc_secretlength then return 'ERROR'
 gc_present=1
 return 'OK'

gc_validsecret:
 parse arg gc_value
 if gc_value='' | length(gc_value)>240 then return 'ERROR'
 if verify(gc_value,gc_tokenalphabet)\=0 then return 'ERROR'
 return 'OK'

gc_validuser:
 parse arg gc_user
 if gc_user='' | length(gc_user)>39 then return 'ERROR'
 gc_allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-'
 if verify(translate(gc_user),gc_allowed)\=0 then return 'ERROR'
 return 'OK'

/* M294: inlined GITIMP object installer. */
gitimport:
 address cms
 parse arg gi_args
 parse upper var gi_args gi_oid gi_extra
gi_objfn=substr(gi_oid,1,8)

/* Loose objects live on the repository object disk, which need not be A. */
objectfm='G'
'STATE GITMETA REPO G'
if rc=0 then do
 drop gi_impmeta.
 'EXECIO * DISKR GITMETA REPO G 1 (STEM GI_IMPMETA. FINIS'
 if rc\=0 | gi_impmeta.0<1 | gi_impmeta.1\='CMS-GIT-REPOSITORY 1' then do
  say 'GITIMP: invalid repository metadata'
  exit 8
 end
 do gi_mi=1 to gi_impmeta.0
  if word(gi_impmeta.gi_mi,1)='OBJECT-DISK' then do
   if words(gi_impmeta.gi_mi)\=2 then do
    say 'GITIMP: invalid OBJECT-DISK setting'
    exit 8
   end
   objectfm=translate(word(gi_impmeta.gi_mi,2))
  end
 end
 if length(objectfm)\=1 |,
    verify(objectfm,'ABCDEFGHIJKLMNOPQRSTUVWXYZ')\=0 then do
  say 'GITIMP: invalid OBJECT-DISK setting'
  exit 8
 end
 if objectfm\='G' then do
  say 'GITIMP: repository OBJECT-DISK must be G'
  exit 8
 end
end
else if rc\=28 then do
 say 'GITIMP: cannot inspect repository metadata RC' rc
 exit 8
end

'STATE' gi_objfn 'GITOBJ' objectfm
gi_src=rc
if gi_src=0 then do
 address command 'EXEC GIT VERIFY-OBJECT' gi_oid
 if rc\=0 then do
  say 'GITIMP: existing loose object failed verification'
  exit 8
 end
 say 'IMPORT OBJECT ALREADY PRESENT' gi_oid
 exit 0
end
if gi_src\=28 then do
 say 'GITIMP: cannot inspect loose object target RC' gi_src
 exit 8
end

call gi_bindnative
if result\='OK' then exit 8
drop gi_out.
gi_out.0=0
gi_cmd='GITREC CATHEX GITFIX M15NEW' gi_oid
'PIPE CMS' gi_cmd '| STEM GI_OUT.'
gi_grc=rc
if gi_grc\=0 then do
 say 'GITIMP: verified native object read failed RC' gi_grc
 exit gi_grc
end

gi_meta=0
gi_begins=0
gi_ends=0
gi_indata=0
gi_body=''
do gi_i=1 to gi_out.0
 gi_line=gi_out.gi_i
 if word(gi_line,1)='SEEK' & word(gi_line,2)='OBJECT' &,
    word(gi_line,3)='OID' then do
  if gi_meta then do
   say 'GITIMP: duplicate CATHEX metadata'
   exit 8
  end
  if words(gi_line)<8 | word(gi_line,4)\=gi_oid |,
     word(gi_line,5)\='OBJ' | word(gi_line,7)\='TYPE' then do
   say 'GITIMP: malformed CATHEX metadata'
   exit 8
  end
  gi_mobj=word(gi_line,6)
  gi_typ=word(gi_line,8)
  if datatype(gi_mobj,'W')\=1 | gi_mobj<1 | gi_mobj>1808 then do
   say 'GITIMP: invalid CATHEX object number'
   exit 8
  end
  if datatype(gi_typ,'W')\=1 | gi_typ<1 | gi_typ>4 then do
   say 'GITIMP: invalid CATHEX object type'
   exit 8
  end
  gi_meta=1
 end
 else if gi_line='OBJECT DATA BEGIN' then do
  if gi_begins | gi_indata then do
   say 'GITIMP: invalid CATHEX data begin'
   exit 8
  end
  gi_begins=1
  gi_indata=1
 end
 else if gi_line='OBJECT DATA END' then do
  if \gi_indata | gi_ends then do
   say 'GITIMP: invalid CATHEX data end'
   exit 8
  end
  gi_ends=1
  gi_indata=0
 end
 else if gi_indata then do
  if word(gi_line,1)\='HEX' | words(gi_line)\=2 then do
   say 'GITIMP: malformed CATHEX data record'
   exit 8
  end
  gi_h=translate(word(gi_line,2))
  if gi_h='' | length(gi_h)>64 | length(gi_h)//2\=0 |,
     verify(gi_h,'0123456789ABCDEF')\=0 then do
   say 'GITIMP: invalid CATHEX data hex'
   exit 8
  end
  gi_body=gi_body||gi_h
 end
end
if gi_meta\=1 | gi_begins\=1 | gi_ends\=1 | gi_indata then do
 say 'GITIMP: incomplete CATHEX framing'
 exit 8
end
gi_size=length(gi_body)%2
if gi_size>65536 then do
 say 'GITIMP: CATHEX body too large'
 exit 8
end
if gi_typ<1 | gi_typ>3 then do
 say 'GITIMP: loose TAG objects are not supported yet'
 exit 8
end
gi_type=word('COMMIT TREE BLOB',gi_typ)

drop gi_loose.
gi_loose.1='OID' gi_oid
gi_loose.2='TYPE' gi_type
gi_loose.3='SIZE' gi_size
gi_n=3
gi_p=1
do while gi_p<=length(gi_body)
 gi_take=min(128,length(gi_body)-gi_p+1)
 gi_n=gi_n+1
 gi_loose.gi_n='DATA' substr(gi_body,gi_p,gi_take)
 gi_p=gi_p+gi_take
end
gi_loose.0=gi_n
'EXECIO' gi_loose.0 'DISKW' gi_objfn 'GITOBJ' objectfm ,
 '1 (STEM GI_LOOSE. FINIS'
if rc\=0 then do
 say 'GITIMP: cannot create loose object'
 exit 8
end

address command 'EXEC GIT VERIFY-OBJECT' gi_oid
vrc=rc
if vrc\=0 then do
 'ERASE' gi_objfn 'GITOBJ' objectfm
 say 'GITIMP: loose object verification failed'
 exit 8
end
say 'IMPORTED' gi_type gi_size gi_oid
exit 0

gi_bindnative:
 'FILEDEF SEL0 DISK M15SL0 PTR G'
 if rc\=0 then return 'ERROR'
 'FILEDEF SEL1 DISK M15SL1 PTR G'
 if rc\=0 then return 'ERROR'
 do gi_j=1 to 4
  gi_t=word('STAGE INDEX SEEK GEN',gi_j)
  gi_d=word('C0STG C0IDX C0SEEK C0GEN',gi_j)
  'FILEDEF' gi_d 'DISK GITFIX' gi_t 'G'
  if rc\=0 then return 'ERROR'
  gi_d=word('C1STG C1IDX C1SEEK C1GEN',gi_j)
  'FILEDEF' gi_d 'DISK M15NEW' gi_t 'G'
  if rc\=0 then return 'ERROR'
 end
 return 'OK'

/* Native Git for CMS/z/VM */

/* Preserve arguments exactly; normalize only the command verb. */
parse arg command rest
command = translate(command)
objectfm = 'G'
if command \= 'INIT' then do
   'STATE GITMETA REPO G'
   if rc = 0 then do
      drop config.
      'EXECIO * DISKR GITMETA REPO G 1 (STEM CONFIG. FINIS'
      if rc \= 0 | config.0 < 4 |,
         config.1 \= 'CMS-GIT-REPOSITORY 1' then do
         say 'GIT: invalid repository metadata'
         exit 8
      end
      objectrecords = 0
      do ci = 1 to config.0
         if word(config.ci,1) = 'OBJECT-DISK' then do
            if words(config.ci) \= 2 then do
               say 'GIT: invalid OBJECT-DISK setting'
               exit 8
            end
            objectrecords = objectrecords + 1
            objectfm = translate(word(config.ci,2))
         end
      end
      if objectrecords > 1 | length(objectfm) \= 1 |,
         verify(objectfm,'ABCDEFGHIJKLMNOPQRSTUVWXYZ') \= 0 then do
         say 'GIT: invalid OBJECT-DISK setting'
         exit 8
      end
      if objectfm \= 'G' then do
         say 'GIT: repository OBJECT-DISK must be G'
         exit 8
      end
   end
   else if rc \= 28 then do
      say 'GIT: cannot inspect repository metadata RC' rc
      exit 8
   end
end

if command = '' then do
   say 'Usage: GIT command [arguments]'
   exit 4
end
if command='CHECKOUT' then do
   parse var rest checkoutarg checkoutrest
   if checkoutarg='-B' then do
      say 'GIT CHECKOUT -B is not supported'
      exit 4
   end
   'STATE GITREF2 REPO G'
   checkoutrc=rc
   if checkoutrc=28 then do
      if checkoutarg='-b' | checkoutarg='--branch' then do
         say 'GIT CHECKOUT -b requires modern REF2'
         exit 8
      end
   end
   else if checkoutrc=0 then do
      if checkoutarg='-b' | checkoutarg='--branch' then,
         rest='-c'||substr(rest,length(checkoutarg)+1)
      command='SWITCH'
   end
   else do
      say 'GIT CHECKOUT: cannot inspect REF2 RC' checkoutrc
      exit checkoutrc
   end
end
if command = 'VERSION' then do
   'GITCORE VERSION'
   exit rc
end
if command = 'STAMP' then do
   parse var rest extra
   if extra \= '' then exit 4
   say 'GIT EXEC STAMP C4'
   exit 0
end
if command = 'CASE' then do
   address command 'EXEC GITVREF CASE' rest
   exit rc
end
if command = 'LEVEL' then do
   parse var rest extra
   if extra \= '' then do
      say 'Usage: GIT LEVEL'
      exit 4
   end
   lvl.0 = 0
   'PIPE CMS EXEC GITVREF LEVEL | STEM lvl.'
   if rc \= 0 then exit rc
   say 'GIT EXEC LEVEL M176'
   if lvl.0 \= 1 | lvl.1 \= 'GITVREF EXEC LEVEL M176' then do
      say 'GITVREF EXEC LEVEL MISMATCH'
      exit 8
   end
   say lvl.1
   exit 0
end
if command = 'INIT' then do
   parse var rest objectfm initbranch extra
   objectfm=translate(objectfm)
   if extra \= '' | (objectfm \= '' &,
      verify(objectfm,'ABCDEFGHIJKLMNOPQRSTUVWXYZ') \= 0) then do
      say 'Usage: GIT INIT [object-filemode [branch]]'
      exit 4
   end
   if objectfm = '' then objectfm = 'G'
   if objectfm \= 'G' then do
      say 'GIT: this installation stores project data on filemode G'
      exit 4
   end
   if initbranch='' then initbranch='main'
   call validbranch initbranch
   if result\='OK' then do
      say 'GIT: invalid initial branch name'
      exit 4
   end
   'STATE GITMETA REPO G'
   if rc = 0 then do
      call initrefs initbranch
      if result='OK' then do
         say 'Initialized unborn branch refs/heads/'||initbranch
         exit 0
      end
      if result='EXISTS' then do
         say 'GIT: repository already initialized'
         exit 8
      end
      say 'GIT: could not initialize branch refs'
      exit 8
   end
   if rc \= 28 then do
      say 'GIT: cannot inspect repository metadata RC' rc
      exit 8
   end
   if objectfm \= 'A' then do
      drop diskinfo.
      diskinfo.0 = 0
      'PIPE CMS QUERY DISK' objectfm '| STEM DISKINFO.'
      if rc \= 0 then do
         say 'GIT: cannot inspect object data disk' objectfm
         exit 8
      end
      diskcount = 0
      freeblocks = ''
      do di = 1 to diskinfo.0
         if word(diskinfo.di,3) = objectfm &,
            word(diskinfo.di,4) = 'R/W' &,
            word(diskinfo.di,7) = '4096' &,
            words(diskinfo.di) >= 11 then do
            diskcount = diskcount + 1
            freeblocks = word(diskinfo.di,10)
         end
      end
      if diskcount \= 1 | datatype(freeblocks,'W') \= 1 |,
         freeblocks < 180000 then do
         say 'GIT: object disk needs R/W 4K and 180000 free blocks'
         exit 8
      end
   end
   meta.0 = 5
   meta.1 = 'CMS-GIT-REPOSITORY 1'
   meta.2 = 'OBJECT-FORMAT SHA1'
   meta.3 = 'TEXT-RECORD-SEPARATOR LF'
   meta.4 = 'HEAD refs/heads/'||initbranch
   meta.5 = 'OBJECT-DISK' objectfm
   'EXECIO' meta.0 'DISKW GITMETA REPO G 1 (STEM META. FINIS'
   if rc \= 0 then exit rc
   call initrefs initbranch
   if result\='OK' then do
      'ERASE GITMETA REPO G'
      say 'GIT: could not initialize branch refs'
      exit 8
   end
   say 'Initialized native CMS Git repository; objects on filemode' objectfm
   exit 0
end

/* M262: repository-local HTTPS remote metadata for GitHub workflows. */
if command = 'REMOTE' then do
   address command 'EXEC GITREMOT' rest
   exit rc
end
if command = 'CREDENTIAL' then do
   call gitcredential rest
   exit result
end

/* Modern lightweight tag porcelain over the guarded REF2 updater. */
if command = 'TAG' then do
   if strip(rest)='' then do
      address command 'EXEC GITVREF TAGS'
      exit rc
   end
   parse var rest action tagname oid extra fifth
   verb=translate(action)
   if verb='-L' | verb='--LIST' then do
      if oid\='' | extra\='' | fifth\='' then do
         say 'Usage: GIT TAG [-l|--list [pattern]]'
         exit 4
      end
      if tagname\='' then do
         call validtag tagname, 'PATTERN'
         if result\='OK' then do
            say 'GIT: invalid tag pattern'
            exit 4
         end
      end
      address command 'EXEC GITVREF TAGS' tagname
      exit rc
   end
   if verb='-F' | verb='--FORCE' then do
      if tagname='' | oid='' | fifth\='' then do
         say 'Usage: GIT TAG -f|--force name new-oid [expected-old-oid]'
         exit 4
      end
      call validtag tagname
      if result\='OK' then do
         say 'GIT: invalid tag name'
         exit 4
      end
      newoid=translate(oid)
      if length(newoid)\=40 |,
         verify(newoid,'0123456789ABCDEF')\=0 then do
         say 'GIT: invalid new tag object-id'
         exit 4
      end
      zeros='0000000000000000000000000000000000000000'
      ref='refs/tags/'||tagname
      if extra='' then do
         call resolvestart ref
         oldoid=result
         if oldoid='ERROR' | oldoid='HEAD' then do
            say 'GIT: cannot resolve existing tag' ref
            exit 8
         end
      end
      else oldoid=translate(extra)
      if length(oldoid)\=40 |,
         verify(oldoid,'0123456789ABCDEF')\=0 then do
         say 'GIT: invalid expected tag object-id'
         exit 4
      end
      if oldoid=zeros then do
         say 'GIT: force update requires an existing tag OID'
         exit 4
      end
      address command 'EXEC GIT VERIFY-OBJECT' newoid
      if rc\=0 then exit 8
      call readobject newoid
      if result\='OK' | objtype\='COMMIT' then do
         say 'GIT: lightweight tags require a verified COMMIT object'
         exit 8
      end
      address command 'EXEC GIT UPDATE-REF' ref newoid oldoid
      if rc\=0 then exit rc
      say 'TAG UPDATED' ref oldoid newoid
      exit 0
   end
   if verb='-D' | verb='--DELETE' then do
      if tagname='' | extra\='' | fifth\='' then do
         say 'Usage: GIT TAG -d|--delete name [expected-commit-oid]'
         exit 4
      end
      call validtag tagname
      if result\='OK' then do
         say 'GIT: invalid tag name'
         exit 4
      end
      ref='refs/tags/'||tagname
      if oid='' then do
         call resolvestart ref
         expectedoid=result
         if expectedoid='ERROR' | expectedoid='HEAD' then do
            say 'GIT: cannot resolve tag' ref
            exit 8
         end
      end
      else do
         expectedoid=translate(oid)
         if length(expectedoid)\=40 |,
            verify(expectedoid,'0123456789ABCDEF')\=0 then do
            say 'GIT: invalid expected tag object-id'
            exit 4
         end
      end
      zeros='0000000000000000000000000000000000000000'
      address command 'EXEC GIT UPDATE-REF' ref zeros expectedoid
      if rc\=0 then exit rc
      say 'TAG DELETED' ref expectedoid
      exit 0
   end
   if action='' | oid\='' | extra\='' | fifth\='' then do
      say 'Usage: GIT TAG name [start-point]'
      say '       GIT TAG -d|--delete name [expected-commit-oid]'
      exit 4
   end
   call validtag action
   if result\='OK' then do
      say 'GIT: invalid tag name'
      exit 4
   end
   tagstart=tagname
   if tagstart='' then tagstart='HEAD'
   call resolvetagtarget tagstart
   tagoid=result
   if tagoid='ERROR' then do
      say 'GIT: cannot resolve tag start point' tagstart
      exit 4
   end
   oid=tagoid
   if length(oid)\=40 | verify(oid,'0123456789ABCDEF')\=0 then do
      say 'GIT: tag start point is not a valid object-id'
      exit 4
   end
   address command 'EXEC GIT VERIFY-OBJECT' oid
   if rc\=0 then exit 8
   call readobject oid
   if result\='OK' | objtype\='COMMIT' then do
      say 'GIT: lightweight tags require a verified COMMIT object'
      exit 8
   end
   zeros='0000000000000000000000000000000000000000'
   ref='refs/tags/'||action
   address command 'EXEC GIT UPDATE-REF' ref oid zeros
   if rc\=0 then exit rc
   say 'TAG CREATED' ref oid
   exit 0
end

/* Bounded porcelain LOG over the verified REF2 revision resolver. */
if command = 'LOG' then do
   parse var rest logarg1 logarg2 logarg3 logarg4
   logdepth='16'
   logstart='HEAD'
   logopt=translate(logarg1)
   if logopt='-N' | logopt='--MAX-COUNT' then do
      if logarg2='' | logarg4\='' then do
         say 'Usage: GIT LOG [-n|--max-count count] [revision]'
         exit 4
      end
      logdepth=logarg2
      if logarg3\='' then logstart=logarg3
   end
   else if left(logopt,12)='--MAX-COUNT=' then do
      if logarg3\='' | logarg4\='' then do
         say 'Usage: GIT LOG [-n|--max-count count] [revision]'
         exit 4
      end
      logdepth=substr(logarg1,13)
      if logarg2\='' then logstart=logarg2
   end
   else if left(logopt,2)='-N' & logopt\='-N' then do
      if logarg3\='' | logarg4\='' then do
         say 'Usage: GIT LOG [-n|--max-count count] [revision]'
         exit 4
      end
      logdepth=substr(logarg1,3)
      if logarg2\='' then logstart=logarg2
   end
   else if logarg1\='' then do
      if logarg2\='' | logarg3\='' | logarg4\='' then do
         say 'Usage: GIT LOG [-n|--max-count count] [revision]'
         exit 4
      end
      logstart=logarg1
   end
   if logdepth='' | length(logdepth)>2 |,
      verify(logdepth,'0123456789')\=0 then do
      say 'GIT: log count must be between 0 and 16'
      exit 4
   end
   if logdepth+0<0 | logdepth+0>16 then do
      say 'GIT: log count must be between 0 and 16'
      exit 4
   end
   call resolvetagtarget logstart
   logoid=result
   if logoid='ERROR' then do
      say 'GIT: cannot resolve log revision' logstart
      exit 8
   end
   if logdepth+0=0 then exit 0
   backenddepth=logdepth-1
   address command 'EXEC GITVREF LOG' logoid backenddepth
   exit rc
end

/* Resolve a revision before exposing the full-object SHOW reader. */
if command = 'SHOW' then do
   parse var rest showstart showextra
   if showextra\='' then do
      say 'Usage: GIT SHOW [revision]'
      exit 4
   end
   if showstart='' then showstart='HEAD'
   call resolvetagtarget showstart
   showoid=result
   if showoid='ERROR' then do
      say 'GIT: cannot resolve show revision' showstart
      exit 8
   end
   address command 'EXEC GITVREF SHOW' showoid
   exit rc
end

/* Prefer modern REF2 branches, retaining M5 refs when REF2 is absent. */
if command = 'BRANCH' then do
    'STATE GITREF2 REPO G'
    if rc=28 then do
       call legacybranch rest
       exit result
   end
   if rc\=0 then do
      say 'GIT: cannot inspect modern REF2 branch store RC' rc
      exit rc
   end
   if strip(rest)='' then do
      address command 'EXEC GITVREF BRANCHES'
      exit rc
   end
   parse var rest brancharg1 brancharg2 brancharg3 brancharg4 brancharg5
   verb=translate(brancharg1)
   zeros='0000000000000000000000000000000000000000'
   if verb='-R' | verb='--REMOTES' then do
      if brancharg3\='' | brancharg4\='' | brancharg5\='' then do
         say 'Usage: GIT BRANCH -r|--remotes [remote]'
         exit 4
      end
      address command 'EXEC GITVREF REMOTE-BRANCHES' brancharg2
      exit rc
   end
   if verb='-L' | verb='--LIST' then do
      if brancharg3\='' | brancharg4\='' | brancharg5\='' then do
         say 'Usage: GIT BRANCH [-l|--list [pattern]]'
         exit 4
      end
      if brancharg2\='' then do
         call validbranch brancharg2, 'PATTERN'
         if result\='OK' then do
            say 'GIT: invalid branch-list pattern'
            exit 4
         end
      end
      address command 'EXEC GITVREF BRANCHES' brancharg2
      exit rc
   end
   if verb='--SHOW-CURRENT' then do
      if brancharg2\='' | brancharg3\='' |,
         brancharg4\='' | brancharg5\='' then do
         say 'Usage: GIT BRANCH --show-current'
         exit 4
      end
      drop showhead.
      showhead.0=0
      'PIPE CMS EXEC GITVREF HEAD | STEM SHOWHEAD.'
      if rc\=0 | showhead.0\=1 then do
         say 'GIT: cannot resolve current symbolic HEAD'
         exit 8
      end
      call branchnamefromhead showhead.1
      if result='ERROR' then do
         say 'GIT: invalid current symbolic HEAD'
         exit 8
      end
      say result
      exit 0
   end
   if brancharg1='-m' | verb='--MOVE' then do
      if brancharg2='' | brancharg3='' |,
         brancharg4\='' | brancharg5\='' then do
         say 'Usage: GIT BRANCH -m|--move old-name new-name'
         exit 4
      end
      call validbranch brancharg3
      if result\='OK' then do
         say 'GIT: invalid destination branch name'
         exit 4
      end
      call resolvestart brancharg2
      expectedoid=result
      if expectedoid='ERROR' | expectedoid='HEAD' then do
         say 'GIT: cannot resolve old branch' brancharg2
         exit 4
      end
      oldref='refs/heads/'||brancharg2
      newref='refs/heads/'||brancharg3
      cmd='EXEC GIT UPDATE-REF MOVE-REF' oldref newref expectedoid
      address command cmd
      if rc\=0 then exit rc
      say 'BRANCH RENAMED' brancharg2 brancharg3
      exit 0
   end
   if verb='-D' | verb='--DELETE' then do
      if brancharg2='' | brancharg4\='' | brancharg5\='' then do
         say 'Usage: GIT BRANCH -d|--delete name [expected-old-oid]'
         exit 4
      end
      call validbranch brancharg2
      if result\='OK' then do
         say 'GIT: invalid branch name'
         exit 4
      end
      branchref='refs/heads/'||brancharg2
      if brancharg3='' then do
         call resolvestart branchref
         branchoid=result
         if branchoid='ERROR' | branchoid='HEAD' then do
            say 'GIT: cannot resolve branch' branchref
            exit 8
         end
      end
      else do
         branchoid=translate(brancharg3)
         if length(branchoid)\=40 |,
            verify(branchoid,'0123456789ABCDEF')\=0 then do
            say 'GIT: invalid expected branch object-id'
            exit 4
         end
      end
      address command 'EXEC GIT UPDATE-REF' branchref zeros branchoid
      if rc\=0 then exit rc
      say 'BRANCH DELETED' brancharg2 branchoid
      exit 0
   end
   if brancharg1='' | brancharg3\='' |,
      brancharg4\='' | brancharg5\='' then do
      say 'Usage: GIT BRANCH name [start-point]'
      say '       GIT BRANCH -d|--delete name [expected-old-oid]'
      exit 4
   end
   call validbranch brancharg1
   if result\='OK' then do
      say 'GIT: invalid branch name'
      exit 4
   end
   branchref='refs/heads/'||brancharg1
   branchstart=brancharg2
   if branchstart='' then branchstart='HEAD'
   call resolvetagtarget branchstart
   branchoid=result
   if branchoid='ERROR' then do
      say 'GIT: cannot resolve branch start point' branchstart
      exit 4
   end
   address command 'EXEC GIT UPDATE-REF' branchref branchoid zeros
   if rc\=0 then exit rc
   say 'BRANCH CREATED' brancharg1 branchoid
   exit 0
end

/* M218: change symbolic HEAD only when the branch tips are identical. */
if command = 'SWITCH' then do
   parse var rest switcharg brancharg startpoint extra
   switchmode=translate(switcharg)
   if switchmode='-C' | switchmode='--CREATE' then do
      if brancharg='' | extra\='' then do
         say 'Usage: GIT SWITCH -c|--create name [start-point]'
         exit 4
      end
      call validbranch brancharg
      if result\='OK' then do
         say 'GIT: invalid branch name'
         exit 4
      end
      if startpoint='' then startpoint='HEAD'
      call resolvestart startpoint
      if result='ERROR' then do
         say 'GIT: invalid branch start point' startpoint
         exit 4
      end
      startpoint=result
   end
   else do
      branchname=switcharg
      if branchname='' | brancharg\='' |,
         startpoint\='' | extra\='' then do
         say 'Usage: GIT SWITCH branch'
         exit 4
      end
      call validbranch branchname
      if result\='OK' then do
         say 'GIT: invalid branch name'
         exit 4
      end
   end
   drop currenthead.
   currenthead.0=0
   'PIPE CMS EXEC GITVREF HEAD | STEM CURRENTHEAD.'
   hrc=rc
   if hrc\=0 | currenthead.0\=1 then do
      say 'GIT: cannot resolve current symbolic HEAD'
      exit 8
   end
   headref=strip(currenthead.1)
   if left(headref,11)\='refs/heads/' then do
      say 'GIT: invalid current symbolic HEAD'
      exit 8
   end
   if switchmode='-C' | switchmode='--CREATE' then do
      cmd='EXEC GITUPD CREATE-HEAD refs/heads/'||brancharg||' '||,
          headref||' '||startpoint
   end
   else do
      cmd='EXEC GITUPD HEAD refs/heads/'||branchname||' '||headref
   end
   address command cmd
   exit rc
end

/* M5D integration boundary.  The read-only ref commands resolve from REF2;
 * the legacy M5A/M5B/M5C GITREF EXEC is not part of the modern bundle. */
if command = 'SHOW-REF' |,
   command = 'SYMBOLIC-REF' | command = 'REV-PARSE' then do
   if command = 'REV-PARSE' then do
      address command 'EXEC GITVREF OID' rest
      exit rc
   end
   if command = 'SHOW-REF' then do
      if strip(rest) \= '' then do
         say 'Usage: GIT SHOW-REF'
         exit 4
      end
      address command 'EXEC GITVREF REFS'
      exit rc
   end
   if length(rest) = 0 then do
      address command 'EXEC GITVREF HEAD'
      exit rc
   end
   say 'GIT: SYMBOLIC-REF update is not supported'
   exit 8
end
if command = 'UPDATE-REF' then do
   'EXEC GITUPD' rest
   exit rc
end
if command = 'VERIFY-REF' then do
   address command 'EXEC GITVREF RESOLVE' rest
   exit rc
end
if command = 'SHOW-REF-FULL' then do
   address command 'EXEC GITVREF SHOW' rest
   exit rc
end
if command = 'LOG-REF-FULL' then do
   address command 'EXEC GITVREF LOG' rest
   exit rc
end
if command = 'LOGDAG-REF-FULL' then do
   address command 'EXEC GITVREF DAG' rest
   exit rc
end

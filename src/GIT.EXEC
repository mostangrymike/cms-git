   exit rc
end
if command = 'HISTORYFIRSTSTATUS-REF-FULL' then do
   address command 'EXEC GITVREF HISTFSTAT' rest
   exit rc
end
if command = 'HISTORYFIRSTBOUNDS-REF-FULL' then do
   address command 'EXEC GITVREF HISTFBOUND' rest
   exit rc
end
if command = 'HISTORYFIRSTVERSIONS-REF-FULL' then do
   address command 'EXEC GITVREF HISTFVER' rest
   exit rc
end
if command = 'HISTORYFIRSTLIFETIME-REF-FULL' then do
   address command 'EXEC GITVREF HISTFLIFE' rest
   exit rc
end
if command = 'HISTORYFIRSTCURRENT-REF-FULL' then do
   address command 'EXEC GITVREF HISTFCUR' rest
   exit rc
end
if command = 'HISTORYFIRSTORIGIN-REF-FULL' then do
   address command 'EXEC GITVREF HISTFORIG' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCE-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPRES' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEORIGIN-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPORIG' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCECHRONOLOGY-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPCHR' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEEVENTS-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPEVT' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEDURATION-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPDUR' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEAGE-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPAGE' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCETIME-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPTIME' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCERATIO-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPRATIO' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCECOVERAGE-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPCOV' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEFRONTIER-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPFRONT' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEFRONTIERDISTANCE-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPFDIST' rest
   exit rc
end
if command = 'HISTORYFIRSTPRESENCEHORIZON-REF-FULL' then do
   address command 'EXEC GITVREF HISTFPHORIZ' rest
   exit rc
end

end
if command = 'HISTORYFIRSTPARENT-REF-FULL' then do
   address command 'EXEC GITVREF HISTFIRST' rest
   exit rc
end
if command = 'HISTORYFIRSTCHANGES-REF-FULL' then do
   address command 'EXEC GITVREF HISTFCHG' rest
   exit rc

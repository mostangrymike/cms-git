/* M165: CMS worktree plumbing with staged multi-path tree rewrites. */
address cms
parse arg command rest
command=translate(command)

if command='CHECKOUT' then do
 wc=words(rest)
 if wc<4 | wc>5 then do
  say 'Usage: GITWT CHECKOUT ref path fn ft [fm]'
  exit 4
 end
 spec=word(rest,1)
 path=word(rest,2)
 fn=translate(word(rest,3))
 ft=translate(word(rest,4))
 if wc=5 then fm=translate(word(rest,5))
 else fm='A'
 call validid fn
 if result\='OK' then exit 4
 call validid ft
 if result\='OK' then exit 4
 call validmode fm
 if result\='OK' then exit 4
 call toasciihex path
 pathhex=result
 if pathhex='ERROR' | length(pathhex)>60 then do
  say 'GITWT: M164 path must be 1-30 ASCII bytes'
  exit 4
 end
 call loadmap
 if result\='OK' then exit 8
 call findpath pathhex
 pi=result
 if pi>0 then do
  if mapfn.pi\=fn | mapft.pi\=ft | mapfm.pi\=fm then do
   say 'GITWT: path already mapped to another CMS file'
   exit 8
  end
 end
 call findfile fn,ft,fm
 fi=result
 if fi>0 & fi\=pi then do
  say 'GITWT: CMS file already mapped to another Git path'
  exit 8
 end
 'STATE' fn ft fm
 if rc=0 then do
  say 'GITWT: checkout target exists; M164 refuses overwrite'
  exit 8
 end
 if rc\=28 then do
  say 'GITWT: cannot inspect checkout target RC' rc
  exit 8
 end
 call readrefs
 if result\='OK' then exit 8
 call resolve spec
 oid=result
 if oid='ERROR' then exit 8
 call bindnative
 if result\='OK' then exit 8
 drop out.
 out.0=0
 cmd='GITREC PATHFULLCAT GITFIX M15NEW' oid pathhex
 'PIPE CMS' cmd '| STEM out.'
 grc=rc
 if grc\=0 then do
  say 'GITWT: authenticated checkout read failed RC' grc
  exit grc
 end
 call parsepathout
 if result\='OK' then exit 8
 call bodyrecords body
 if result\='OK' then exit 8
 call writework fn,ft,fm
 if result\='OK' then exit 8
 call workoid fn,ft,fm,final,0
 wo=result
 if wo\=pathoid then do
  'ERASE' fn ft fm
  say 'GITWT: workfile round-trip OID mismatch'
  exit 8
 end
 if pi=0 then do
  if mapcount>=50 then do
   'ERASE' fn ft fm
   say 'GITWT: worktree map limit reached'
   exit 8
  end
  mapcount=mapcount+1
  pi=mapcount
 end
 mapfn.pi=fn
 mapft.pi=ft
 mapfm.pi=fm
 maplf.pi=final
 mapbase.pi=pathoid
 mapstage.pi=pathoid
 mappath.pi=pathhex
 call savemap
 if result\='OK' then do
  'ERASE' fn ft fm
  exit 8
 end
 say 'CHECKED OUT' path 'AS' fn ft fm
 say 'WORKTREE OID' pathoid 'FINAL-LF' final
 exit 0
end

if command='STATUS' then do
 shortstatus=0
 statusbranch=0
 do si=1 to words(rest)
  statusopt=translate(word(rest,si))
  if statusopt='--SHORT' | statusopt='--PORCELAIN' then,
   shortstatus=1
  else if statusopt='--BRANCH' then statusbranch=1
  else do
   say 'Usage: GIT STATUS [--short|--porcelain] [--branch]'
   exit 4
  end
 end
 if statusbranch=1 then do
  call readrefs
  if result\='OK' then exit 8
  branchname=substr(headref,12)
  if shortstatus=1 then say '##' branchname
  else say 'On branch' branchname
 end
 call loadmap
 if result\='OK' then exit 8
 if mapcount=0 then do
  if shortstatus=0 then say 'STATUS NO TRACKED FILES'
  exit 0
 end
 changed=0
 staged=0
 zeros='0000000000000000000000000000000000000000'
 do i=1 to mapcount
  call asciitocms mappath.i
  p=result
  if p='ERROR' then exit 8
  'STATE' mapfn.i mapft.i mapfm.i
  if rc=28 then do
   state='DELETED'
   work='-'
   changed=changed+1
  end
  else if rc\=0 then exit 8
  else do
   call workoid mapfn.i,mapft.i,mapfm.i,maplf.i,0
   work=result
   if work='ERROR' then exit 8
   if work=mapstage.i then do
    if mapstage.i=mapbase.i then state='CLEAN'
    else do
     state='STAGED'
     staged=staged+1
    end
   end
   else do
    changed=changed+1
    if mapstage.i=mapbase.i then state='MODIFIED'
    else do
     state='STAGED+MODIFIED'
     staged=staged+1
    end
   end
  end
  if shortstatus=1 then do
   x=' '
   y=' '
   if mapstage.i\=mapbase.i then do
    if mapbase.i=zeros then x='A'
    else x='M'
   end
   if state='DELETED' then y='D'
   else if state='MODIFIED' | state='STAGED+MODIFIED' then y='M'
   if x\=' ' | y\=' ' then say x||y||' '||p
  end
  else do
   say 'STATUS' p state
   say 'BASE' mapbase.i
   say 'STAGE' mapstage.i
   say 'WORK' work
  end
 end
 if shortstatus=0 then say 'STATUS SUMMARY TRACKED' mapcount,
     'CHANGED' changed 'STAGED' staged
 exit 0
end

if command='DIFF' then do
 diffarg1=translate(word(rest,1))
 diffarg2=translate(word(rest,2))
 cached=0
 if diffarg1='--CACHED' | diffarg1='--STAGED' then do
  if words(rest)\=2 | diffarg2\='--NAME-ONLY' then do
   say 'Usage: GIT DIFF [--cached|--staged] --name-only'
   exit 4
  end
  cached=1
 end
 else if words(rest)\=1 | diffarg1\='--NAME-ONLY' then do
  say 'Usage: GIT DIFF [--cached|--staged] --name-only'
  exit 4
 end
 call loadmap
 if result\='OK' then exit 8
 do i=1 to mapcount
  changed=0
  if cached=1 then do
   if mapstage.i\=mapbase.i then changed=1
  end
  else do
   'STATE' mapfn.i mapft.i mapfm.i
   if rc=28 then changed=1
   else if rc\=0 then exit 8
   else do
    call workoid mapfn.i,mapft.i,mapfm.i,maplf.i,0
    work=result
    if work='ERROR' then exit 8
    if work\=mapstage.i then changed=1
   end
  end
  if changed=1 then do
   call asciitocms mappath.i
   path=result
   if path='ERROR' then exit 8
   say path
  end
 end
 exit 0
end

/* Read-only preflight for a branch switch across different commit tips. */
if command='CHECK-SWITCH' then do
 parse var rest expectedref targetref extra
 if expectedref='' | targetref='' | extra\='' then do
  say 'Usage: GITWT CHECK-SWITCH expected-head-ref target-branch-ref'
  exit 4
 end
 call validref expectedref
 if result\='OK' | left(expectedref,11)\='refs/heads/' then exit 4
 targetoid=''
 if length(targetref)=40 &,
    verify(translate(targetref),'0123456789ABCDEF')=0 then do
  targetoid=translate(targetref)
 end
 else do
  call validref targetref
  if result\='OK' | left(targetref,11)\='refs/heads/' then exit 4
end
 call readrefs
 if result\='OK' then do
  say 'GITWT: cannot read REF2 for switch preflight'
  exit 8
 end
 if headref\=expectedref then do
  say 'GITWT: symbolic HEAD changed during switch preflight'
  exit 8
 end
 call resolve expectedref
 currentcommit=result
 if currentcommit='ERROR' then exit 8
 if targetoid='' then do
  call resolve targetref
  targetcommit=result
 end
 else targetcommit=targetoid
 if targetcommit='ERROR' then exit 8
 call loadmap
 if result\='OK' then do
  say 'GITWT: cannot read worktree map for switch preflight'
  exit 8
 end
 if mapcount=0 then do
  say 'SWITCH PREFLIGHT SAFE UNMAPPED 0'
  exit 0
 end
 call bindnative
 if result\='OK' then exit 8
 do mi=1 to mapcount
  if mapstage.mi\=mapbase.mi then do
   say 'GITWT: staged changes block branch switch' mappath.mi
   exit 8
  end
  call checkworkfile mapfn.mi,mapft.mi,mapfm.mi
  if result\='OK' then do
   say 'GITWT: missing mapped file blocks branch switch',
       mapfn.mi mapft.mi mapfm.mi
   exit 8
  end
  call workoid mapfn.mi,mapft.mi,mapfm.mi,maplf.mi,0
  workoid=result
  if workoid\=mapbase.mi then do
   say 'GITWT: modified workfile blocks branch switch' mappath.mi
   exit 8
  end
  call pathoidfor currentcommit,mappath.mi
  currentpath=result
  if currentpath\=mapbase.mi then do
   say 'GITWT: worktree base is stale against current branch',
       mappath.mi
   exit 8
  end
  call pathoidfor targetcommit,mappath.mi
  targetpath=result
  if targetpath\=mapbase.mi then do
   say 'GITWT: destination changes mapped path' mappath.mi
   exit 8
  end
 end
 say 'SWITCH PREFLIGHT SAFE MAPPED' mapcount
 exit 0
end

if command='ADD' then do
 addall=0
 addstart=1
 addrequested=words(rest)
 if addrequested=1 & (translate(word(rest,1))='-U' |,
    translate(word(rest,1))='--UPDATE') then addall=1
 else if word(rest,1)='--' then do
  addstart=2
  addrequested=addrequested-1
 end
 else if left(word(rest,1),1)='-' then do
  say 'Usage: GIT ADD [-u|--update] | [--] path [path ...]'
  exit 4
 end
 if addall=0 & (addrequested<1 | addrequested>16) then do
  say 'Usage: GIT ADD path [path ...] (maximum 16 paths)'
  exit 4
 end
 call loadmap
 if result\='OK' then exit 8
 drop addpi. addpath. addold. addoid.
 addcount=0
 if addall=1 then do
  if mapcount=0 then do
   say 'GITWT: no mapped paths to update'
   exit 0
  end
  do ai=1 to mapcount
   addcount=addcount+1
   addpi.addcount=ai
   call asciitocms mappath.ai
   path=result
   if path='ERROR' then do
    say 'GITWT: invalid mapped path' mappath.ai
    exit 8
   end
   addpath.addcount=path
  end
 end
 else do
  do ai=addstart to words(rest)
   path=word(rest,ai)
   call toasciihex path
   pathhex=result
   if pathhex='ERROR' | length(pathhex)>60 then do
    say 'GITWT: invalid path' path
    exit 4
   end
   call findpath pathhex
   pi=result
   if pi=0 then do
    say 'GITWT: path is not checked out' path
    exit 4
   end
   duplicate=0
   do aj=1 to addcount
    if addpi.aj=pi then duplicate=1
   end
   if duplicate=1 then iterate
   addcount=addcount+1
   addpi.addcount=pi
   addpath.addcount=path
  end
 end
 do ai=1 to addcount
  pi=addpi.ai
  'STATE' mapfn.pi mapft.pi mapfm.pi
  if rc\=0 then do
   say 'GITWT: mapped CMS file is absent' addpath.ai
   exit 8
  end
  call workoid mapfn.pi,mapft.pi,mapfm.pi,maplf.pi,1
  wo=result
  if wo='ERROR' then exit 8
  addoid.ai=wo
  addold.ai=mapstage.pi
 end
 do ai=1 to addcount
  pi=addpi.ai
  mapstage.pi=addoid.ai
 end
 call savemap
 if result\='OK' then do
  do ai=1 to addcount
   pi=addpi.ai
   mapstage.pi=addold.ai
  end
  exit 8
 end
 do ai=1 to addcount
  pi=addpi.ai
  say 'ADDED' addpath.ai addoid.ai
  if addoid.ai=mapbase.pi then say 'STAGE MATCHES BASE'
  else say 'STAGE DIFFERS FROM BASE'
 end
 exit 0
end

if command='RESET' then do
 resetstart=1
 resetrequested=words(rest)
 if word(rest,1)='--' then do
  resetstart=2
  resetrequested=resetrequested-1
 end
 else if left(word(rest,1),1)='-' then do
  say 'Usage: GIT RESET [--] path [path ...]'
  exit 4
 end
 if resetrequested<1 | resetrequested>16 then do
  say 'Usage: GIT RESET [--] path [path ...] (maximum 16 paths)'
  exit 4
 end
 call loadmap
 if result\='OK' then exit 8
 drop resetpi. resetpath. resetold.
 resetcount=0
 do ai=resetstart to words(rest)
  path=word(rest,ai)
  call toasciihex path
  pathhex=result
  if pathhex='ERROR' | length(pathhex)>60 then do
   say 'GITWT: invalid path' path
   exit 4
  end
  call findpath pathhex
  pi=result
  if pi=0 then do
   say 'GITWT: path is not checked out' path
   exit 4
  end
  duplicate=0
  do aj=1 to resetcount
   if resetpi.aj=pi then duplicate=1
  end
  if duplicate=1 then iterate
  resetcount=resetcount+1
  resetpi.resetcount=pi
  resetpath.resetcount=path
  resetold.resetcount=mapstage.pi
 end
 do ai=1 to resetcount
  pi=resetpi.ai
  mapstage.pi=mapbase.pi
 end
 call savemap
 if result\='OK' then do
  do ai=1 to resetcount
   pi=resetpi.ai
   mapstage.pi=resetold.ai
  end
  exit 8
 end
 do ai=1 to resetcount
  say 'UNSTAGED' resetpath.ai
 end
 exit 0
end

if command='ACCEPT' then do
 if strip(rest)\='' then do
  say 'Usage: GITWT ACCEPT'
  exit 4
 end
 say 'GITWT ACCEPT LEVEL M168'
 drop before.
 'EXECIO * DISKR GITWORK REPO A 1 (STEM BEFORE. FINIS'
 if rc\=0 then do
  say 'GITWT: cannot snapshot worktree map'
  exit 8
 end
 call loadmap
 if result\='OK' then exit 8
 if mapcount<1 then do
  say 'GITWT: no tracked paths to accept'
  exit 8
 end
 oldcount=mapcount
 acceptedcount=0
 do ai=1 to mapcount
  oldbase.ai=mapbase.ai
  if mapstage.ai\=mapbase.ai then acceptedcount=acceptedcount+1
  'STATE' mapfn.ai mapft.ai mapfm.ai
  if rc\=0 then do
   say 'GITWT: mapped workfile is absent' mapfn.ai mapft.ai mapfm.ai
   exit 8
  end
  call workoid mapfn.ai,mapft.ai,mapfm.ai,maplf.ai,0
  accepted=result
  if accepted='ERROR' then exit 8
  if accepted\=mapstage.ai then do
   say 'GITWT: workfile changed after commit' mapfn.ai mapft.ai mapfm.ai
   exit 8
  end
 end
 if acceptedcount=0 then do
  say 'GITWT: no staged change to accept'
  exit 8
 end
 do ai=1 to mapcount
  mapbase.ai=mapstage.ai
 end
 call savemap
 if result\='OK' then do
  call restoremap
  say 'GITWT: cannot accept committed worktree map'
  exit 8
 end
 call loadmap
 if result\='OK' | mapcount\=oldcount then do
  call restoremap
  say 'GITWT: accepted map verification failed'
  exit 8
 end
 do ai=1 to mapcount
  if mapbase.ai\=mapstage.ai then do
   call restoremap
   say 'GITWT: accepted map verification failed'
   exit 8
  end
  if oldbase.ai\=mapbase.ai then do
   say 'ACCEPTED WORKTREE OLD' oldbase.ai
   say 'ACCEPTED WORKTREE NEW' mapbase.ai
  end
 end
 say 'ACCEPTED WORKTREE PATHS' acceptedcount
 exit 0
end

if command='COMMIT' then do
 stamp=''
 zone=''
 message=''
 ci=1
 do while ci<=words(rest)
  if ci=words(rest) then do
   say 'Usage: GIT COMMIT-STAGED -T seconds -Z zone -M message'
   exit 4
  end
  opt=translate(word(rest,ci))
  val=word(rest,ci+1)
  if opt='-T' then stamp=val
  else if opt='-Z' then zone=val
  else if opt='-M' then message=val
  else do
   say 'GITWT: unknown COMMIT-STAGED option' word(rest,ci)
   exit 4
  end
  ci=ci+2
 end
 if stamp='' | zone='' | message='' then do
  say 'Usage: GIT COMMIT-STAGED -T seconds -Z zone -M message'
  exit 4
 end
 say 'GITWT COMMIT LEVEL M165'
 call loadmap
 if result\='OK' then exit 8
 if mapcount<1 then do
  say 'GITWT: no tracked paths to commit'
  exit 8
 end
 stagedcount=0
 do mi=1 to mapcount
  if mapstage.mi\=mapbase.mi then stagedcount=stagedcount+1
  'STATE' mapfn.mi mapft.mi mapfm.mi
  if rc\=0 then do
   say 'GITWT: mapped workfile is absent' mapfn.mi mapft.mi mapfm.mi
   exit 8
  end
  call workoid mapfn.mi,mapft.mi,mapfm.mi,maplf.mi,0
  work=result
  if work='ERROR' then exit 8
  if work\=mapstage.mi then do
   say 'GITWT: unstaged workfile change' mapfn.mi mapft.mi mapfm.mi
   exit 8
  end
 end
 if stagedcount=0 then do
  say 'GITWT: no staged change'
  exit 8
 end
 call readrefs
 if result\='OK' then exit 8
 call resolve 'HEAD'
 parent=result
 if parent='ERROR' then exit 8
 call bindnative
 if result\='OK' then exit 8
 call rootfor parent
 root=result
 if root='ERROR' then exit 8
 drop nodeparent. nodename. nodeentry. nodeoid. nodedepth.
 drop nodechanged. nodeentries. nodemode. nodenamehex. nodechildoid.
 drop pathcomp.
 nodecount=1
 nodeparent.1=0
 nodename.1=''
 nodeentry.1=0
 nodeoid.1=root
 nodedepth.1=0
 nodechanged.1=0
 maxdepth=0
 firstpath=0
 do mi=1 to mapcount
  if mapstage.mi\=mapbase.mi then do
   firstpath=mi
   leave
  end
 end
 call splitpath mappath.firstpath
 if result\='OK' then exit 8
 call loadnode 1,root,pcomp.1
 if result\='OK' then do
  say 'GITWT: cannot load commit root tree'
  exit 8
 end
 do mi=1 to mapcount
  if mapstage.mi\=mapbase.mi then do
   call splitpath mappath.mi
   if result\='OK' then exit 8
   if pcnt>maxdepth then maxdepth=pcnt
   do cd=1 to pcnt
    pathcomp.mi.cd=pcomp.cd
   end
   currentnode=1
   do cd=1 to pcnt
    entryindex=0
    do ei=1 to nodeentries.currentnode
     if nodenamehex.currentnode.ei=pathcomp.mi.cd then do
      entryindex=ei
      leave
     end
    end
    if entryindex=0 then do
     say 'GITWT: staged path entry missing' mi cd
     exit 8
    end
    if cd<pcnt then do
     if nodemode.currentnode.entryindex\='40000' then do
      say 'GITWT: staged path ancestor is not a tree' mi cd
      exit 8
     end
     childnode=0
     do ni=2 to nodecount
      if nodeparent.ni=currentnode &,
         nodename.ni=pathcomp.mi.cd then do
       childnode=ni
       leave
      end
     end
     if childnode=0 then do
      nodecount=nodecount+1
      childnode=nodecount
      nodeparent.childnode=currentnode
      nodename.childnode=pathcomp.mi.cd
      nodeentry.childnode=entryindex
      nodeoid.childnode=nodechildoid.currentnode.entryindex
      nodedepth.childnode=cd
      nodechanged.childnode=0
      nextdepth=cd+1
      nextcomp=pathcomp.mi.nextdepth
      call loadnode childnode,nodeoid.childnode,nextcomp
      if result\='OK' then do
       say 'GITWT: cannot load staged path subtree' mi cd
       exit 8
      end
     end
     currentnode=childnode
    end
    else do
     if nodechildoid.currentnode.entryindex\=mapbase.mi then do
      say 'GITWT: checkout base is stale against HEAD' mi
      exit 8
     end
     if nodemode.currentnode.entryindex='40000' |,
        nodemode.currentnode.entryindex='160000' then do
      say 'GITWT: staged path is not a local blob' mi
      exit 8
     end
     address command 'EXEC GIT VERIFY-OBJECT' mapstage.mi
     if rc\=0 then exit 8
     nodechildoid.currentnode.entryindex=mapstage.mi
     nodechanged.currentnode=1
    end
   end
  end
 end
 do level=maxdepth to 1 by -1
  do ni=2 to nodecount
   if nodedepth.ni=level & nodechanged.ni=1 then do
    raw=''
    do ei=1 to nodeentries.ni
     call modehex nodemode.ni.ei
     mh=result
     if mh='ERROR' then exit 8
     raw=raw||mh||'20'||nodenamehex.ni.ei||'00'||,
       nodechildoid.ni.ei
    end
    call writehex raw
    treeoid=result
    if treeoid='ERROR' then exit 8
    nodeoid.ni=treeoid
    parentnode=nodeparent.ni
    parententry=nodeentry.ni
    nodechildoid.parentnode.parententry=treeoid
    nodechanged.parentnode=1
    say 'COMMIT-STAGED TREE DEPTH' level treeoid
   end
  end
 end
 if nodechanged.1\=1 then do
  say 'GITWT: no rewritten root tree'
  exit 8
 end
 raw=''
 do ei=1 to nodeentries.1
  call modehex nodemode.1.ei
  mh=result
  if mh='ERROR' then exit 8
  raw=raw||mh||'20'||nodenamehex.1.ei||'00'||nodechildoid.1.ei
 end
 call writehex raw
 newroot=result
 if newroot='ERROR' then exit 8
 say 'COMMIT-STAGED ROOT TREE' newroot
 address command 'EXEC GIT IMPORT-OBJECT' parent
 if rc\=0 then exit 8
 drop co.
 co.0=0
 cmd='GIT COMMIT-TREE' newroot '-P' parent,
     '-T' stamp '-Z' zone '-M' message
 'PIPE CMS' cmd '| STEM co.'
 if rc\=0 then exit 8
 found=0
 commit=''
 do coi=1 to co.0
  candidate=translate(strip(co.coi))
  if length(candidate)=40 &,
     verify(candidate,'0123456789ABCDEF')=0 then do
   found=found+1
   commit=candidate
  end
 end
 if found\=1 then exit 8
 address command 'EXEC GIT VERIFY-OBJECT' commit
 if rc\=0 then exit 8
 say 'COMMIT-STAGED PARENT' parent
 say 'COMMIT-STAGED ROOT' newroot
 say 'COMMIT-STAGED COMMIT' commit
 say 'COMMIT-STAGED PATHS' stagedcount
 say 'COMMIT-STAGED REFS UNCHANGED'
 exit 0
end

say 'GITWT: unknown command' command
exit 4

parsepathout:
 closure=0
 meta=0
 begins=0
 ends=0
 indata=0
 body=''
 do oi=1 to out.0
  line=out.oi
  if line='COMMIT ROOT FULL CLOSURE VERIFIED' then closure=closure+1
  else if word(line,1)='PATH' & word(line,2)='OBJECT' &,
     word(line,3)='TYPE' then do
   if meta | words(line)\=8 then return 'ERROR'
   if word(line,4)\='3' | word(line,5)\='SIZE' |,
      word(line,7)\='OID' then return 'ERROR'
   pathsize=word(line,6)
   pathoid=translate(word(line,8))
   if datatype(pathsize,'W')\=1 | pathsize<0 | pathsize>65536 then,
    return 'ERROR'
   if length(pathoid)\=40 |,
      verify(pathoid,'0123456789ABCDEF')\=0 then return 'ERROR'
   meta=1
  end
  else if line='PATH DATA BEGIN' then do
   if begins | indata then return 'ERROR'
   begins=1
   indata=1
  end
  else if line='PATH DATA END' then do
   if \indata | ends then return 'ERROR'
   ends=1
   indata=0
  end
  else if indata then do
   if word(line,1)\='PATH' | word(line,2)\='HEX' |,
      words(line)\=3 then return 'ERROR'
   h=translate(word(line,3))
   if h='' | length(h)>64 | length(h)//2\=0 |,
      verify(h,'0123456789ABCDEF')\=0 then return 'ERROR'
   body=body||h
  end
 end
 if closure\=1 | meta\=1 | begins\=1 | ends\=1 | indata then,
  return 'ERROR'
 if length(body)%2\=pathsize then return 'ERROR'
 return 'OK'

pathoidfor:
 parse arg pcommit,ppath
 drop out.
 out.0=0
 cmd='GITREC PATHFULLCAT GITFIX M15NEW' pcommit ppath
 'PIPE CMS' cmd '| STEM out.'
 if rc\=0 then return 'ERROR'
 call parsepathout
 if result\='OK' then return 'ERROR'
 return pathoid

checkworkfile:
 parse arg wfn,wft,wfm
 'STATE' wfn wft wfm
 if rc\=0 then return 'OK'
 return 'ERROR'

bodyrecords:
 parse arg h
 drop rec.
 rec.0=0
 final=0
 if h\='' & right(h,2)='0A' then do
  final=1
  h=left(h,length(h)-2)
 end
 if h='' then return 'OK'
 do forever
  call bytepos '0A',h
  bp=result
  if bp=0 then do
   part=h
   h=''
  end
  else do
   part=left(h,bp-1)
   h=substr(h,bp+2)
  end
  call validtext part
  if result\='OK' then do
   say 'GITWT: checkout currently supports CMS text files only'
   return 'ERROR'
  end
  if length(part)%2>80 then do
   say 'GITWT: Git line exceeds CMS LRECL 80'
   return 'ERROR'
  end
  call asciitocms part
  txt=result
  if txt='ERROR' then return 'ERROR'
  rec.0=rec.0+1
  n=rec.0
  rec.n=txt
  if bp=0 then leave
 end
 return 'OK'

writework:
 parse arg wfn,wft,wfm
 if rec.0=0 then,
  'EXECIO 0 DISKW' wfn wft wfm '1 F 80 (FINIS'
 else,
  'EXECIO' rec.0 'DISKW' wfn wft wfm '1 F 80 (STEM REC. FINIS'
 wrc=rc
 if wrc\=0 then do
  say 'GITWT: cannot write CMS workfile'
  return 'ERROR'
 end
 return 'OK'

workoid:
 parse arg wfn,wft,wfm,wlf,write
 if write then verb='WRITE-WORKFILE'
 else verb='HASH-WORKFILE'
 drop wh.
 wh.0=0
 'PIPE CMS GIT' verb wfn wft wfm wlf '| STEM wh.'
 wrc=rc
 if wrc\=0 then return 'ERROR'
 found=0
 x=''
 do wi=1 to wh.0
  candidate=translate(strip(wh.wi))
  if length(candidate)=40 &,
     verify(candidate,'0123456789ABCDEF')=0 then do
   found=found+1
   x=candidate
  end
 end
 if found\=1 then return 'ERROR'
 return x

rootfor:
 parse arg commit
 drop sf.
 sf.0=0
 cmd='GITREC SHOWFULL GITFIX M15NEW' commit
 'PIPE CMS' cmd '| STEM sf.'
 if rc\=0 then return 'ERROR'
 marker=0
 roots=0
 answer=''
 do sfi=1 to sf.0
  if sf.sfi='SHOW FULL ROOT CLOSURE VERIFIED' then marker=marker+1
  if word(sf.sfi,1)='COMMIT' & word(sf.sfi,2)='TREE' then do
   oid=translate(word(sf.sfi,3))
   if length(oid)\=40 |,
      verify(oid,'0123456789ABCDEF')\=0 then return 'ERROR'
   roots=roots+1
   answer=oid
  end
 end
 if marker\=1 | roots\=1 then return 'ERROR'
 return answer

splitpath:
 parse arg ph
 drop pcomp.
 pcnt=0
 part=''
 if ph='' | length(ph)//2\=0 then return 'ERROR'
 do spi=1 to length(ph) by 2
  b=translate(substr(ph,spi,2))
  if b='2F' then do
   if part='' then return 'ERROR'
   pcnt=pcnt+1
   pcomp.pcnt=part
   part=''
  end
  else do
   if verify(b,'0123456789ABCDEF')\=0 then return 'ERROR'
   part=part||b
  end
 end
 if part='' then return 'ERROR'
 pcnt=pcnt+1
 pcomp.pcnt=part
 if pcnt<1 | pcnt>16 then return 'ERROR'
 return 'OK'

readtree:
 parse arg toid,target
 drop tout. emode. enlen. eoid. ename.
 tout.0=0
 begin=0
 ending=0
 declared=-1
 ecount=0
 currente=0
 fn=substr(toid,1,8)
 'STATE' fn 'GITOBJ A'
 localrc=rc
 if localrc=0 then do
  address command 'EXEC GIT VERIFY-OBJECT' toid
  if rc\=0 then return 'ERROR'
  drop loose.
  'EXECIO * DISKR' fn 'GITOBJ A 1 (STEM LOOSE. FINIS'
  if rc\=0 | loose.0<3 then return 'ERROR'
  if word(loose.1,1)\='OID' |,
     translate(word(loose.1,2))\=toid |,
     words(loose.1)\=2 | word(loose.2,1)\='TYPE' |,
     word(loose.2,2)\='TREE' | words(loose.2)\=2 |,
     word(loose.3,1)\='SIZE' | words(loose.3)\=2 then return 'ERROR'
  treesize=word(loose.3,2)
  if datatype(treesize,'W')\=1 then return 'ERROR'
  raw=''
  do ti=4 to loose.0
   if word(loose.ti,1)\='DATA' | words(loose.ti)\=2 then,
    return 'ERROR'
   chunk=translate(word(loose.ti,2))
   if chunk='' | length(chunk)>128 | length(chunk)//2\=0 |,
      verify(chunk,'0123456789ABCDEF')\=0 then return 'ERROR'
   raw=raw||chunk
  end
  if length(raw)%2\=treesize then return 'ERROR'
  at=1
  do while at<=length(raw)
   modehex=''
   do while at<=length(raw) & substr(raw,at,2)\='20'
    modehex=modehex||substr(raw,at,2)
    at=at+2
   end
   if modehex='' | at>length(raw) then return 'ERROR'
   call asciitocms modehex
   mode=result
   if mode='ERROR' then return 'ERROR'
   at=at+2
   namehex=''
   do while at<=length(raw) & substr(raw,at,2)\='00'
    namehex=namehex||substr(raw,at,2)
    at=at+2
   end
   if namehex='' | at>length(raw) then return 'ERROR'
   at=at+2
   if at+39>length(raw) then return 'ERROR'
   oid=substr(raw,at,40)
   if verify(oid,'0123456789ABCDEF')\=0 then return 'ERROR'
   at=at+40
   ecount=ecount+1
   emode.ecount=mode
   enlen.ecount=length(namehex)%2
   eoid.ecount=oid
   ename.ecount=namehex
   if ecount>256 then return 'ERROR'
  end
  declared=ecount
  begin=1
  ending=1
 end
 else do
  if localrc\=28 then return 'ERROR'
  cmd='GITREC TREE GITFIX M15NEW' toid
  'PIPE CMS' cmd '| STEM tout.'
  if rc\=0 then return 'ERROR'
  do ti=1 to tout.0
   line=tout.ti
   if line='TREE DATA BEGIN' then begin=begin+1
   else if line='TREE DATA END' then ending=ending+1
   else if word(line,1)='TREE' & word(line,2)='ENTRY' then do
    if word(line,3)\='MODE' | word(line,5)\='NAMELEN' |,
       word(line,7)\='OID' | words(line)\=8 then return 'ERROR'
    ecount=ecount+1
    currente=ecount
    emode.ecount=word(line,4)
    enlen.ecount=word(line,6)
    eoid.ecount=translate(word(line,8))
    ename.ecount=''
   end
   else if word(line,1)='TREE' & word(line,2)='NAMEHEX' then do
    if currente<1 | words(line)\=3 then return 'ERROR'
    ename.currente=ename.currente||translate(word(line,3))
   end
   else if word(line,1)='TREE' & word(line,2)='ENTRIES' then do
    if words(line)\=3 then return 'ERROR'
    declared=word(line,3)
   end
  end
 end
 if begin\=1 | ending\=1 then return 'ERROR'
 if datatype(declared,'W')\=1 | declared\=ecount then return 'ERROR'
 matches=0
 foundoid=''
 foundmode=''
 foundindex=0
 do ei=1 to ecount
  mode=emode.ei
  if mode\='100644' & mode\='100755' & mode\='120000' &,
     mode\='40000' & mode\='160000' then return 'ERROR'
  if datatype(enlen.ei,'W')\=1 | enlen.ei<1 then return 'ERROR'
  if length(ename.ei)\=enlen.ei*2 then return 'ERROR'
  if verify(ename.ei,'0123456789ABCDEF')\=0 then return 'ERROR'
  if length(eoid.ei)\=40 |,
     verify(eoid.ei,'0123456789ABCDEF')\=0 then return 'ERROR'
  if ename.ei=target then do
   matches=matches+1
   foundoid=eoid.ei
   foundmode=mode
   foundindex=ei
  end
 end
 if matches\=1 then return 'ERROR'
 return 'OK'

loadnode:
 parse arg loadid,loadtree,loadtarget
 call readtree loadtree,loadtarget
 if result\='OK' then return 'ERROR'
 nodeentries.loadid=ecount
 do li=1 to ecount
  nodemode.loadid.li=emode.li
  nodenamehex.loadid.li=ename.li
  nodechildoid.loadid.li=eoid.li
 end
 return 'OK'

modehex:
 parse arg mode
 if mode='100644' then return '313030363434'
 if mode='100755' then return '313030373535'
 if mode='120000' then return '313230303030'
 if mode='40000' then return '3430303030'
 if mode='160000' then return '313630303030'
 return 'ERROR'

writehex:
 parse arg raw
 'STATE GITTREE REPO A'
 trc=rc
 if trc=0 then do
  'ERASE GITTREE REPO A'
  if rc\=0 then return 'ERROR'
 end
 else if trc\=28 then return 'ERROR'
 drop tr.
 tn=0
 tp=1
 if raw='' then do
  tn=1
  tr.1='EMPTY'
 end
 else do while tp<=length(raw)
  take=min(64,length(raw)-tp+1)
  tn=tn+1
  tr.tn='HEX' substr(raw,tp,take)
  tp=tp+take
 end
 tr.0=tn
 'EXECIO' tr.0 'DISKW GITTREE REPO A 1 (STEM TR. FINIS'
 if rc\=0 then return 'ERROR'
 drop tw.
 tw.0=0
 'PIPE CMS GIT WRITE-TREE-HEXFILE GITTREE REPO A | STEM tw.'
 wrc=rc
 'ERASE GITTREE REPO A'
 erc=rc
 if wrc\=0 | erc\=0 then return 'ERROR'
 found=0
 answer=''
 do wti=1 to tw.0
  candidate=translate(strip(tw.wti))
  if length(candidate)=40 &,
     verify(candidate,'0123456789ABCDEF')=0 then do
   found=found+1
   answer=candidate
  end
 end
 if found\=1 then return 'ERROR'
 return answer

loadmap:
 drop mapfn. mapft. mapfm. maplf.


 drop mapbase. mapstage. mappath.
 mapcount=0
 'STATE GITWORK REPO A'
 mrc=rc
 if mrc=28 then return 'OK'
 if mrc\=0 then return 'ERROR'
 drop wm.
 'EXECIO * DISKR GITWORK REPO A 1 (STEM WM. FINIS'
 if rc\=0 | wm.0<2 then return 'ERROR'
 if word(wm.1,1)\='WORK1' | words(wm.1)\=2 then return 'ERROR'
 mapcount=word(wm.1,2)
 if datatype(mapcount,'W')\=1 | mapcount<0 | mapcount>50 then,
  return 'ERROR'
 if wm.0\=2+mapcount*5 then return 'ERROR'
 at=2
 do mi=1 to mapcount
  line=wm.at
  if word(line,1)\='ENTRY' | word(line,2)\=mi |,
     words(line)\=6 then return 'ERROR'
  mapfn.mi=word(line,3)
  mapft.mi=word(line,4)
  mapfm.mi=word(line,5)
  maplf.mi=word(line,6)
  call validid mapfn.mi
  if result\='OK' then return 'ERROR'
  call validid mapft.mi
  if result\='OK' then return 'ERROR'
  call validmode mapfm.mi
  if result\='OK' then return 'ERROR'
  if maplf.mi\='0' & maplf.mi\='1' then return 'ERROR'
  at=at+1
  line=wm.at
  if word(line,1)\='BASE' | word(line,2)\=mi |,
     words(line)\=3 then return 'ERROR'
  mapbase.mi=translate(word(line,3))
  if length(mapbase.mi)\=40 |,
     verify(mapbase.mi,'0123456789ABCDEF')\=0 then return 'ERROR'
  at=at+1
  line=wm.at
  if word(line,1)\='STAGE' | word(line,2)\=mi |,
     words(line)\=3 then return 'ERROR'
  mapstage.mi=translate(word(line,3))
  if length(mapstage.mi)\=40 |,
     verify(mapstage.mi,'0123456789ABCDEF')\=0 then return 'ERROR'
  at=at+1
  line=wm.at
  if word(line,1)\='PATH' | word(line,2)\=mi |,
     words(line)\=3 then return 'ERROR'
  mappath.mi=translate(word(line,3))
  if mappath.mi='' | length(mappath.mi)>60 |,
     length(mappath.mi)//2\=0 then return 'ERROR'
  if verify(mappath.mi,'0123456789ABCDEF')\=0 then return 'ERROR'
  at=at+1
  if wm.at\='END' mi then return 'ERROR'
  at=at+1
 end
 if wm.at\='WORKEND' mapcount then return 'ERROR'
 return 'OK'

restoremap:
 'STATE GITWORK REPO A'
 rmc=rc
 if rmc=0 then do
  'ERASE GITWORK REPO A'
  if rc\=0 then return 'ERROR'
 end
 else if rmc\=28 then return 'ERROR'
 'EXECIO' before.0 'DISKW GITWORK REPO A 1 (STEM BEFORE. FINIS'
 if rc\=0 then return 'ERROR'
 return 'OK'

savemap:
 drop sw.
 sw.1='WORK1' mapcount
 at=2
 do si=1 to mapcount
  sw.at='ENTRY' si mapfn.si mapft.si mapfm.si maplf.si
  at=at+1
  sw.at='BASE' si mapbase.si
  at=at+1
  sw.at='STAGE' si mapstage.si
  at=at+1
  sw.at='PATH' si mappath.si
  at=at+1
  sw.at='END' si
  at=at+1
 end
 sw.at='WORKEND' mapcount
 sw.0=at
 'EXECIO' sw.0 'DISKW GITWORK REPO A 1 (STEM SW. FINIS'
 if rc\=0 then do
  say 'GITWT: cannot write worktree map'
  return 'ERROR'
 end
 return 'OK'

findpath:
 parse arg wanted
 do fi=1 to mapcount
  if mappath.fi=wanted then return fi
 end
 return 0

findfile:
 parse arg wfn,wft,wfm
 do fi=1 to mapcount
  if mapfn.fi=wfn & mapft.fi=wft & mapfm.fi=wfm then return fi
 end
 return 0

readrefs:
 drop rr. refname. refoid.
 headref=''
 refcount=0
 'EXECIO * DISKR GITREF2 REPO A 1 (STEM RR. FINIS'
 if rc\=0 | rr.0<3 | rr.1\='REF2 1' then return 'ERROR'
 do ri=2 to rr.0
  if word(rr.ri,1)='HEAD' then do
   if words(rr.ri)\=2 | headref\='' then return 'ERROR'
   headref=word(rr.ri,2)
  end
  else if word(rr.ri,1)='REF' then do
   if words(rr.ri)\=3 then return 'ERROR'
   name=word(rr.ri,2)
   roid=translate(word(rr.ri,3))
   call validref name
   if result\='OK' then return 'ERROR'
   if length(roid)\=40 |,
      verify(roid,'0123456789ABCDEF')\=0 then return 'ERROR'
   refcount=refcount+1
   refname.refcount=name
   refoid.refcount=roid
  end
  else return 'ERROR'
 end
 if left(headref,11)\='refs/heads/' then return 'ERROR'
 call validref headref
 if result\='OK' then return 'ERROR'
 return 'OK'

validref:
 parse arg vr
 if length(vr)>35 then return 'ERROR'
 if left(vr,11)='refs/heads/' then do
  name=substr(vr,12)
  refchars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
  refchars=refchars||'0123456789._/-'
  if name='' | verify(name,refchars)\=0 |,
     pos('//',name)>0 | pos('..',name)>0 |,
     left(name,1)='/' | right(name,1)='/' then return 'ERROR'
  do vi=1 to words(translate(name,' ','/'))
   part=word(translate(name,' ','/'),vi)
   if part='' | part='.' | part='..' | left(part,1)='.' |,
      right(part,1)='.' | right(part,5)='.lock' then return 'ERROR'
  end
  return 'OK'
 end
 else if left(vr,10)='refs/tags/' then name=substr(vr,11)
 else return 'ERROR'
 refchars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
 refchars=refchars||'0123456789._/-'
 if name='' | verify(name,refchars)\=0 | pos('//',name)>0 |,
    pos('..',name)>0 | left(name,1)='/' | right(name,1)='/' |,
    right(name,1)='.' | right(name,5)='.lock' then return 'ERROR'
 do vi=1 to words(translate(name,' ','/'))
  part=word(translate(name,' ','/'),vi)
  if left(part,1)='.' | right(part,1)='.' |,
     right(part,5)='.lock' then return 'ERROR'
 end
 return 'OK'

resolve:
 parse arg wanted
 direct=translate(wanted)
 if length(direct)=40 &,
    verify(direct,'0123456789ABCDEF')=0 then return direct
 if translate(wanted)='HEAD' then wanted=headref
 else if left(wanted,11)\='refs/heads/' then,
  wanted='refs/heads/'||wanted
 do ri=1 to refcount
  if refname.ri=wanted then return refoid.ri
 end
 say 'GITWT: ref not found' wanted
 return 'ERROR'

bindnative:
 'FILEDEF SEL0 DISK M15SL0 PTR A'
 if rc\=0 then return 'ERROR'
 'FILEDEF SEL1 DISK M15SL1 PTR A'
 if rc\=0 then return 'ERROR'
 do bi=1 to 4
  typ=word('STAGE INDEX SEEK GEN',bi)
  dd=word('C0STG C0IDX C0SEEK C0GEN',bi)
  'FILEDEF' dd 'DISK GITFIX' typ 'A'
  if rc\=0 then return 'ERROR'
  dd=word('C1STG C1IDX C1SEEK C1GEN',bi)
  'FILEDEF' dd 'DISK M15NEW' typ 'A'
  if rc\=0 then return 'ERROR'
 end
 return 'OK'

validid:
 parse upper arg id
 if id='' | length(id)>8 then return 'ERROR'
 if verify(id,'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789')\=0 then,
  return 'ERROR'
 return 'OK'

validmode:
 parse upper arg mode
 if length(mode)\=1 then return 'ERROR'
 if verify(mode,'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789')\=0 then,
  return 'ERROR'
 return 'OK'

validtext:
 parse arg vh
 if length(vh)//2\=0 then return 'ERROR'
 do vi=1 to length(vh) by 2
  vb=x2d(substr(vh,vi,2))
  if vb\=9 & (vb<32 | vb>126) then return 'ERROR'
 end
 return 'OK'

bytepos:
 parse arg needle,hex
 needle=translate(needle)
 do bp=1 to length(hex)-1 by 2
  if translate(substr(hex,bp,2))=needle then return bp
 end
 return 0

toasciihex:
 parse arg text
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 return c2x(translate(text,tab,bytes))

asciitocms:
 parse arg ah
 if length(ah)//2\=0 then return 'ERROR'
 ah=translate(ah)
 do ai=1 to length(ah)
  if pos(substr(ah,ai,1),'0123456789ABCDEF')=0 then return 'ERROR'
 end
 ascii=x2c(ah)
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 cms=translate(ascii,bytes,tab)
 call toasciihex cms
 if translate(result)\=translate(ah) then return 'ERROR'
 return cms

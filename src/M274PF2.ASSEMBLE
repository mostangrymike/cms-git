GITPFS   CSECT
         ENTRY GITPFS
* M274 L5: CMS file-state and create-only record writer for GCCCMS.
* C ABI: gitpfs(unsigned long *api); R1 points to the C argument list,
* whose first word points to api.  api[0]=operation, api[1]=file ID,
* api[2]=80-byte records, api[3]=record count.  File ID is 3CL8.
* Operation 0 returns the FSSTATE code.  Operation 1 uses NEW only.
         LR    0,12
         BALR  12,0
         USING *,12
         ST    0,SAV12
         ST    14,SAV14
         L     1,0(1)
         L     5,0(1)
         C     5,=F'0'
         BE    DOSTATE
         C     5,=F'1'
         BNE   BADOP
         L     2,4(1)
         L     3,8(1)
         L     4,12(1)
         ST    2,FILEPTR
         ST    3,RECPTR
         ST    4,REMAIN
         XC    OUTFSCB(FSCBLNBY),OUTFSCB
         LA    5,OUTREC
         FSOPEN (2),FSCB=OUTFSCB,OPENTYP=NEW,RECFM=V,BUFFER=(5),       X
               BSIZE=80,FORM=E,ERROR=OPENERR
WRITELOP L     4,REMAIN
         LTR   4,4
         BZ    WRITEDON
         L     3,RECPTR
         LA    5,80
         FSWRITE FSCB=OUTFSCB,BUFFER=(3),BSIZE=(5),RECFM=V,            X
               FORM=E,ERROR=WRITEERR
         L     3,RECPTR
         LA    3,80(3)
         ST    3,RECPTR
         L     4,REMAIN
         BCTR  4,0
         ST    4,REMAIN
         B     WRITELOP
WRITEDON FSCLOSE FSCB=OUTFSCB,ERROR=CLOSEERR
         SR    15,15
         B     RETURN
WRITEERR ST    15,WRITERC
         FSCLOSE FSCB=OUTFSCB,ERROR=CLOSEERR
         L     15,WRITERC
         B     RETURN
OPENERR  B     RETURN
DOSTATE  L     2,4(1)
         FSSTATE (2),FORM=E
         B     RETURN
BADOP    LA    15,4
         B     RETURN
CLOSEERR LA    15,12
RETURN   L     14,SAV14
         L     12,SAV12
         BR    14
         LTORG
SAV12    DS    F
SAV14    DS    F
FILEPTR  DS    F
RECPTR   DS    F
REMAIN   DS    F
WRITERC  DS    F
OUTFSCB  FSCB  FORM=E
OUTREC   DS    CL80
         FSCBD
         END   GITPFS

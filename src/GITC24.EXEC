/* M204: one-index batch control; authenticated objects only. */
address cms
parse upper arg fm mode max objects
if fm\='G' | (mode\='CHECK' & mode\='RUN') then exit 4
if datatype(max,'W')\=1 then exit 4
if max<1 | max>64 then exit 4
count=words(objects)
if count<2 | count>8 then exit 4
drop obj.
do i=1 to count
 obj.i=word(objects,i)
 if datatype(obj.i,'W')\=1 then exit 4
 if obj.i<1 | obj.i>7736 then exit 4
 do j=1 to i-1
  if obj.i=obj.j then exit 4
 end
end
'STATE M173NET STAGE G'
if rc\=0 then exit 8
'STATE M174NET INDEX G'
if rc\=0 then exit 8
'STATE GITP24M MODULE A'
if rc\=0 then exit 8
'STATE GITB9 EXEC A'
if rc\=0 then exit 8
'STATE GITBX9 MODULE A'
if rc\=0 then exit 8
'STATE GITVO7M MODULE A'
if rc\=0 then exit 8
'STATE GITCLN EXEC A'
if rc\=0 then exit 8
'STATE GITVRAW DATA A'
if rc\=28 then exit 8
'STATE GITR199 DATA A'
if rc\=28 then exit 8
drop f.
f.0=0
'PIPE CMS FILEDEF | STEM f.'
if rc\=0 then exit 8
do i=1 to f.0
 name=word(translate(f.i),1)
 if name='IDXIN' | name='OBJIN' then exit 8
end
'FILEDEF IDXIN DISK M174NET INDEX G'
if rc\=0 then exit 8
drop plan.
plan.0=0
'PIPE CMS GITP24M BATCH 3864799' max objects '| STEM plan.'
readrc=rc
'FILEDEF IDXIN CLEAR'
clearrc=rc
if readrc\=0 | clearrc\=0 | plan.0\=count then do
 say 'M204 INDEX PLAN CAPTURE FAIL' readrc clearrc plan.0
 exit 8
end
drop span.
do i=1 to count
 parse upper var plan.i tag n hdr cnt typ size oid extra
 if tag\='P201' | extra\='' then exit 8
 if datatype(n,'W')\=1 | datatype(hdr,'W')\=1 then exit 8
 if datatype(cnt,'W')\=1 | datatype(typ,'W')\=1 then exit 8
 if datatype(size,'W')\=1 then exit 8
 if n\=obj.i | hdr<1 | hdr>3864799 then exit 8
 if cnt<1 | cnt>max | hdr+cnt>3864799 then exit 8
 if typ<1 | typ>4 | size<1 | size>2048 then exit 8
 if cnt\=trunc((size+31)/32) then exit 8
 if length(oid)\=40 then exit 8
 if verify(oid,'0123456789ABCDEF')\=0 then exit 8
 span.i=n hdr cnt oid
 say 'M204 INDEX TUPLE VERIFIED' i n hdr cnt typ size
 say 'M204 EXPECTED OID' i oid
end
say 'M204 INDEX ONCE ALL PLANS PASS' count
if mode='CHECK' then do
 say 'M204 CHECK ONLY NO SCRATCH PASS' count
 exit 0
end
do i=1 to count
 'STATE GITR199 DATA A'
 if rc\=28 then exit 8
 'GITB9 G' span.i
 authrc=rc
 if authrc\=0 then do
  say 'M204 SHA FAILED SCRATCH PRESERVED' i obj.i
  exit 8
 end
 say 'M204 FULL SHA VERIFIED' i obj.i
 'GITCLN SCRATCH'
 cleanrc=rc
 if cleanrc\=0 then exit 8
 'STATE GITR199 DATA A'
 if rc\=28 then exit 8
 say 'M204 SCRATCH CLEAN VERIFIED' i obj.i
end
say 'M204 ONE INDEX FULL SHA CLEAN PASS' count
exit 0

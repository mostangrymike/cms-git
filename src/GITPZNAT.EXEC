/* M286: guarded PACK inflation dispatch with inline native bridge. */
/* TOOBUF zlib-offset [REXX|NATIVE]. Native requires GITNDRV. */
/* Native bridge must queue consumed bytes then decoded bytes. */
parse upper arg command offset mode extra
if command \= 'TOOBUF' | extra \= '' |,
 datatype(offset,'W') \= 1 | offset < 0 then do
 say 'Usage: GITPZNAT TOOBUF zlib-offset [REXX|NATIVE]'
 exit 4
end
if mode = '' then mode = 'REXX'
if mode \= 'REXX' & mode \= 'NATIVE' then exit 4
address command
if mode = 'REXX' then do
 'EXEC GITPZBUF TOOBUF' offset
 exit rc
end
/* Explicit native mode is fail-closed; never report a false decode. */
'STATE GITNDRV MODULE A'
if rc \= 0 then do
 say 'GITPZNAT: native bridge unavailable; use REXX'
 exit 12
end
/* M286/M288: inline bridge plus its sole-caller staging/publish helpers. */
call stagepack offset 65536
if result \= 0 | queued() < 2 then exit 8
parse pull staged
parse pull records
if staged < 6 | staged > 65536 | records < 1 then exit 8
/* Invalidate prior output so stale driver results cannot pass. */
'ERASE GITNRES DATA A'
'ERASE GITNOUT DATA A'
'GITNDRV'
if rc \= 0 then do
 say 'GITPZNAT: native driver returned' rc
 exit 8
end
drop m.
'EXECIO 1 DISKR GITNRES DATA A 1 (STEM M. FINIS'
if rc \= 0 | m.0 \= 1 then exit 8
parse var m.1 tag status used decoded extra
if tag \= 'RESULT' | extra \= '' |,
 datatype(status,'W') \= 1 | status \= 0 |,
 datatype(used,'W') \= 1 | datatype(decoded,'W') \= 1 then exit 8
if used < 6 | used > staged | decoded < 0 | decoded > 65536 then exit 8
/* Validate bounded driver output before publishing it. */
call commitnative decoded
if result \= 0 | queued() < 1 then exit 8
parse pull committed
if committed \= decoded then exit 8
queue used
queue decoded
exit 0

stagepack: procedure
 parse arg offset limit extra
 if extra \= '' | datatype(offset,'W') \= 1 |,
  datatype(limit,'W') \= 1 then return 4
 if offset < 0 | limit < 6 | limit > 65536 then return 4
 address command
 drop m.
 'EXECIO 1 DISKR GITPMETA PACK A 1 (STEM M. FINIS'
 if rc \= 0 | m.0 \= 1 then return 8
 parse var m.1 tag total tail final extra
 if tag \= 'META' | extra \= '' | final \= 1 |,
  datatype(total,'W') \= 1 then return 8
 if offset >= total then return 8
 if tail \= '-' then do
  if length(tail) >= 128 | length(tail)//2 \= 0 |,
   verify(tail,'0123456789ABCDEF') \= 0 then return 8
 end
 avail = total - offset
 if avail > limit then avail = limit
 'ERASE GITNSTG DATA A'
 'ERASE GITNSMT DATA A'
 nrec = 0
 copied = 0
 /* Read 16 contiguous PACK records per call instead of invoking */
 /* GITPBUF once per 64-byte staging record. Bound RAM to 1024 bytes. */
 do while copied < avail
  sourceoff = offset + copied
  first = sourceoff % 64 + 1
  within = sourceoff // 64
  take = avail - copied
  if take > 1024-within then take = 1024-within
  last = (sourceoff + take - 1) % 64 + 1
  batch = last - first + 1
  drop in.
  'EXECIO' batch 'DISKR GITPBUF PACK A' first,
   '(STEM IN. FINIS'
  if rc \= 0 | in.0 \= batch then return 8
  joined = ''
  do i = 1 to batch
   h = strip(in.i)
   if h = '' | length(h) > 128 | length(h)//2 \= 0 |,
    verify(h,'0123456789ABCDEF') \= 0 then return 8
   if i < batch & length(h) \= 128 then return 8
   joined = joined || h
  end
  if length(joined) < (within+take)*2 then return 8
  joined = substr(joined,within*2+1,take*2)
  drop r.
  r.0 = 0
  j = 1
  do while j <= length(joined)
   r.0 = r.0 + 1
   idx = r.0
   r.idx = substr(joined,j,128)
   j = j + 128
  end
  'EXECIO' r.0 'DISKW GITNSTG DATA A 0 (STEM R. FINIS'
  if rc \= 0 then return 8
  nrec = nrec + r.0
  copied = copied + take
 end
 m.1 = 'META' offset copied nrec
 m.0 = 1
 'EXECIO 1 DISKW GITNSMT DATA A 1 (STEM M. FINIS'
 if rc \= 0 then return 8
 queue copied
 queue nrec
 return 0

commitnative: procedure
 parse arg want extra
 if extra \= '' | datatype(want,'W') \= 1 |,
  want < 0 | want > 65536 then return 4
 address command
 /* Read in batches; reject malformed, short, oversized or extra data. */
 copied = 0
 recno = 1
 do while copied < want
  batch = (want-copied+63)%64
  if batch > 16 then batch = 16
  drop r.
  'EXECIO' batch 'DISKR GITNOUT DATA A' recno,
   '(STEM R. FINIS'
  if rc \= 0 | r.0 < 1 | r.0 > batch then return 8
  do i = 1 to r.0
   h = strip(r.i)
   if h = '' | length(h) > 128 | length(h)//2 \= 0 |,
    verify(h,'0123456789ABCDEF') \= 0 then return 8
   copied = copied + length(h)%2
   if copied > want then return 8
  end
  recno = recno + r.0
 end
 /* Zero-byte native output may have no CMS DATA file at all. */
 /* For nonempty output, reject trailing records before publication. */
 checkextra = 1
 if want = 0 then do
  'STATE GITNOUT DATA A'
  if rc \= 0 then checkextra = 0
 end
 if checkextra then do
  drop r.
  'EXECIO 1 DISKR GITNOUT DATA A' recno '(STEM R. FINIS'
  if rc = 0 & r.0 > 0 then do
   say 'GITNOUT: extra output records'
   return 8
  end
  if rc \= 0 & rc \= 2 then return 8
 end
 /* Preflight complete. Publish in 16-record batches. */
 'ERASE GITOBUF DATA A'
 i = 1
 do while i < recno
  batch = recno - i
  if batch > 16 then batch = 16
  drop r.
  'EXECIO' batch 'DISKR GITNOUT DATA A' i,
   '(STEM R. FINIS'
  if rc \= 0 | r.0 \= batch then return 8
  do j = 1 to batch
   h = strip(r.j)
   if h = '' | length(h) > 128 | length(h)//2 \= 0 |,
    verify(h,'0123456789ABCDEF') \= 0 then return 8
   r.j = h
  end
  'EXECIO' batch 'DISKW GITOBUF DATA A 0 (STEM R. FINIS'
  if rc \= 0 then return 8
  i = i + batch
 end
 m.1 = 'META' want '-' 1
 m.0 = 1
 'EXECIO 1 DISKW GITOMETA DATA A 1 (STEM M. FINIS'
 if rc \= 0 then return 8
 queue copied
 return 0

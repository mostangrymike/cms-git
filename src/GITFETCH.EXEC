/* M169: generalized bounded smart-HTTP upload-pack discovery. */
address cms
parse arg cmd bridge port authority repo branch extra
cmd=translate(cmd)
if cmd\='DISCOVER' | bridge='' | port='' | authority='' |,
   repo='' | branch='' | extra\='' then do
 say 'Usage: GITFETCH DISCOVER bridge port host repo branch'
 exit 4
end
if datatype(port,'W')\=1 | port<1 | port>65535 then exit 4
call safehost authority
if result\='OK' then exit 4
call safepath repo
if result\='OK' then exit 4
call safepath branch
if result\='OK' then exit 4
if left(repo,1)='/' | right(repo,1)='/' | pos('..',repo)>0 then exit 4
if left(branch,1)='/' | right(branch,1)='/' |,
   pos('..',branch)>0 then exit 4
if translate(branch)='HEAD' then target='HEAD'
else if left(branch,11)='refs/heads/' then target=branch
else target='refs/heads/'||branch
if length(target)>255 then exit 4

path='/'||repo||'.git/info/refs?service=git-upload-pack'
if length(path)>512 then exit 4
call toasciihex 'GET '||path||' HTTP/1.1'
wire=result||'0D0A'
call toasciihex 'Host: '||authority
wire=wire||result||'0D0A'
call authheader
authvalue=result
if authvalue='ERROR' then do
 say 'GITFETCH: invalid stored GitHub credential'
 exit 8
end
if authvalue\='' then do
 if translate(authority)\='GITHUB.COM' then do
  say 'GITFETCH: stored GitHub credential is limited to github.com'
  exit 8
 end
 call toasciihex authvalue
 if result='ERROR' then exit 8
 wire=wire||result||'0D0A'
end
call toasciihex 'Accept: application/x-git-upload-pack-advertisement'
wire=wire||result||'0D0A'
call toasciihex 'Connection: close'
wire=wire||result||'0D0A0D0A'
raw=x2c(wire)

s=''
r=Socket('Initialize','GITFETCH')
parse var r src rest
if src\=0 then do
 say 'GITFETCH: socket initialize failed RC' src
 exit 8
end
if verify(bridge,'0123456789.')=0 then ip=bridge
else do
 r=Socket('GetHostByName',bridge)
 parse var r src addrs
 if src\=0 then do
  fail='RESOLVE-RC'
  call bad
 end
 ip=word(addrs,1)
 if ip='' then do
  fail='RESOLVE-EMPTY'
  call bad
 end
end
r=Socket('Socket')
parse var r src s
if src\=0 then do
 fail='SOCKET-CREATE'
 call bad
end
r=Socket('GetSockOpt',s,'SOL_SOCKET','SO_ASCII')
parse var r src opt
if src\=0 | translate(opt)\='OFF' then do
 fail='SO-ASCII'
 call bad
end
r=Socket('Connect',s,'AF_INET' port ip)
parse var r src rest
if src\=0 then do
 say 'GITFETCH: connect target' ip port
 say 'GITFETCH: connect RC' src rest
 fail='CONNECT'
 call bad
end
r=Socket('Send',s,raw)
parse var r src sent
if src\=0 | sent\=length(raw) then do
 fail='SEND'
 call bad
end

hstate='HEAD'
header=''
cstate='SIZE'
cline=''
cneed=0
ccrlf=''
chunkdone=0
pstate='HDR'
phdr=''
pneed=0
ppay=''
pstage='SERVICE'
service=0
pktdone=0
refs=0
targetcount=0
targetoid=''
capseen=0
capsb=0
capofs=0
symrefcount=0
headref=''
total=0

do forever
 r=Socket('Recv',s,256)
 parse var r src got data
 if src\=0 then do
  fail='RECV'
  call bad
 end
 if got=0 then leave
 if got>256 | length(data)\=got then do
  fail='RECV-LENGTH'
  call bad
 end
 total=total+got
 if total>4194304 then do
  fail='RESPONSE-LIMIT'
  call bad
 end
 call httpfeed c2x(data)
 if result\='OK' then do
  fail='HTTP-PARSE'
  call bad
 end
end
r=Socket('Close',s)
s=''
if hstate\='BODY' | chunkdone\=1 | pktdone\=1 then do
 fail='FINAL-FRAMING'
 call bad
end
if service\=1 | targetcount\=1 | capseen\=1 then do
 fail='FINAL-ADVERTISEMENT'
 call bad
end
if capsb\=1 | capofs\=1 then do
 fail='FINAL-CAPABILITIES'
 call bad
end
symrefvalid=0
if symrefcount=1 then do
 if headref='' then do
  fail='DEFAULT-BRANCH-SYMREF'
  call bad
 end
 headcount=0
 branchcount=0
 headoid=''
 branchoid=''
 do ri=1 to refs
  if advname.ri='HEAD' then do
   headcount=headcount+1
   headoid=advoid.ri
  end
  if advname.ri=headref then do
   branchcount=branchcount+1
   branchoid=advoid.ri
  end
 end
 if headcount\=1 | branchcount\=1 | headoid\=branchoid then do
  fail='DEFAULT-BRANCH-OID'
  call bad
 end
 symrefvalid=1
end
if target='HEAD' & symrefvalid\=1 then do
 fail='DEFAULT-BRANCH-SYMREF'
 call bad
end
r=Socket('Terminate')
say 'FETCH OID' targetoid
say 'FETCH DISCOVERED' targetoid target
if symrefvalid=1 then say 'FETCH DEFAULT BRANCH' headref
say 'FETCH CAPABILITY SIDE-BAND-64K'
say 'FETCH CAPABILITY OFS-DELTA'
say 'FETCH ADVERTISEMENT REFS' refs
say 'FETCH HTTP BYTES' total
say 'M169 FETCH DISCOVERY PASS'
exit 0

bad:
 say 'GITFETCH: discovery failed at' fail
 if symbol('hstate')='VAR' then,
  say 'GITFETCH: states' hstate cstate pstate pstage
 if symbol('service')='VAR' then,
  say 'GITFETCH: counts' service targetcount capseen refs total
 if s\='' then r=Socket('Close',s)
 r=Socket('Terminate')
 exit 8

httpfeed:
 parse arg hx
 hx=translate(hx)
 if hstate='HEAD' then do
  header=header||hx
  if length(header)>32768 then return 'ERROR'
  hp=pos('0D0A0D0A',header)
  if hp=0 then return 'OK'
  body=substr(header,hp+8)
  hpart=left(header,hp+7)
  call checkhdr hpart
  if result\='OK' then return 'ERROR'
  hstate='BODY'
  header=''
  if body\='' then do
   call chunkfeed body
   if result\='OK' then return 'ERROR'
  end
  return 'OK'
 end
 if hstate\='BODY' then return 'ERROR'
 call chunkfeed hx
 return result

checkhdr:
 parse arg hh
 if left(hh,24)\='485454502F312E3120323030' &,
    left(hh,24)\='485454502F312E3020323030' then return 'ERROR'
 call asciitocms hh
 ht=result
 if ht='ERROR' then return 'ERROR'
 hu=translate(ht)
 if pos('CONTENT-TYPE:',hu)=0 then return 'ERROR'
 if pos('APPLICATION/X-GIT-UPLOAD-PACK-ADVERTISEMENT',hu)=0 then,
  return 'ERROR'
 if pos('TRANSFER-ENCODING:',hu)=0 | pos('CHUNKED',hu)=0 then,
  return 'ERROR'
 return 'OK'

chunkfeed:
 parse arg cwork
 cwork=translate(cwork)
 do while cwork\=''
  if cstate='SIZE' then do
   cb=left(cwork,2)
   cwork=substr(cwork,3)
   cline=cline||cb
   if length(cline)>128 then return 'ERROR'
   if right(cline,4)='0D0A' then do
    ch=left(cline,length(cline)-4)
    cline=''
    ep=bytepos('3B',ch)
    if ep>0 then ch=left(ch,ep-1)
    if ch='' | length(ch)//2\=0 | length(ch)>16 then,
       return 'ERROR'
    cneed=0
    do cj=1 to length(ch) by 2
     cv=x2d(substr(ch,cj,2))
     if cv>=48 & cv<=57 then cn=cv-48
     else if cv>=65 & cv<=70 then cn=cv-55
     else if cv>=97 & cv<=102 then cn=cv-87
     else return 'ERROR'
     cneed=cneed*16+cn
    end
    if cneed>1048576 then return 'ERROR'
    if cneed=0 then do
     cstate='DONE'
     chunkdone=1
     cwork=''
    end
    else cstate='DATA'
   end
  end
  else if cstate='DATA' then do
   cavail=length(cwork)%2
   ctake=cneed
   if ctake>cavail then ctake=cavail
   if ctake=0 then return 'OK'
   cpiece=left(cwork,ctake*2)
   cwork=substr(cwork,ctake*2+1)
   call pktfeed cpiece
   if result\='OK' then return 'ERROR'
   cneed=cneed-ctake
   if cneed=0 then do
    cstate='CRLF'
    ccrlf=''
   end
  end
  else if cstate='CRLF' then do
   ctake=4-length(ccrlf)
   if ctake>length(cwork) then ctake=length(cwork)
   ccrlf=ccrlf||left(cwork,ctake)
   cwork=substr(cwork,ctake+1)
   if length(ccrlf)=4 then do
    if ccrlf\='0D0A' then return 'ERROR'
    ccrlf=''
    cstate='SIZE'
   end
  end
  else if cstate='DONE' then cwork=''
  else return 'ERROR'
 end
 return 'OK'

pktfeed:
 parse arg pwork
 pwork=translate(pwork)
 do while pwork\=''
  if pstate='HDR' then do
   ptake=8-length(phdr)
   if ptake>length(pwork) then ptake=length(pwork)
   phdr=phdr||left(pwork,ptake)
   pwork=substr(pwork,ptake+1)
   if length(phdr)<8 then iterate
   call pktlen phdr
   pn=result
   if pn='ERROR' then do
    say 'GITFETCH: bad pkt hdr' phdr 'REFS' refs 'CNEED' cneed
    return 'ERROR'
   end
   if pn=0 then do
    phdr=''
    if pstage='EXPECT' then pstage='REFS'
    else if pstage='REFS' then do
     pstage='DONE'
     pktdone=1
     if pwork\='' then do
      say 'GITFETCH: post-flush bytes' length(pwork)%2,
          left(pwork,64)
      return 'ERROR'
     end
    end
    else return 'ERROR'
    iterate
   end
   if pn=1 | pn=2 | pn<4 then do
    say 'GITFETCH: bad pkt len' pn phdr 'REFS' refs 'CNEED' cneed
    return 'ERROR'
   end
   phdr=''
   pneed=pn-4
   if pneed<1 | pneed>4096 then do
    say 'GITFETCH: pkt payload bound' pneed 'REFS' refs 'CNEED' cneed
    return 'ERROR'
   end
   ppay=''
   pstate='PAY'
  end
  else if pstate='PAY' then do
   pavail=length(pwork)%2
   ptake=pneed
   if ptake>pavail then ptake=pavail
   if ptake=0 then return 'OK'
   ppay=ppay||left(pwork,ptake*2)
   if length(ppay)>8192 then return 'ERROR'
   pwork=substr(pwork,ptake*2+1)
   pneed=pneed-ptake
   if pneed=0 then do
    call processpkt
    if result\='OK' then return 'ERROR'
    ppay=''
    pstate='HDR'
   end
  end
  else return 'ERROR'
 end
 return 'OK'

processpkt:
 if pstage='SERVICE' then do
  want='2320736572766963653D6769742D75706C6F61642D7061636B0A'
  if ppay\=want then return 'ERROR'
  service=1
  pstage='EXPECT'
  return 'OK'
 end
 if pstage\='REFS' then return 'ERROR'
 nul=bytepos('00',ppay)
 if nul>0 then do
  mainhex=left(ppay,nul-1)
  caphex=substr(ppay,nul+2)
 end
 else do
  mainhex=ppay
  caphex=''
 end
 if right(mainhex,2)='0A' then,
  mainhex=left(mainhex,length(mainhex)-2)
 if caphex\='' & right(caphex,2)='0A' then,
  caphex=left(caphex,length(caphex)-2)
 call asciitocms mainhex
 line=result
 if line='ERROR' then return 'ERROR'
 parse var line oid ref extra
 oid=translate(oid)
 if extra\='' | length(oid)\=40 |,
    verify(oid,'0123456789ABCDEF')\=0 then return 'ERROR'
 if ref\='HEAD' & left(ref,5)\='refs/' then return 'ERROR'
 refs=refs+1
 if refs>10000 then return 'ERROR'
advname.refs=ref
advoid.refs=oid
 if caphex\='' then do
  capseen=capseen+1
  if capseen>1 then return 'ERROR'
  call asciitocms caphex
  caps=result
  if caps='ERROR' then return 'ERROR'
  cu=' '||translate(caps)||' '
  if pos(' SIDE-BAND-64K ',cu)>0 then capsb=1
  if pos(' OFS-DELTA ',cu)>0 then capofs=1
  do capi=1 to words(caps)
   capword=word(caps,capi)
   if left(capword,12)='symref=HEAD:' then do
    symrefcount=symrefcount+1
    if symrefcount>1 then return 'ERROR'
    headref=substr(capword,13)
    if left(headref,11)\='refs/heads/' then return 'ERROR'
    branchname=substr(headref,12)
    call safepath branchname
    if result\='OK' | branchname='' | pos('..',branchname)>0 |,
       left(branchname,1)='/' | right(branchname,1)='/' then return 'ERROR'
   end
  end
 end
 if ref=target then do
  targetcount=targetcount+1
  targetoid=oid
 end
 return 'OK'

pktlen: procedure
 parse arg h
 if length(h)\=8 then return 'ERROR'
 n=0
 do i=1 to 4
  b=x2d(substr(h,i*2-1,2))
  if b>=48 & b<=57 then v=b-48
  else if b>=65 & b<=70 then v=b-55
  else if b>=97 & b<=102 then v=b-87
  else return 'ERROR'
  n=n*16+v
 end
 return n

bytepos: procedure
 parse arg needle,hex
 do bp=1 to length(hex)-1 by 2
  if substr(hex,bp,2)=needle then return bp
 end
 return 0

authheader: procedure
 address cms
 tokenalphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
 tokenalphabet=tokenalphabet||'0123456789_-'
 'STATE GHCRED REPO A'
 if rc=28 then return ''
 if rc\=0 then return 'ERROR'
 drop cred.
 'EXECIO * DISKR GHCRED REPO A 1 (STEM CRED. FINIS'
 if rc\=0 | cred.0<4 then return 'ERROR'
 if cred.1='GHCRED 1' then do
  authmode='APIKEY'
  userrec=2
  lenrec=3
  firstsecret=4
  lenlabel='TOKEN-LENGTH'
  chunkprefix='TOKEN'
 end
 else if cred.1='GHCRED 2' then do
  if words(cred.2)\=2 | word(cred.2,1)\='MODE' then,
   return 'ERROR'
  authmode=word(cred.2,2)
  if authmode\='APIKEY' & authmode\='USERPASS' then,
   return 'ERROR'
  userrec=3
  lenrec=4
  firstsecret=5
  lenlabel='SECRET-LENGTH'
  chunkprefix='SECRET'
 end
 else return 'ERROR'
 if words(cred.userrec)\=2 | word(cred.userrec,1)\='USER' then,
  return 'ERROR'
 authuser=word(cred.userrec,2)
 if authuser='' | length(authuser)>39 |,
    verify(translate(authuser),'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-')\=0 then,
  return 'ERROR'
 if words(cred.lenrec)\=2 | word(cred.lenrec,1)\=lenlabel then,
  return 'ERROR'
 tokenlength=word(cred.lenrec,2)
 if datatype(tokenlength,'W')\=1 | tokenlength<1 | tokenlength>240 then,
  return 'ERROR'
 chunks=(tokenlength+63)%64
 if cred.0\=firstsecret+chunks-1 then return 'ERROR'
 authtoken=''
 do authi=1 to chunks
  rec=firstsecret+authi-1
  parse var cred.rec authlabel authpart
  authpart=strip(authpart)
  if authi=1 then expected=chunkprefix
  else expected=chunkprefix||'+'||(authi-1)
  wantlen=tokenlength-((authi-1)*64)
  if wantlen>64 then wantlen=64
  if words(cred.rec)\=2 | authlabel\=expected |,
     length(authpart)\=wantlen | verify(authpart,tokenalphabet)\=0 then,
   return 'ERROR'
  authtoken=authtoken||authpart
 end
 if length(authtoken)\=tokenlength then return 'ERROR'
 call toasciihex authuser||':'||authtoken
 authbytes=result
 if authbytes='ERROR' | length(authbytes)//2\=0 then return 'ERROR'
 alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
 alphabet=alphabet||'0123456789+/'
 auth64=''
 do authi=1 to length(authbytes) by 6
  remain=length(authbytes)-authi+1
  if remain<2 then return 'ERROR'
  b1=x2d(substr(authbytes,authi,2))
  b2=0
  b3=0
  if remain>=4 then b2=x2d(substr(authbytes,authi+2,2))
  if remain>=6 then b3=x2d(substr(authbytes,authi+4,2))
  six1=b1%4
  six2=(b1//4)*16+b2%16
  six3=(b2//16)*4+b3%64
  six4=b3//64
  auth64=auth64||substr(alphabet,six1+1,1)||,
         substr(alphabet,six2+1,1)
  if remain>=4 then auth64=auth64||substr(alphabet,six3+1,1)
  else auth64=auth64||'='
  if remain>=6 then auth64=auth64||substr(alphabet,six4+1,1)
  else auth64=auth64||'='
 end
 return 'Authorization: Basic '||auth64

safehost: procedure
 parse arg text
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-'
 if text='' | length(text)>255 | verify(text,allowed)\=0 then,
  return 'ERROR'
 return 'OK'

safepath: procedure
 parse arg text
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-/'
 if text='' | length(text)>255 | verify(text,allowed)\=0 then,
  return 'ERROR'
 return 'OK'

toasciihex: procedure
 parse arg text
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 return c2x(translate(text,tab,bytes))

asciitocms: procedure
 parse arg ah
 if ah='' then return ''
 if length(ah)//2\=0 then return 'ERROR'
 ah=translate(ah)
 do ai=1 to length(ah)
  if pos(substr(ah,ai,1),'0123456789ABCDEF')=0 then return 'ERROR'
 end
 ascii=x2c(ah)
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 if length(e2a)\=512 then return 'ERROR'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 return translate(ascii,bytes,tab)

/* M194: read only header+first hex record via native CMS FSREAD. */
address cms
parse upper arg datafm which extra
if datafm\='G' | extra\='' then do
 say 'Usage: GITFRP G FIRST|MID|LAST'
 exit 4
end
if which\='FIRST' & which\='MID' & which\='LAST' then do
 say 'M194 INVALID PROBE'
 exit 4
end
drop d.
d.0=0
'PIPE CMS QUERY DISK G | STEM d.'
if rc\=0 then exit 8
ok=0
do i=1 to d.0
 if word(d.i,3)='G' & word(d.i,7)='4096' then ok=ok+1
end
if ok\=1 then do
 say 'M194 G DISK NOT ACCESSED 4K'
 exit 8
end
'STATE M173NET STAGE G'
if rc\=0 then exit 8
'STATE M174NET INDEX G'
if rc\=0 then exit 8
'STATE GITFRB MODULE A'
if rc\=0 then do
 say 'M194 MODULE MISSING'
 exit 8
end
say 'M194 DIRECT BODY PROBE BEGIN' which
queue which
'GITFRB'
workrc=rc
if workrc\=0 then do
 say 'M194 BODY PROBE GATE FAIL RC' workrc
 exit 8
end
say 'M194 BODY PROBE GATE PASS G' which
exit 0

/* M205: stratified index sample, full SHA with exact cleanup. */
address cms
parse upper arg fm mode max requested extra
if fm\='G' | (mode\='CHECK' & mode\='RUN') then exit 4
if extra\='' then exit 4
if datatype(max,'W')\=1 then exit 4
if datatype(requested,'W')\=1 then exit 4
if max<1 | max>64 then exit 4
count=requested
if count<2 | count>8 then exit 4
drop d.
d.0=0
'PIPE CMS QUERY DISK G | STEM d.'
if rc\=0 then exit 8
ok=0
do i=1 to d.0
 if word(d.i,3)='G' & word(d.i,7)='4096' then ok=ok+1
end
if ok\=1 then exit 8
'STATE M173NET STAGE G'
if rc\=0 then exit 8
'STATE M174NET INDEX G'
if rc\=0 then exit 8
'STATE GITP25M MODULE A'
if rc\=0 then exit 8
'STATE GITB9 EXEC A'
if rc\=0 then exit 8
'STATE GITBX9 MODULE A'
if rc\=0 then exit 8
'STATE GITVO7M MODULE A'
if rc\=0 then exit 8
'STATE GITCLN EXEC A'
if rc\=0 then exit 8
'STATE GITVRAW DATA A'
if rc\=28 then exit 8
'STATE GITR199 DATA A'
if rc\=28 then exit 8
drop f.
f.0=0
'PIPE CMS FILEDEF | STEM f.'
if rc\=0 then exit 8
do i=1 to f.0
 name=word(translate(f.i),1)
 if name='IDXIN' | name='OBJIN' then exit 8
end
'FILEDEF IDXIN DISK M174NET INDEX G'
if rc\=0 then exit 8
drop plan.
plan.0=0
'PIPE CMS GITP25M SAMPLE 3864799' max count '| STEM plan.'
readrc=rc
'FILEDEF IDXIN CLEAR'
clearrc=rc
if readrc\=0 | clearrc\=0 | plan.0\=count then do
 say 'M205 INDEX PLAN CAPTURE FAIL' readrc clearrc plan.0
 exit 8
end
drop span.
do i=1 to count
 parse upper var plan.i tag n hdr cnt typ size oid extra
 if tag\='P201' | extra\='' then exit 8
 if datatype(n,'W')\=1 | datatype(hdr,'W')\=1 then exit 8
 if datatype(cnt,'W')\=1 | datatype(typ,'W')\=1 then exit 8
 if datatype(size,'W')\=1 then exit 8
 low=trunc((i-1)*7736/count)+1
 high=trunc(i*7736/count)
 if n<low | n>high | hdr<1 | hdr>3864799 then exit 8
 if cnt<1 | cnt>max | hdr+cnt>3864799 then exit 8
 if typ<1 | typ>4 | size<1 | size>2048 then exit 8
 if cnt\=trunc((size+31)/32) then exit 8
 if length(oid)\=40 then exit 8
 if verify(oid,'0123456789ABCDEF')\=0 then exit 8
 span.i=n hdr cnt oid
 say 'M205 BAND OBJECT VERIFIED' i n hdr cnt typ size
 say 'M205 EXPECTED OID' i oid
end
'STATE GITR199 DATA A'
if rc\=28 then exit 8
say 'M205 STRATIFIED INDEX PLANS PASS' count
if mode='CHECK' then do
 say 'M205 SAMPLE CHECK NO SCRATCH PASS' count
 exit 0
end
do i=1 to count
 'STATE GITR199 DATA A'
 if rc\=28 then exit 8
 'GITB9 G' span.i
 authrc=rc
 if authrc\=0 then do
  say 'M205 SHA FAILED SCRATCH PRESERVED' i word(span.i,1)
  exit 8
 end
 say 'M205 FULL SHA VERIFIED' i word(span.i,1)
 'GITCLN SCRATCH'
 cleanrc=rc
 if cleanrc\=0 then exit 8
 'STATE GITR199 DATA A'
 if rc\=28 then exit 8
 say 'M205 SCRATCH CLEAN VERIFIED' i word(span.i,1)
end
say 'M205 STRATIFIED FULL SHA CLEAN PASS' count
exit 0

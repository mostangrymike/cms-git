/* M265: CMS-resident GitHub token and Basic credential handling. */
address cms
tokenalphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
tokenalphabet=tokenalphabet||'0123456789_-'
parse upper arg action .
parse arg action rest
action=translate(strip(action))

if action='STATUS' then do
 if strip(rest)\='' then exit 4
 call readcredential
 if result\='OK' then exit 8
 if present=0 then do
  say 'No GitHub credential stored'
  exit 0
 end
 if storedmode='APIKEY' then modeout='API key'
 else modeout='username/password credential'
 say 'GitHub' modeout 'stored for' storeduser
 exit 0
end

if action='REMOVE' then do
 if strip(rest)\='' then do
  say 'Usage: GIT CREDENTIAL REMOVE'
  exit 4
 end
 'STATE GHCRED REPO G'
 if rc=28 then do
  say 'No GitHub credential stored'
  exit 0
 end
 if rc\=0 then exit 8
 'ERASE GHCRED REPO G'
 if rc\=0 then do
  say 'GITCRED: cannot remove credential file'
  exit 8
 end
 say 'Removed stored GitHub credential'
 exit 0
end

if action='IMPORT' then do
 parse var rest username extra
 if username='' | extra\='' then do
  say 'Usage: GIT CREDENTIAL IMPORT github-user'
  exit 4
 end
 call validuser username
 if result\='OK' then do
  say 'GITCRED: invalid GitHub user name'
  exit 4
 end
 'STATE GHTOKEN REPO G'
 if rc\=0 then do
  say 'GITCRED: create GHTOKEN REPO G with one TOKEN record first'
  exit 8
 end
 drop input.
 'EXECIO * DISKR GHTOKEN REPO G 1 (STEM INPUT. FINIS'
 if rc\=0 | input.0\=1 then do
  say 'GITCRED: token input must contain exactly one record'
  exit 8
 end
 parse var input.1 label secret
 secret=strip(secret)
 if (translate(label)\='TOKEN' & translate(label)\='APIKEY') |,
    secret='' then do
  say 'GITCRED: input record must begin TOKEN or APIKEY'
  exit 8
 end
 call validsecret secret
 if result\='OK' then do
  say 'GITCRED: API key has invalid characters or length'
  exit 8
 end
 credentialmode='APIKEY'
 call storecredential
 if result\='OK' then do
  say 'GITCRED: could not store API key'
  exit 8
 end
 'ERASE GHTOKEN REPO G'
 if rc\=0 then do
  say 'GITCRED: stored credential; temporary input remains'
  exit 8
 end
 say 'Stored GitHub API key for' username
 exit 0
end

if action='IMPORT-USERPASS' then do
 if strip(rest)\='' then do
  say 'Usage: GIT CREDENTIAL IMPORT-USERPASS'
  exit 4
 end
 'STATE GHPASS REPO G'
 if rc\=0 then do
  say 'GITCRED: create GHPASS REPO G with USER and PASSWORD records'
  exit 8
 end
 drop input.
 'EXECIO * DISKR GHPASS REPO G 1 (STEM INPUT. FINIS'
 if rc\=0 | input.0\=2 then do
  say 'GITCRED: input must contain exactly two records'
  exit 8
 end
 parse var input.1 userlabel username
 parse var input.2 passlabel secret
 username=strip(username)
 secret=strip(secret)
 if words(input.1)\=2 | translate(userlabel)\='USER' |,
    words(input.2)\=2 | translate(passlabel)\='PASSWORD' then do
  say 'GITCRED: expected USER name and PASSWORD token records'
  exit 8
 end
 call validuser username
 if result\='OK' then do
  say 'GITCRED: invalid GitHub user name'
  exit 4
 end
 call validsecret secret
 if result\='OK' then do
  say 'GITCRED: password field must contain a GitHub token'
  exit 8
 end
 credentialmode='USERPASS'
 call storecredential
 if result\='OK' then do
  say 'GITCRED: could not store username/password credential'
  exit 8
 end
 'ERASE GHPASS REPO G'
 if rc\=0 then do
  say 'GITCRED: stored credential; temporary input remains'
  exit 8
 end
 say 'Stored GitHub username/password credential for' username
 exit 0
end

say 'Usage: GIT CREDENTIAL STATUS | IMPORT user | IMPORT-USERPASS'
say '       GIT CREDENTIAL REMOVE'
exit 4

storecredential:
 'STATE GHCRED REPO G'
 if rc=0 then do
  say 'GITCRED: remove the existing credential before replacing it'
  return 'ERROR'
 end
 if rc\=28 then return 'ERROR'
 drop output.
 output.1='GHCRED 2'
 output.2='MODE' credentialmode
 output.3='USER' username
 output.4='SECRET-LENGTH' length(secret)
 n=4
 pos=1
 part=0
 do while pos<=length(secret)
  part=part+1
  n=n+1
  if part=1 then label='SECRET'
  else label='SECRET+' part
  output.n=label substr(secret,pos,64)
  pos=pos+64
 end
 output.0=n
 'EXECIO' output.0 'DISKW GHCRED REPO G 1 (STEM OUTPUT. FINIS'
 if rc\=0 then do
  'STATE GHCRED REPO G'
  if rc=0 then 'ERASE GHCRED REPO G'
  return 'ERROR'
 end
 call readcredential
 if result\='OK' | present\=1 | username\=storeduser |,
    credentialmode\=storedmode | secret\=storedsecret then do
  'ERASE GHCRED REPO G'
  return 'ERROR'
 end
 return 'OK'

readcredential:
 present=0
 storeduser=''
 storedsecret=''
 storedmode=''
 'STATE GHCRED REPO G'
 if rc=28 then return 'OK'
 if rc\=0 then return 'ERROR'
 drop cred.
 'EXECIO * DISKR GHCRED REPO G 1 (STEM CRED. FINIS'
 if rc\=0 | cred.0<4 then return 'ERROR'
 if cred.1='GHCRED 1' then do
  storedmode='APIKEY'
  userrec=2
  lenrec=3
  firstsecret=4
  lenlabel='TOKEN-LENGTH'
  chunkprefix='TOKEN'
 end
 else if cred.1='GHCRED 2' then do
  if words(cred.2)\=2 | word(cred.2,1)\='MODE' then,
   return 'ERROR'
  storedmode=word(cred.2,2)
  if storedmode\='APIKEY' & storedmode\='USERPASS' then,
   return 'ERROR'
  userrec=3
  lenrec=4
  firstsecret=5
  lenlabel='SECRET-LENGTH'
  chunkprefix='SECRET'
 end
 else return 'ERROR'
 if words(cred.userrec)\=2 | word(cred.userrec,1)\='USER' then,
  return 'ERROR'
 storeduser=strip(word(cred.userrec,2))
 call validuser storeduser
 if result\='OK' then return 'ERROR'
 if words(cred.lenrec)\=2 |,
    word(cred.lenrec,1)\=lenlabel then return 'ERROR'
 secretlength=word(cred.lenrec,2)
 if datatype(secretlength,'W')\=1 | secretlength<1 |,
    secretlength>240 then return 'ERROR'
 chunks=(secretlength+63)%64
 if cred.0\=firstsecret+chunks-1 then return 'ERROR'
 do ci=1 to chunks
  rec=firstsecret+ci-1
  parse var cred.rec clabel cvalue
  cvalue=strip(cvalue)
  if ci=1 then expected=chunkprefix
  else expected=chunkprefix||'+'||(ci-1)
  wantlen=secretlength-((ci-1)*64)
  if wantlen>64 then wantlen=64
  if words(cred.rec)\=2 | clabel\=expected |,
     length(cvalue)\=wantlen then return 'ERROR'
  call validsecret cvalue
  if result\='OK' then return 'ERROR'
  storedsecret=storedsecret||cvalue
 end
 if length(storedsecret)\=secretlength then return 'ERROR'
 present=1
 return 'OK'

validsecret:
 parse arg value
 if value='' | length(value)>240 then return 'ERROR'
 if verify(value,tokenalphabet)\=0 then return 'ERROR'
 return 'OK'

validuser:
 parse arg user
 if user='' | length(user)>39 then return 'ERROR'
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-'
 if verify(translate(user),allowed)\=0 then return 'ERROR'
 return 'OK'

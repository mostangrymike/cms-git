/* M170: generalized bounded smart-HTTP upload-pack POST. */
address cms
parse arg cmd bridge port authority repo oid storefn extra
cmd=translate(cmd)
oid=translate(oid)
storemode=cmd='STORE'
if (cmd\='POST' & cmd\='STORE') | bridge='' | port='' |,
   authority='' | repo='' | oid='' then do
 say 'Usage: GITPOST POST bridge port host repo oid'
 say '   or: GITPOST STORE bridge port host repo oid fn'
 exit 4
end
if cmd='POST' & storefn\='' then exit 4
if storemode then do
 storefn=translate(storefn)
 call safefn storefn
 if result\='OK' then exit 4
 'STATE' storefn 'PACK A'
 if rc\=28 then do
  say 'GITPOST: store PACK already exists' storefn
  exit 8
 end
 'STATE' storefn 'META A'
 if rc\=28 then do
  say 'GITPOST: store META already exists' storefn
  exit 8
 end
 sbuf=''
 srecs=0
 drop sw.
end
if datatype(port,'W')\=1 | port<1 | port>65535 then exit 4
call safehost authority
if result\='OK' then exit 4
call safepath repo
if result\='OK' then exit 4
if left(repo,1)='/' | right(repo,1)='/' | pos('..',repo)>0 then exit 4
if length(oid)\=40 | verify(oid,'0123456789ABCDEF')\=0 then exit 4

have=''
depth=0
rest=extra
do while strip(rest)\=''
 parse var rest kw val rest
 kw=translate(kw)
 if kw='HAVE' then do
  have=translate(val)
  if length(have)\=40 | verify(have,'0123456789ABCDEF')\=0 then do
   say 'GITPOST: invalid have OID'
   exit 8
  end
 end
 else if kw='DEPTH' then do
  if datatype(val,'W')\=1 | val<1 | val>1 then do
   say 'GITPOST: depth must be 1'
   exit 8
  end
  depth=val
 end
 else do
  say 'GITPOST: unknown request option' kw
  exit 4
 end
end
wantoid=translate(oid,'abcdef','ABCDEF')

/* Protocol v0 upload-request: want lines, shallow lines, depth request,
   flush, have lines, done.  DEPTH 1 asks the server for the tip closure
   only, which keeps a CMS pull small and fast. */
want='want '||wantoid||' side-band-64k ofs-delta'
plen=4+length(want)+1
ph=right(d2x(plen),4,'0')
call toasciihex ph
body=result
call toasciihex want
body=body||result||'0A'
if depth>0 & have\='' then do
 deepen='deepen '||depth
 plen=4+length(deepen)+1
 ph=right(d2x(plen),4,'0')
 call toasciihex ph
 body=body||result
 call toasciihex deepen
 body=body||result||'0A'
end
call toasciihex '0000'
body=body||result
if have\='' then do
 haveline='have '||have
 plen=4+length(haveline)+1
 ph=right(d2x(plen),4,'0')
 call toasciihex ph
 body=body||result
 call toasciihex haveline
 body=body||result||'0A'
end
call toasciihex '0009done'
body=body||result||'0A'
clen=length(body)%2

path='/'||repo||'.git/git-upload-pack'
if length(path)>512 then exit 4
call toasciihex 'POST '||path||' HTTP/1.1'
wire=result||'0D0A'
call toasciihex 'Host: '||authority
wire=wire||result||'0D0A'
call authheader
authvalue=result
if authvalue='ERROR' then do
 say 'GITPOST: invalid stored GitHub credential'
 exit 8
end
if authvalue\='' then do
 if translate(authority)\='GITHUB.COM' then do
  say 'GITPOST: stored GitHub credential is limited to github.com'
  exit 8
 end
 call toasciihex authvalue
 if result='ERROR' then exit 8
 wire=wire||result||'0D0A'
end
call toasciihex 'Content-Type: application/x-git-upload-pack-request'
wire=wire||result||'0D0A'
call toasciihex 'Accept: application/x-git-upload-pack-result'
wire=wire||result||'0D0A'
call toasciihex 'Content-Length: '||clen
wire=wire||result||'0D0A'
call toasciihex 'Connection: close'
wire=wire||result||'0D0A0D0A'||body
raw=x2c(wire)

s=''
r=Socket('Initialize','GITPOST')
parse var r src rest
if src\=0 then do
 say 'GITPOST: socket initialize failed RC' src
 exit 8
end
if verify(bridge,'0123456789.')=0 then ip=bridge
else do
 r=Socket('GetHostByName',bridge)
 parse var r src addrs
 if src\=0 then do
  fail='RESOLVE-RC'
  call bad
 end
 ip=word(addrs,1)
 if ip='' then do
  fail='RESOLVE-EMPTY'
  call bad
 end
end
r=Socket('Socket')
parse var r src s
if src\=0 then do
 fail='SOCKET-CREATE'
 call bad
end
r=Socket('GetSockOpt',s,'SOL_SOCKET','SO_ASCII')
parse var r src opt
if src\=0 | translate(opt)\='OFF' then do
 fail='SO-ASCII'
 call bad
end
r=Socket('Connect',s,'AF_INET' port ip)
parse var r src rest
if src\=0 then do
 say 'GITPOST: connect target' ip port
 say 'GITPOST: connect RC' src rest
 fail='CONNECT'
 call bad
end
r=Socket('Send',s,raw)
parse var r src sent
if src\=0 | sent\=length(raw) then do
 fail='SEND'
 call bad
end

hstate='HEAD'
header=''
cstate='SIZE'
cline=''
cneed=0
ccrlf=''
chunkdone=0
pstate='HDR'
phdr=''
pneed=0
ppay=''
pband=''
nak=0
shallows=0
unshallows=0
acks=0
pktcount=0
flushes=0
packets=0
progress=0
packbytes=0
packhead=''
total=0

do forever
 r=Socket('Recv',s,256)
 parse var r src got data
 if src\=0 then do
  fail='RECV'
  call bad
 end
 if got=0 then leave
 if got>256 | length(data)\=got then do
  fail='RECV-LENGTH'
  call bad
 end
 total=total+got
 if total>16777216 then do
  fail='RESPONSE-LIMIT'
  call bad
 end
 call httpfeed c2x(data)
 if result\='OK' then do
  fail='HTTP-PARSE'
  call bad
 end
end
r=Socket('Close',s)
s=''
if hstate\='BODY' | chunkdone\=1 | cstate\='DONE' then do
 fail='FINAL-HTTP'
 call bad
end
if pstate\='HDR' | phdr\='' | pneed\=0 then do
 fail='FINAL-PKT'
 call bad
end
if (nak=0 & acks=0) | packbytes<12 | length(packhead)\=24 then do
 fail='FINAL-UPLOAD-PACK'
 call bad
end
if left(packhead,8)\='5041434B' then do
 fail='PACK-SIGNATURE'
 call bad
end
pver=x2d(substr(packhead,9,8))
pobjects=x2d(substr(packhead,17,8))
if (pver\=2 & pver\=3) then do
 fail='PACK-HEADER'
 call bad
end
if storemode then do
 call storefinal
 if result\='OK' then do
  fail='STORE-FINAL'
  call bad
 end
end
r=Socket('Terminate')
say 'FETCH POST WANT' oid
say 'FETCH POST PACK VERSION' pver 'OBJECTS' pobjects
say 'FETCH POST PACK BYTES' packbytes
say 'FETCH POST SHALLOW LINES' shallows 'UNSHALLOW' unshallows 'ACK' acks
say 'FETCH POST PROGRESS BYTES' progress
say 'FETCH POST HTTP BYTES' total
if storemode then do
 say 'FETCH POST STORED' storefn 'PACK A'
 say 'FETCH POST META' storefn 'META A'
 say 'M171 FETCH STORE PASS'
end
say 'M170 FETCH POST PASS'
exit 0

bad:
 say 'GITPOST: failed at' fail
 if symbol('hstate')='VAR' then,
  say 'GITPOST: HTTP' hstate cstate cneed total
 if symbol('pstate')='VAR' then,
  say 'GITPOST: PKT' pstate nak pktcount packbytes
 if s\='' then r=Socket('Close',s)
 r=Socket('Terminate')
 if storemode then call storeclean
 exit 8

storefeed:
 parse arg shex
 /* A nearly full A disk used to abort the transfer midway, leaving a PACK
    with no META.  Check once before the first write and fail clearly. */
 if storechecked\=1 then do
  storechecked=1
  call afree
  if result='ERROR' | result<64 then do
   say 'GITPOST: disk A has fewer than 64 free blocks; not storing the pack'
   return 'ERROR'
  end
 end
 sbuf=sbuf||shex
 do while length(sbuf)>=128
  srecs=srecs+1
  sw.srecs=left(sbuf,128)
  sbuf=substr(sbuf,129)
  if srecs=64 then do
   call storeflush
   if result\='OK' then return 'ERROR'
  end
 end
 return 'OK'

storeflush:
 if srecs=0 then return 'OK'
 sw.0=srecs
 'EXECIO' srecs 'DISKW' storefn 'PACK A 0 (STEM SW. FINIS'
 if rc\=0 then return 'ERROR'
 drop sw.
 srecs=0
 return 'OK'

storefinal:
 if sbuf\='' then do
  srecs=srecs+1
  sw.srecs=sbuf
  sbuf=''
 end
 call storeflush
 if result\='OK' then return 'ERROR'
 /* META needs at least one block.  If A filled during the transfer, roll
    back the partial PACK instead of leaving an unusable pair. */
 call afree
 if result='ERROR' | result<2 then do
  say 'GITPOST: disk A is full; erasing partial' storefn 'PACK A'
  'ERASE' storefn 'PACK A'
  return 'ERROR'
 end
 sm.1='META' oid packbytes pver pobjects
 sm.0=1
 'EXECIO 1 DISKW' storefn 'META A 1 (STEM SM. FINIS'
 if rc\=0 then return 'ERROR'
 return 'OK'

storeclean:
 'STATE' storefn 'PACK A'
 if rc=0 then 'ERASE' storefn 'PACK A'
 'STATE' storefn 'META A'
 if rc=0 then 'ERASE' storefn 'META A'
 return

httpfeed:
 parse arg hx
 hx=translate(hx)
 if hstate='HEAD' then do
  header=header||hx
  if length(header)>32768 then return 'ERROR'
  hp=pos('0D0A0D0A',header)
  if hp=0 then return 'OK'
  bodypart=substr(header,hp+8)
  hpart=left(header,hp+7)
  call checkhdr hpart
  if result\='OK' then return 'ERROR'
  hstate='BODY'
  header=''
  if bodypart\='' then do
   call chunkfeed bodypart
   if result\='OK' then return 'ERROR'
  end
  return 'OK'
 end
 if hstate\='BODY' then return 'ERROR'
 call chunkfeed hx
 return result

checkhdr:
 parse arg hh
 if left(hh,24)\='485454502F312E3120323030' &,
    left(hh,24)\='485454502F312E3020323030' then return 'ERROR'
 call asciitocms hh
 ht=result
 if ht='ERROR' then return 'ERROR'
 hu=translate(ht)
 if pos('CONTENT-TYPE:',hu)=0 then return 'ERROR'
 if pos('APPLICATION/X-GIT-UPLOAD-PACK-RESULT',hu)=0 then,
  return 'ERROR'
 if pos('TRANSFER-ENCODING:',hu)=0 | pos('CHUNKED',hu)=0 then,
  return 'ERROR'
 return 'OK'

chunkfeed:
 parse arg cwork
 cwork=translate(cwork)
 do while cwork\=''
  if cstate='SIZE' then do
   cb=left(cwork,2)
   cwork=substr(cwork,3)
   cline=cline||cb
   if length(cline)>128 then return 'ERROR'
   if right(cline,4)='0D0A' then do
    ch=left(cline,length(cline)-4)
    cline=''
    ep=bytepos('3B',ch)
    if ep>0 then ch=left(ch,ep-1)
    if ch='' | length(ch)//2\=0 | length(ch)>16 then,
       return 'ERROR'
    cneed=0
    do cj=1 to length(ch) by 2
     cv=x2d(substr(ch,cj,2))
     if cv>=48 & cv<=57 then cn=cv-48
     else if cv>=65 & cv<=70 then cn=cv-55
     else if cv>=97 & cv<=102 then cn=cv-87
     else return 'ERROR'
     cneed=cneed*16+cn
    end
    if cneed>1048576 then return 'ERROR'
    if cneed=0 then do
     cstate='DONE'
     chunkdone=1
     cwork=''
    end
    else cstate='DATA'
   end
  end
  else if cstate='DATA' then do
   cavail=length(cwork)%2
   ctake=cneed
   if ctake>cavail then ctake=cavail
   if ctake=0 then return 'OK'
   cpiece=left(cwork,ctake*2)
   cwork=substr(cwork,ctake*2+1)
   call pktfeed cpiece
   if result\='OK' then return 'ERROR'
   cneed=cneed-ctake
   if cneed=0 then do
    cstate='CRLF'
    ccrlf=''
   end
  end
  else if cstate='CRLF' then do
   ctake=4-length(ccrlf)
   if ctake>length(cwork) then ctake=length(cwork)
   ccrlf=ccrlf||left(cwork,ctake)
   cwork=substr(cwork,ctake+1)
   if length(ccrlf)=4 then do
    if ccrlf\='0D0A' then return 'ERROR'
    ccrlf=''
    cstate='SIZE'
   end
  end
  else if cstate='DONE' then cwork=''
  else return 'ERROR'
 end
 return 'OK'

pktfeed:
 parse arg pwork
 pwork=translate(pwork)
 do while pwork\=''
  if pstate='HDR' then do
   ptake=8-length(phdr)
   if ptake>length(pwork) then ptake=length(pwork)
   phdr=phdr||left(pwork,ptake)
   pwork=substr(pwork,ptake+1)
   if length(phdr)<8 then iterate
   call pktlen phdr
   pn=result
   if pn='ERROR' then return 'ERROR'
   phdr=''
   if pn=0 | pn=1 | pn=2 then do
    flushes=flushes+1
    iterate
   end
   if pn<4 then return 'ERROR'
   pneed=pn-4
   if pneed<1 | pneed>65516 then return 'ERROR'
   pktcount=pktcount+1
   /* The pre-pack phase holds NAK/ACK/shallow lines and is over as soon as
      either one has been seen; everything after that is side-band data.
      Keying only on NAK breaks a HAVE request, where the server replies
      "ACK <oid>" and then goes straight to side-band progress packets. */
   if nak=0 & acks=0 then do
    if pneed>200 then return 'ERROR'
    ppay=''
    pstate='PRE'
   end
   else do
    pband=''
    pstate='BAND'
   end
  end
  else if pstate='PRE' then do
   pavail=length(pwork)%2
   ptake=pneed
   if ptake>pavail then ptake=pavail
   if ptake=0 then return 'OK'
   ppay=ppay||left(pwork,ptake*2)
   pwork=substr(pwork,ptake*2+1)
   pneed=pneed-ptake
   if pneed=0 then do
    if ppay='4E414B0A' then do
     nak=nak+1
     if nak\=1 then return 'ERROR'
    end
    else if left(ppay,14)='7368616C6C6F77' then shallows=shallows+1
    else if left(ppay,18)='756E7368616C6C6F77' then unshallows=unshallows+1
    else if left(ppay,6)='41434B' then acks=acks+1
    else return 'ERROR'
    ppay=''
    pstate='HDR'
   end
  end
  else if pstate='BAND' then do
   if length(pwork)<2 then return 'OK'
   pband=left(pwork,2)
   pwork=substr(pwork,3)
   pneed=pneed-1
   if pband\='01' & pband\='02' & pband\='03' then,
    return 'ERROR'
   if pband='03' then return 'ERROR'
   if pband='01' then packets=packets+1
   if pneed=0 then pstate='HDR'
   else pstate='PAY'
  end
  else if pstate='PAY' then do
   pavail=length(pwork)%2
   ptake=pneed
   if ptake>pavail then ptake=pavail
   if ptake=0 then return 'OK'
   ppiece=left(pwork,ptake*2)
   pwork=substr(pwork,ptake*2+1)
   if pband='01' then do
    packbytes=packbytes+ptake
    if length(packhead)<24 then do
     htake=24-length(packhead)
     if htake>length(ppiece) then htake=length(ppiece)
     packhead=packhead||left(ppiece,htake)
    end
    if storemode then do
     call storefeed ppiece
     if result\='OK' then return 'ERROR'
    end
   end
   else if pband='02' then progress=progress+ptake
   pneed=pneed-ptake
   if pneed=0 then do
    pband=''
    pstate='HDR'
   end
  end
  else return 'ERROR'
 end
 return 'OK'

pktlen: procedure
 parse arg h
 if length(h)\=8 then return 'ERROR'
 n=0
 do i=1 to 4
  b=x2d(substr(h,i*2-1,2))
  if b>=48 & b<=57 then v=b-48
  else if b>=65 & b<=70 then v=b-55
  else if b>=97 & b<=102 then v=b-87
  else return 'ERROR'
  n=n*16+v
 end
 return n

bytepos: procedure
 parse arg needle,hex
 do bp=1 to length(hex)-1 by 2
  if substr(hex,bp,2)=needle then return bp
 end
 return 0

authheader: procedure
 address cms
 tokenalphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
 tokenalphabet=tokenalphabet||'0123456789_-'
 'STATE GHCRED REPO A'
 if rc=28 then return ''
 if rc\=0 then return 'ERROR'
 drop cred.
 'EXECIO * DISKR GHCRED REPO A 1 (STEM CRED. FINIS'
 if rc\=0 | cred.0<4 then return 'ERROR'
 if cred.1='GHCRED 1' then do
  authmode='APIKEY'
  userrec=2
  lenrec=3
  firstsecret=4
  lenlabel='TOKEN-LENGTH'
  chunkprefix='TOKEN'
 end
 else if cred.1='GHCRED 2' then do
  if words(cred.2)\=2 | word(cred.2,1)\='MODE' then,
   return 'ERROR'
  authmode=word(cred.2,2)
  if authmode\='APIKEY' & authmode\='USERPASS' then,
   return 'ERROR'
  userrec=3
  lenrec=4
  firstsecret=5
  lenlabel='SECRET-LENGTH'
  chunkprefix='SECRET'
 end
 else return 'ERROR'
 if words(cred.userrec)\=2 | word(cred.userrec,1)\='USER' then,
  return 'ERROR'
 authuser=word(cred.userrec,2)
 if authuser='' | length(authuser)>39 |,
    verify(translate(authuser),'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-')\=0 then,
  return 'ERROR'
 if words(cred.lenrec)\=2 | word(cred.lenrec,1)\=lenlabel then,
  return 'ERROR'
 tokenlength=word(cred.lenrec,2)
 if datatype(tokenlength,'W')\=1 | tokenlength<1 | tokenlength>240 then,
  return 'ERROR'
 chunks=(tokenlength+63)%64
 if cred.0\=firstsecret+chunks-1 then return 'ERROR'
 authtoken=''
 do authi=1 to chunks
  rec=firstsecret+authi-1
  parse var cred.rec authlabel authpart
  authpart=strip(authpart)
  if authi=1 then expected=chunkprefix
  else expected=chunkprefix||'+'||(authi-1)
  wantlen=tokenlength-((authi-1)*64)
  if wantlen>64 then wantlen=64
  if words(cred.rec)\=2 | authlabel\=expected |,
     length(authpart)\=wantlen | verify(authpart,tokenalphabet)\=0 then,
   return 'ERROR'
  authtoken=authtoken||authpart
 end
 if length(authtoken)\=tokenlength then return 'ERROR'
 call toasciihex authuser||':'||authtoken
 authbytes=result
 if authbytes='ERROR' | length(authbytes)//2\=0 then return 'ERROR'
 alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
 alphabet=alphabet||'0123456789+/'
 auth64=''
 do authi=1 to length(authbytes) by 6
  remain=length(authbytes)-authi+1
  if remain<2 then return 'ERROR'
  b1=x2d(substr(authbytes,authi,2))
  b2=0
  b3=0
  if remain>=4 then b2=x2d(substr(authbytes,authi+2,2))
  if remain>=6 then b3=x2d(substr(authbytes,authi+4,2))
  six1=b1%4
  six2=(b1//4)*16+b2%16
  six3=(b2//16)*4+b3%64
  six4=b3//64
  auth64=auth64||substr(alphabet,six1+1,1)||,
         substr(alphabet,six2+1,1)
  if remain>=4 then auth64=auth64||substr(alphabet,six3+1,1)
  else auth64=auth64||'='
  if remain>=6 then auth64=auth64||substr(alphabet,six4+1,1)
  else auth64=auth64||'='
 end
 return 'Authorization: Basic '||auth64

safefn: procedure
 parse arg text
 if text='' | length(text)>8 then return 'ERROR'
 if verify(text,'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789')\=0 then,
  return 'ERROR'
 return 'OK'

safehost: procedure
 parse arg text
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-'
 if text='' | length(text)>255 | verify(text,allowed)\=0 then,
  return 'ERROR'
 return 'OK'

safepath: procedure
 parse arg text
 allowed='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-/'
 if text='' | length(text)>255 | verify(text,allowed)\=0 then,
  return 'ERROR'
 return 'OK'

toasciihex: procedure
 parse arg text
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 return c2x(translate(text,tab,bytes))

asciitocms: procedure
 parse arg ah
 if ah='' then return ''
 if length(ah)//2\=0 then return 'ERROR'
 ah=translate(ah)
 do ai=1 to length(ah)
  if pos(substr(ah,ai,1),'0123456789ABCDEF')=0 then return 'ERROR'
 end
 ascii=x2c(ah)
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 if length(e2a)\=512 then return 'ERROR'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 return translate(ascii,bytes,tab)

afree:
 /* Return the blocks left on the A disk, or ERROR. */
 drop af.
af.0=0
'PIPE CMS QUERY DISK A | STEM AF.'
if rc\=0 then return 'ERROR'
found=''
do afi=1 to af.0
 if word(af.afi,3)='A' & word(af.afi,4)='R/W' & words(af.afi)>=11 then,
  found=word(af.afi,10)
end
if datatype(found,'W')\=1 then return 'ERROR'
return found

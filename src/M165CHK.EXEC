/* M165: disposable multi-path staged commit; refs stay unchanged. */
address cms
call absent 'M165TST','DATA','A'
if result\=0 then exit 8
call absent 'M165TS2','DATA','A'
if result\=0 then exit 8
call absent 'GITWORK','REPO','A'
if result\=0 then exit 8
call absent 'GITTREE','REPO','A'
if result\=0 then exit 8
say 'M165 DISPOSABLE TARGETS ABSENT'

drop rb.
'EXECIO * DISKR GITREF2 REPO A 1 (STEM RB. FINIS'
if rc\=0 then do
 say 'M165 REF SNAPSHOT FAIL'
 exit 8
end

cmd='EXEC ZTMCAND1 CHECKOUT HEAD src/GIT.EXEC M165TST DATA A'
address command cmd
if rc\=0 then do
 call cleanup
 say 'M165 CHECKOUT ONE FAIL'
 exit 8
end
cmd='EXEC ZTMCAND1 CHECKOUT HEAD src/GIT42TEST.EXEC M165TS2 DATA A'
address command cmd
if rc\=0 then do
 call cleanup
 say 'M165 CHECKOUT TWO FAIL'
 exit 8
end

'ERASE M165TST DATA A'
'STATE M165TST DATA A'
if rc=28 then nop
else do
 call cleanup
 say 'M165 RESET ONE FAIL STATE RC' rc
 exit 8
end
'ERASE M165TS2 DATA A'
'STATE M165TS2 DATA A'
if rc=28 then nop
else do
 call cleanup
 say 'M165 RESET TWO FAIL STATE RC' rc
 exit 8
end
drop t.
t.1='M165 MULTI PATH ONE'
t.0=1
'EXECIO 1 DISKW M165TST DATA A 1 (STEM T. FINIS'
if rc\=0 then do
 call cleanup
 say 'M165 MODIFY ONE FAIL'
 exit 8
end
drop t.
t.1='M165 MULTI PATH TWO'
t.0=1
'EXECIO 1 DISKW M165TS2 DATA A 1 (STEM T. FINIS'
if rc\=0 then do
 call cleanup
 say 'M165 MODIFY TWO FAIL'
 exit 8
end

address command 'EXEC ZTMCAND1 ADD src/GIT.EXEC'
if rc\=0 then do
 call cleanup
 say 'M165 ADD ONE FAIL'
 exit 8
end
address command 'EXEC ZTMCAND1 ADD src/GIT42TEST.EXEC'
if rc\=0 then do
 call cleanup
 say 'M165 ADD TWO FAIL'
 exit 8
end
say 'M165 STAGED PATHS 2 PASS'

drop st.
st.0=0
'PIPE CMS EXEC ZTMCAND1 STATUS | STEM ST.'
if rc\=0 then do
 call cleanup
 say 'M165 STAGED STATUS FAIL'
 exit 8
end

drop co.
co.0=0
cmd='EXEC ZTMCAND1 COMMIT -T 1 -Z +0000 -M M165_multi'
'PIPE CMS' cmd '| STEM CO.'
crc=rc
if crc\=0 then do
 call cleanup
 say 'M165 MULTI COMMIT FAIL RC' crc
 exit 8
end
depthcount=0
pathcount=0
commitcount=0
commit=''
do ci=1 to co.0
 if word(co.ci,1)='COMMIT-STAGED' &,
    word(co.ci,2)='TREE' & word(co.ci,3)='DEPTH' then,
  depthcount=depthcount+1
 if co.ci='COMMIT-STAGED PATHS 2' then pathcount=pathcount+1
 if word(co.ci,1)='COMMIT-STAGED' &,
    word(co.ci,2)='COMMIT' then do
  commitcount=commitcount+1
  commit=translate(word(co.ci,3))
 end
end
if depthcount\=1 | pathcount\=1 | commitcount\=1 then do
 call cleanup
 say 'M165 MULTI COMMIT OUTPUT COUNTS FAIL',
  depthcount pathcount commitcount
 exit 8
end
if length(commit)\=40 |,
   verify(commit,'0123456789ABCDEF')\=0 then do
 call cleanup
 say 'M165 MULTI COMMIT OID INVALID'
 exit 8
end
address command 'EXEC GIT VERIFY-OBJECT' commit
if rc\=0 then do
 call cleanup
 say 'M165 MULTI COMMIT OBJECT VERIFY FAIL RC' rc
 exit 8
end
say 'M165 MULTI COMMIT CANDIDATE' commit
say 'M165 MULTI COMMIT REBUILT SHARED SUBTREE ONCE'

drop ac.
ac.0=0
'PIPE CMS EXEC ZTMCAND1 ACCEPT | STEM AC.'
if rc\=0 then do
 call cleanup
 say 'M165 ACCEPT FAIL'
 exit 8
end
acceptedcount=0
do ci=1 to ac.0
 if ac.ci='ACCEPTED WORKTREE PATHS 2' then,
  acceptedcount=acceptedcount+1
end
if acceptedcount\=1 then do
 call cleanup
 say 'M165 ACCEPTED PATH COUNT FAIL' acceptedcount
 exit 8
end

'STATE GITTREE REPO A'
if rc=28 then nop
else do
 call cleanup
 say 'M165 TREE TEMP CLEANUP FAIL'
 exit 8
end

drop ra.
'EXECIO * DISKR GITREF2 REPO A 1 (STEM RA. FINIS'
if rc\=0 | ra.0\=rb.0 then do
 call cleanup
 say 'M165 REF RECHECK FAIL'
 exit 8
end
do ri=1 to rb.0
 if ra.ri\=rb.ri then do
  call cleanup
  say 'M165 REF CHANGED'
  exit 8
 end
end
say 'M165 VERIFIED REFS UNCHANGED'

drop st.
st.0=0
'PIPE CMS EXEC ZTMCAND1 STATUS | STEM ST.'
if rc\=0 then do
 call cleanup
 say 'M165 POST COMMIT STATUS FAIL'
 exit 8
end
cleanstatus=0
do ci=1 to st.0
 if st.ci='STATUS SUMMARY TRACKED 2 CHANGED 0 STAGED 0' then,
  cleanstatus=cleanstatus+1
end
if cleanstatus\=1 then do
 call cleanup
 say 'M165 POST COMMIT STATUS NOT CLEAN'
 exit 8
end

call cleanup
if result\=0 then do
 say 'M165 CLEANUP FAIL'
 exit 8
end
say 'M165 LOOSE COMMIT CANDIDATE RETAINED FOR REF CAS'
say 'M165 MULTI-PATH STAGED COMMIT TARGET GATE PASS'
exit 0

absent:
 parse arg afn,aft,afm
 'STATE' afn aft afm
 if rc=28 then return 0
 say 'M165: expected absent' afn aft afm 'RC' rc
 return 8

cleanup:
 crc=0
 'STATE M165TST DATA A'
 if rc=0 then do
  'ERASE M165TST DATA A'
  if rc\=0 then crc=8
 end
 else if rc\=28 then crc=8
 'STATE M165TS2 DATA A'
 if rc=0 then do
  'ERASE M165TS2 DATA A'
  if rc\=0 then crc=8
 end
 else if rc\=28 then crc=8
 'STATE GITWORK REPO A'
 if rc=0 then do
  'ERASE GITWORK REPO A'
  if rc\=0 then crc=8
 end
 else if rc\=28 then crc=8
 'STATE GITTREE REPO A'
 if rc=0 then do
  'ERASE GITTREE REPO A'
  if rc\=0 then crc=8
 end
 else if rc\=28 then crc=8
 return crc

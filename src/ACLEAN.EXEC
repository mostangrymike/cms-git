/* ACLEAN: exact-file, two-step cleanup for MAINT CMS A. */
/* PLAN is read-only. APPLY needs explicit batch argument. */
/* Never targets source, live modules, generations or PACK data. */
address cms
parse upper arg verb batch extra
if extra\='' | (verb\='PLAN' & verb\='APPLY') |,
   (batch\='LISTINGS' & batch\='EXPERIMENTS' &,
    batch\='OLDTESTS' & batch\='BUILDDECK' &,
    batch\='RECENTGEN' & batch\='PACKGEN' &,
    batch\='NETTRACE') then do
 say 'Usage: ACLEAN PLAN|APPLY batch-name'
 exit 4
end
drop f.
n=0
n=n+1; f.n='CCTEST1 LISTING'
n=n+1; f.n='GITCABI LISTING'
n=n+1; f.n='GITCINF LISTING'
n=n+1; f.n='GITCORE LISTING'
n=n+1; f.n='GITCPARS LISTING'
n=n+1; f.n='GITCPROB LISTING'
n=n+1; f.n='GITC2 LISTING'
n=n+1; f.n='GITCAPI LISTING'
n=n+1; f.n='GITNCALL LISTING'
n=n+1; f.n='GITNDRV LISTING'
n=n+1; f.n='GITNHEX LISTING'
n=n+1; f.n='GITSEL LISTING'
n=n+1; f.n='GITSTRM LISTING'
n=n+1; f.n='GIT12Q LISTING'
n=n+1; f.n='HELLO LISTING'
n=n+1; f.n='M12ABEG LISTING'
n=n+1; f.n='M12BOPN LISTING'
n=n+1; f.n='M12TLS2 LISTING'
n=n+1; f.n='M12TLS3 LISTING'
n=n+1; f.n='M12TLS4 LISTING'
if batch='EXPERIMENTS' then do
 n=0
 n=n+1; f.n='CCTEST1 MODULE'
 n=n+1; f.n='CCTEST1 TEXT'
 n=n+1; f.n='HELLO MODULE'
 n=n+1; f.n='HELLO TEXT'
 n=n+1; f.n='GITCABI MODULE'
 n=n+1; f.n='GITCABI TEXT'
 n=n+1; f.n='GITCINF MODULE'
 n=n+1; f.n='GITCINF TEXT'
 n=n+1; f.n='GITCPARS MODULE'
 n=n+1; f.n='GITCPARS TEXT'
 n=n+1; f.n='GITCPROB MODULE'
 n=n+1; f.n='GITCPROB TEXT'
 n=n+1; f.n='GITC2 MODULE'
 n=n+1; f.n='GITC2 TEXT'
 n=n+1; f.n='GIT12Q MODULE'
 n=n+1; f.n='GIT12Q TEXT'
 n=n+1; f.n='M12ABEG MODULE'
 n=n+1; f.n='M12ABEG TEXT'
 n=n+1; f.n='M12BOPN MODULE'
 n=n+1; f.n='M12BOPN TEXT'
 n=n+1; f.n='M12TLS2 MODULE'
 n=n+1; f.n='M12TLS2 TEXT'
 n=n+1; f.n='M12TLS3 MODULE'
 n=n+1; f.n='M12TLS3 TEXT'
 n=n+1; f.n='M12TLS4 MODULE'
 n=n+1; f.n='M12TLS4 TEXT'
end
/* Exact retired regression EXEC source lives in GitHub archives. */
if batch='OLDTESTS' then do
 n=0
 n=n+1; f.n='M10AFEED EXEC'
 n=n+1; f.n='M10BFRAG EXEC'
 n=n+1; f.n='M10CRESP EXEC'
 n=n+1; f.n='M10DREAL EXEC'
 n=n+1; f.n='M10ESTRS EXEC'
 n=n+1; f.n='M11ATCP EXEC'
 n=n+1; f.n='M11BRAW EXEC'
 n=n+1; f.n='M11CHTTP EXEC'
 n=n+1; f.n='M11DGIT EXEC'
 n=n+1; f.n='M11PROBE EXEC'
 n=n+1; f.n='M12GDISC EXEC'
 n=n+1; f.n='M12HADV EXEC'
 n=n+1; f.n='M12ICHNK EXEC'
 n=n+1; f.n='M12JPOST EXEC'
 n=n+1; f.n='M12KPACK EXEC'
 n=n+1; f.n='M12PRXY EXEC'
 n=n+1; f.n='M13NTEST EXEC'
 n=n+1; f.n='M13POUT EXEC'
 n=n+1; f.n='M13PREP EXEC'
 n=n+1; f.n='M13PSTG EXEC'
 n=n+1; f.n='M13QDISP EXEC'
 n=n+1; f.n='M13SFAIL EXEC'
 n=n+1; f.n='M13WALK EXEC'
 n=n+1; f.n='M3ETEST EXEC'
 n=n+1; f.n='M4CASE EXEC'
 n=n+1; f.n='M4COMMIT EXEC'
 n=n+1; f.n='M4CREATE EXEC'
 n=n+1; f.n='M4DB EXEC'
 n=n+1; f.n='M4FINAL EXEC'
 n=n+1; f.n='M4GENCOM EXEC'
 n=n+1; f.n='M4MULTI EXEC'
 n=n+1; f.n='M4PUB EXEC'
 n=n+1; f.n='M4STORE EXEC'
 n=n+1; f.n='M4TEST EXEC'
 n=n+1; f.n='M5FINAL EXEC'
 n=n+1; f.n='M5HEAD EXEC'
 n=n+1; f.n='M5REFS EXEC'
 n=n+1; f.n='M5UPDATE EXEC'
 n=n+1; f.n='M6ACK EXEC'
 n=n+1; f.n='M6ADV EXEC'
 n=n+1; f.n='M6DAPP EXEC'
 n=n+1; f.n='M6DELTA EXEC'
 n=n+1; f.n='M6NEG EXEC'
 n=n+1; f.n='M6ODLT EXEC'
 n=n+1; f.n='M6OFS EXEC'
 n=n+1; f.n='M6ORES EXEC'
 n=n+1; f.n='M6PACK EXEC'
 n=n+1; f.n='M6PCTX EXEC'
 n=n+1; f.n='M6PKT EXEC'
 n=n+1; f.n='M6POBJ EXEC'
 n=n+1; f.n='M6RDEL EXEC'
 n=n+1; f.n='M6SIDE EXEC'
 n=n+1; f.n='M7ADLER EXEC'
 n=n+1; f.n='M7DYN EXEC'
 n=n+1; f.n='M7FIX EXEC'
 n=n+1; f.n='M7INFL EXEC'
 n=n+1; f.n='M7PINF EXEC'
 n=n+1; f.n='M7STOR EXEC'
 n=n+1; f.n='M7ZDEL EXEC'
 n=n+1; f.n='M7ZLIB EXEC'
 n=n+1; f.n='M8OFS EXEC'
 n=n+1; f.n='M8PACK EXEC'
 n=n+1; f.n='M8REF EXEC'
 n=n+1; f.n='M9CSHA EXEC'
 n=n+1; f.n='M9DINF EXEC'
 n=n+1; f.n='M9EINF EXEC'
 n=n+1; f.n='M9FWALK EXEC'
 n=n+1; f.n='M9GOFS EXEC'
 n=n+1; f.n='M9HREF EXEC'
 n=n+1; f.n='M9IOBUF EXEC'
 n=n+1; f.n='M9JLIVE EXEC'
 n=n+1; f.n='M9JOBJ EXEC'
 n=n+1; f.n='M9JSTRM EXEC'
 n=n+1; f.n='M9JZLIB EXEC'
 n=n+1; f.n='M9KWALK EXEC'
 n=n+1; f.n='M9LBDAPP EXEC'
 n=n+1; f.n='M9LOFS EXEC'
 n=n+1; f.n='M9MREF EXEC'
 n=n+1; f.n='M9NSTRES EXEC'
 n=n+1; f.n='M9NSTRM EXEC'
 n=n+1; f.n='M9O4096 EXEC'
 n=n+1; f.n='M9PBUF EXEC'
 n=n+1; f.n='M9PCHAIN EXEC'
 n=n+1; f.n='M9PCONS EXEC'
 n=n+1; f.n='M9PCTX EXEC'
 n=n+1; f.n='M9PINC EXEC'
end
if batch='BUILDDECK' then do
 n=0
 n=n+1; f.n='GITCABI ASSEMBLE'
 n=n+1; f.n='GITCINF ASSEMBLE'
 n=n+1; f.n='GITCPARS ASSEMBLE'
 n=n+1; f.n='GITCPROB ASSEMBLE'
 n=n+1; f.n='GITC2 ASSEMBLE'
 n=n+1; f.n='GITREC ASSEMBLE'
 n=n+1; f.n='GITCIDX ASSEMBLE'
 n=n+1; f.n='GITCWALK ASSEMBLE'
 n=n+1; f.n='GITSEL ASSEMBLE'
end
/* RECENTGEN: regenerated C build decks, TEXT and LISTING. */
/* Keep C source, active MODULEs and handwritten ASSEMBLE. */
if batch='RECENTGEN' then do
 n=0
 n=n+1; f.n='GITRP6M ASSEMBLE'
 n=n+1; f.n='GITRP6M TEXT'
 n=n+1; f.n='GITRP6M LISTING'
 n=n+1; f.n='GITVO7M ASSEMBLE'
 n=n+1; f.n='GITVO7M TEXT'
 n=n+1; f.n='GITVO7M LISTING'
 n=n+1; f.n='GITP21M ASSEMBLE'
 n=n+1; f.n='GITP21M TEXT'
 n=n+1; f.n='GITP21M LISTING'
 n=n+1; f.n='GITP24M ASSEMBLE'
 n=n+1; f.n='GITP24M TEXT'
 n=n+1; f.n='GITP24M LISTING'
 n=n+1; f.n='GITP25M ASSEMBLE'
 n=n+1; f.n='GITP25M TEXT'
 n=n+1; f.n='GITP25M LISTING'
 n=n+1; f.n='GITP26M ASSEMBLE'
 n=n+1; f.n='GITP26M TEXT'
 n=n+1; f.n='GITP26M LISTING'
 n=n+1; f.n='GITBX9 TEXT'
 n=n+1; f.n='GITBX9 LISTING'
end
/* PACKGEN: C-generated standalone build decks and byproducts. */
/* Keep all source C, runnable MODULE, linked core, and data. */
if batch='PACKGEN' then do
 n=0
 n=n+1; f.n='GITPCENS ASSEMBLE'
 n=n+1; f.n='GITPCENS TEXT'
 n=n+1; f.n='GITPCENS LISTING'
 n=n+1; f.n='GITPCHK ASSEMBLE'
 n=n+1; f.n='GITPCHK TEXT'
 n=n+1; f.n='GITPCHK LISTING'
 n=n+1; f.n='GITPIMP ASSEMBLE'
 n=n+1; f.n='GITPIMP TEXT'
 n=n+1; f.n='GITPIMP LISTING'
 n=n+1; f.n='GITPIDX ASSEMBLE'
 n=n+1; f.n='GITPIDX TEXT'
 n=n+1; f.n='GITPIDX LISTING'
 n=n+1; f.n='GITPCAT ASSEMBLE'
 n=n+1; f.n='GITPCAT TEXT'
 n=n+1; f.n='GITPCAT LISTING'
 n=n+1; f.n='GITPTRE ASSEMBLE'
 n=n+1; f.n='GITPTRE TEXT'
 n=n+1; f.n='GITPTRE LISTING'
 n=n+1; f.n='GITPFST ASSEMBLE'
 n=n+1; f.n='GITPFST TEXT'
 n=n+1; f.n='GITPFST LISTING'
 n=n+1; f.n='GITPPRF ASSEMBLE'
 n=n+1; f.n='GITPPRF TEXT'
 n=n+1; f.n='GITPPRF LISTING'
 n=n+1; f.n='GITPONE ASSEMBLE'
 n=n+1; f.n='GITPONE TEXT'
 n=n+1; f.n='GITPONE LISTING'
 n=n+1; f.n='GITPHX ASSEMBLE'
 n=n+1; f.n='GITPHX TEXT'
 n=n+1; f.n='GITPHX LISTING'
 n=n+1; f.n='GITPHXM ASSEMBLE'
 n=n+1; f.n='GITPHXM TEXT'
 n=n+1; f.n='GITPHXM LISTING'
 n=n+1; f.n='GITPH5M ASSEMBLE'
 n=n+1; f.n='GITPH5M TEXT'
 n=n+1; f.n='GITPH5M LISTING'
 n=n+1; f.n='GITPH8M ASSEMBLE'
 n=n+1; f.n='GITPH8M TEXT'
 n=n+1; f.n='GITPH8M LISTING'
 n=n+1; f.n='GITPSKM ASSEMBLE'
 n=n+1; f.n='GITPSKM TEXT'
 n=n+1; f.n='GITPSKM LISTING'
 n=n+1; f.n='GITPRBM ASSEMBLE'
 n=n+1; f.n='GITPRBM TEXT'
 n=n+1; f.n='GITPRBM LISTING'
 n=n+1; f.n='GITRCNM ASSEMBLE'
 n=n+1; f.n='GITRCNM TEXT'
 n=n+1; f.n='GITRCNM LISTING'
end
/* NETTRACE: old SSL/TCP diagnostic OUTPUTS only, not source. */
/* Preserve SSLPOOL service logs and live TCP/SSL configuration. */
if batch='NETTRACE' then do
 n=0
 n=n+1; f.n='SSLDBG DATA'
 n=n+1; f.n='SSLDB2 DATA'
 n=n+1; f.n='SSLDB3 DATA'
 n=n+1; f.n='SSLDB4 DATA'
 n=n+1; f.n='SSLDB5 DATA'
 n=n+1; f.n='SSL1LOG DATA'
 n=n+1; f.n='SSL3TRC DATA'
 n=n+1; f.n='TCPTRACE DATA'
 n=n+1; f.n='TCPTRC2 DATA'
 n=n+1; f.n='TCPTRC3 DATA'
 n=n+1; f.n='M12TRACE TCPIP'
end
say 'ACLEAN' verb batch 'ITEMS' n
selected=0
removed=0
do i=1 to n
 parse var f.i fn ft extra
 if extra\='' then do
  say 'ACLEAN BAD MANIFEST'
  exit 8
 end
 'STATE' fn ft 'A'
 statecode=rc
 if statecode=28 then iterate
 if statecode\=0 then do
  say 'ACLEAN STATE FAIL' fn ft 'RC' statecode
  exit 8
 end
 selected=selected+1
 say 'ACLEAN FOUND' fn ft 'A'
 if verb='APPLY' then do
  if batch='RECENTGEN' | batch='PACKGEN' then do
   if fn='GITBX9' then srcft='ASSEMBLE'
   else srcft='C'
   'STATE' fn srcft 'A'
   if rc\=0 then do
    say 'ACLEAN SOURCE NOT VERIFIED' fn srcft 'A RC' rc
    exit 8
   end
   'STATE' fn 'MODULE A'
   if rc\=0 then do
    say 'ACLEAN MODULE NOT VERIFIED' fn 'RC' rc
    exit 8
   end
  end
  'ERASE' fn ft 'A'
  if rc\=0 then do
   say 'ACLEAN ERASE FAILED' fn ft 'RC' rc
   exit 8
  end
  removed=removed+1
 end
end
say 'ACLEAN' verb batch 'FOUND' selected 'REMOVED' removed
if verb='APPLY' then 'QUERY DISK A'
exit 0

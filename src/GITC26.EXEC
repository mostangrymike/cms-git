/* M206: stratified index sample, full SHA with exact cleanup. */
address cms
parse upper arg fm mode max requested extra
/* New OBJECTS route is isolated; CHECK/RUN stay byte-exact below. */
if mode='OBJECTS' | mode='OBJECTSRUN' then do
 if fm\='G' | datatype(max,'W')\=1 then exit 4
 if max<1 | max>64 then exit 4
 members=strip(requested ' ' extra)
 count=words(members)
 if count<2 | count>8 then exit 4
 drop obj.
 do i=1 to count
  obj.i=word(members,i)
  if datatype(obj.i,'W')\=1 then exit 4
  if obj.i<1 | obj.i>7736 then exit 4
  do j=1 to i-1
   if obj.i=obj.j then exit 4
  end
 end
 /* Keep the M203 object list and limit bindings exact. */
 drop objs.
 do i=1 to count
  objs.i=obj.i
 end
 limit=max
 signal objectpath
end
if fm\='G' | (mode\='CHECK' & mode\='RUN') then exit 4
if extra\='' then exit 4
if datatype(max,'W')\=1 then exit 4
if datatype(requested,'W')\=1 then exit 4
if max<1 | max>64 then exit 4
count=requested
if count<2 | count>32 then exit 4
drop d.
d.0=0
'PIPE CMS QUERY DISK G | STEM d.'
if rc\=0 then exit 8
ok=0
do i=1 to d.0
 if word(d.i,3)='G' & word(d.i,7)='4096' then ok=ok+1
end
if ok\=1 then exit 8
'STATE M173NET STAGE G'
if rc\=0 then exit 8
'STATE M174NET INDEX G'
if rc\=0 then exit 8
'STATE GITP26M MODULE A'
if rc\=0 then exit 8
'STATE GITB9 EXEC A'
if rc\=0 then exit 8
'STATE GITBX9 MODULE A'
if rc\=0 then exit 8
'STATE GITVO7M MODULE A'
if rc\=0 then exit 8
'STATE GITCLN EXEC A'
if rc\=0 then exit 8
'STATE GITVRAW DATA A'
if rc\=28 then exit 8
'STATE GITR199 DATA A'
if rc\=28 then exit 8
drop f.
f.0=0
'PIPE CMS FILEDEF | STEM f.'
if rc\=0 then exit 8
do i=1 to f.0
 name=word(translate(f.i),1)
 if name='IDXIN' | name='OBJIN' then exit 8
end
'FILEDEF IDXIN DISK M174NET INDEX G'
if rc\=0 then exit 8
drop plan.
plan.0=0
'PIPE CMS GITP26M SAMPLE 3864799' max count '| STEM plan.'
readrc=rc
'FILEDEF IDXIN CLEAR'
clearrc=rc
if readrc\=0 | clearrc\=0 | plan.0\=count then do
 say 'M206 INDEX PLAN CAPTURE FAIL' readrc clearrc plan.0
 exit 8
end
drop span.
do i=1 to count
 parse upper var plan.i tag n hdr cnt typ size oid extra
 if tag\='P201' | extra\='' then exit 8
 if datatype(n,'W')\=1 | datatype(hdr,'W')\=1 then exit 8
 if datatype(cnt,'W')\=1 | datatype(typ,'W')\=1 then exit 8
 if datatype(size,'W')\=1 then exit 8
 low=trunc((i-1)*7736/count)+1
 high=trunc(i*7736/count)
 if n<low | n>high | hdr<1 | hdr>3864799 then exit 8
 if cnt<1 | cnt>max | hdr+cnt>3864799 then exit 8
 if typ<1 | typ>4 | size<1 | size>2048 then exit 8
 if cnt\=trunc((size+31)/32) then exit 8
 if length(oid)\=40 then exit 8
 if verify(oid,'0123456789ABCDEF')\=0 then exit 8
 span.i=n hdr cnt oid
 say 'M206 BAND OBJECT VERIFIED' i n hdr cnt typ size
 say 'M206 EXPECTED OID' i oid
end
'STATE GITR199 DATA A'
if rc\=28 then exit 8
say 'M206 STRATIFIED INDEX PLANS PASS' count
if mode='CHECK' then do
 say 'M206 SAMPLE CHECK NO SCRATCH PASS' count
 exit 0
end
do i=1 to count
 'STATE GITR199 DATA A'
 if rc\=28 then exit 8
 'GITB9 G' span.i
 authrc=rc
 if authrc\=0 then do
  say 'M206 SHA FAILED SCRATCH PRESERVED' i word(span.i,1)
  exit 8
 end
 say 'M206 FULL SHA VERIFIED' i word(span.i,1)
 'GITCLN SCRATCH'
 cleanrc=rc
 if cleanrc\=0 then exit 8
 'STATE GITR199 DATA A'
 if rc\=28 then exit 8
 say 'M206 SCRATCH CLEAN VERIFIED' i word(span.i,1)
end
say 'M206 STRATIFIED FULL SHA CLEAN PASS' count
exit 0

/* Inline original M203 run path; GITC23 remains rollback. */
objectpath:
'STATE GITP21 EXEC A'
if rc\=0 then exit 8
'STATE GITP21M MODULE A'
if rc\=0 then exit 8
'STATE GITB9 EXEC A'
if rc\=0 then exit 8
'STATE GITBX9 MODULE A'
if rc\=0 then exit 8
'STATE GITVO7M MODULE A'
if rc\=0 then exit 8
'STATE GITCLN EXEC A'
if rc\=0 then exit 8
'STATE GITVRAW DATA A'
if rc\=28 then do
 say 'M203 OLD SCRATCH EXISTS OR STATE UNKNOWN'
 exit 8
end
'STATE GITR199 DATA A'
if rc\=28 then do
 say 'M203 CURRENT SCRATCH EXISTS OR STATE UNKNOWN'
 exit 8
end
drop defs.
defs.0=0
'PIPE CMS FILEDEF | STEM defs.'
if rc\=0 then exit 8
do i=1 to defs.0
 name=word(translate(defs.i),1)
 if name='IDXIN' | name='OBJIN' then do
  say 'M203 CALLER FILEDEF CONFLICT'
  exit 8
 end
end
say 'M203 BOUNDED INDEX PREFLIGHT BEGIN' count
do i=1 to count
 say 'M203 INDEX CHECK BEGIN' i objs.i
 'GITP21 G' objs.i limit 'CHECK'
 c=rc
 if c\=0 then do
  say 'M203 INDEX PREFLIGHT FAIL' i objs.i c
  exit 8
 end
 say 'M203 INDEX CHECK PASS' i objs.i
end
say 'M203 ALL INDEX CHECKS PASS' count
if mode='OBJECTS' then do
 say 'M203 CHECK ONLY NO SCRATCH PASS' count
 say 'M206 OBJECTS PREFLIGHT PASS' count
 exit 0
end
do i=1 to count
 obj=objs.i
 say 'M203 FULL OBJECT SHA BEGIN' i obj
 'STATE GITR199 DATA A'
 if rc\=28 then do
  say 'M203 SCRATCH COLLISION BEFORE OBJECT' obj
  exit 8
 end
 'GITP21 G' obj limit
 s=rc
 if s\=0 then do
  say 'M203 SHA GATE FAIL SCRATCH PRESERVED' i obj s
  exit 8
 end
 say 'M203 FULL OBJECT SHA VERIFIED' i obj
 /* GITCLN is exact A1 whitelist. Old GITVRAW is absent. */
 'GITCLN SCRATCH'
 c=rc
 if c\=0 then do
  say 'M203 CLEANUP FAILED STOP' i obj c
  exit 8
 end
 'STATE GITR199 DATA A'
 if rc\=28 then do
  say 'M203 SCRATCH REMOVAL NOT VERIFIED' obj
  exit 8
 end
 say 'M203 CLEAN VERIFIED' i obj
end
say 'M203 BOUNDED FULL SHA CLEAN PASS' count
say 'M206 OBJECTS AUTHENTICATION PASS' count
exit 0

/* M195: isolated read-only LAST full-body-record probe. */
address cms
parse upper arg fm probe extra
if fm\='G' | probe\='LAST' | extra\='' then do
 say 'Usage: GITFLP G LAST'
 exit 4
end
drop d.
d.0=0
'PIPE CMS QUERY DISK G | STEM d.'
if rc\=0 then exit 8
ok=0
do i=1 to d.0
 if word(d.i,3)='G' & word(d.i,7)='4096' then ok=ok+1
end
if ok\=1 then do
 say 'M195 G DISK NOT ACCESSED 4K'
 exit 8
end
'STATE M173NET STAGE G'
if rc\=0 then exit 8
'STATE M174NET INDEX G'
if rc\=0 then exit 8
'STATE GITFL10 MODULE A'
if rc\=0 then do
 say 'M195 MODULE MISSING'
 exit 8
end
say 'M195 DIRECT LAST COMPLETE BODY PROBE BEGIN'
'GITFL10'
workrc=rc
if workrc\=0 then do
 say 'M195 COMPLETE BODY GATE FAIL RC' workrc
 exit 8
end
say 'M195 COMPLETE BODY GATE PASS G LAST'
exit 0

/* M282: GIT GC / REPACK - reachable-object pack creation.
 *
 * Usage: GIT GC [--prune=now]
 *        GIT REPACK
 *
 * Either command accepts LIMIT=n to pack only the first n reachable objects
 * (bounded validation runs; the full closure is packed without it). LIMIT
 * cannot be combined with pruning.
 *
 * GC: Enumerate all objects reachable from refs, pack them into a single
 *     packfile.  --prune=now additionally deletes unreachable loose objects.
 * REPACK: Pack reachable objects into a single packfile.  Object deletion
 *         and all-loose-object repacking are disabled until supported.
 *
 * Pack files are stored on the object disk as PACKnnnn PACK files.
 */
address cms
numeric digits 20
parse arg cmd rest
cmd=translate(cmd)
extra=strip(rest)

/* Defaults */
prune=0
packlimit=0

do while extra\=''
   parse var extra opt extra
   opt=translate(strip(opt))
   if left(opt,6)='LIMIT=' then do
      lv=substr(opt,7)
      if datatype(lv,'W')\=1 | lv<1 | lv>100000 then do
         say 'GIT GC: invalid LIMIT value' lv
         exit 4
      end
      packlimit=lv
      iterate
   end
   if cmd='GC' then do
      if opt='--PRUNE=NOW' then prune=1
      else if opt='--AGGRESSIVE' then do
         say 'GIT GC: --aggressive is not implemented'
         exit 4
      end
      else do
         say 'GIT GC: unknown option' opt
         say 'Usage: GIT GC [--prune=now] [LIMIT=n]'
         exit 4
      end
   end
   else if cmd='REPACK' then do
      if opt='-D' then do
         say 'GIT REPACK: -d is disabled; packed objects are not readable yet'
         exit 4
      end
      else if opt='-A' then do
         say 'GIT REPACK: -a is not implemented'
         exit 4
      end
      else do
         say 'GIT REPACK: unknown option' opt
         say 'Usage: GIT REPACK [LIMIT=n]'
         exit 4
      end
   end
end

if cmd\='GC' & cmd\='REPACK' then do
   say 'Usage: GIT GC [--prune=now] [LIMIT=n]'
   say '       GIT REPACK [LIMIT=n]'
   exit 4
end

if cmd='GC' & prune=1 & packlimit>0 then do
   say 'GIT GC: LIMIT cannot be combined with --prune=now'
   exit 4
end

/* Object disk from GITMETA. */
objectfm='G'
'STATE GITMETA REPO G'
mstate=rc
if mstate=0 then do
   drop config.
   config.0=0
   'EXECIO * DISKR GITMETA REPO G 1 (STEM CONFIG. FINIS'
   if rc=0 & config.0>=4 & config.1='CMS-GIT-REPOSITORY 1' then do
      objectrecords=0
      do ci=1 to config.0
         if word(config.ci,1)='OBJECT-DISK' then do
            if words(config.ci)\=2 then do
               say 'GIT GC: invalid OBJECT-DISK setting'
               exit 8
            end
            objectrecords=objectrecords+1
            objectfm=translate(word(config.ci,2))
         end
      end
      if objectrecords>1 | length(objectfm)\=1 |,
         verify(objectfm,'ABCDEFGHIJKLMNOPQRSTUVWXYZ')\=0 then do
         say 'GIT GC: invalid OBJECT-DISK setting'
         exit 8
      end
      if objectfm\='G' then do
         say 'GIT GC: repository OBJECT-DISK must be G'
         exit 8
      end
   end
end
else if mstate\=28 then do
   say 'GIT GC: cannot inspect repository metadata RC' mstate
   exit 8
end

/* Read all refs from REF2. */
drop ref2.
ref2.0=0
'EXECIO * DISKR GITREF2 REPO G 1 (STEM REF2. FINIS'
if rc\=0 | REF2.0<2 | word(REF2.1,1)\='REF2' |,
   word(REF2.1,2)\='1' then do
   say 'GIT GC: cannot read REF2 repository state'
   exit 8
end
headref=''
refcount=0
do ri=2 to REF2.0
   if word(REF2.ri,1)='HEAD' then do
      if words(REF2.ri)\=2 then do
         say 'GIT GC: invalid HEAD record'
         exit 8
      end
      headref=word(REF2.ri,2)
   end
   else if word(REF2.ri,1)='REF' then do
      if words(REF2.ri)\=3 then do
         say 'GIT GC: invalid REF record'
         exit 8
      end
      refcount=refcount+1
      refname.refcount=word(REF2.ri,2)
      refoid.refcount=translate(word(REF2.ri,3))
   end
end

if refcount=0 then do
   say 'GIT GC: no refs found; nothing to pack'
   exit 0
end

say 'GIT GC: found' refcount 'ref(s)'

/* Enumerate all reachable objects from all refs. */
drop objlist.
objlist.0=0
drop objsseen.
objsseen.0=0
drop reachable.
reachable.0=0

do ri=1 to refcount
   rtoid=refoid.ri
   rname=refname.ri
   if length(rtoid)\=40 | verify(rtoid,'0123456789ABCDEF')\=0 then do
      say 'GIT GC: invalid OID for ref' rname rtoid
      exit 8
   end
   say 'GIT GC: walking' rname '=' rtoid
   call walk_commit rtoid
end

say 'GIT GC: enumerated' objlist.0 'reachable object(s)'

if packlimit>0 & objlist.0>packlimit then do
   say 'GIT GC: LIMIT active; packing' packlimit 'of' objlist.0 'object(s)'
   objlist.0=packlimit
end

if objlist.0=0 then do
   say 'GIT GC: no reachable objects; nothing to pack'
   exit 0
end

/* Determine pack file number. */
packnum=0
do forever
   packnum=packnum+1
   packfn='PACK'||right(packnum,4,'0')
   'STATE' packfn 'PACK' objectfm
   if rc=28 then leave
   if rc\=0 then do
      say 'GIT GC: cannot check pack file' packfn
      exit 8
   end
end

packfn='PACK'||right(packnum,4,'0')
say 'GIT GC: writing pack' packfn

/* Write staging file for GITPMK.  GITPMK reads the literal CMS file
   OBJSTG STAGE <fm> and writes OBJOUT STAGE <fm>. */
stagefn='OBJSTG'
'STATE' stagefn 'STAGE' objectfm
stagerc=rc
if stagerc=0 then do
   say 'GIT GC: staging file already exists' stagefn
   exit 8
end
if stagerc\=28 then do
   say 'GIT GC: staging STATE failed RC' stagerc
   exit 8
end
drop stgout.
sn=0
packed=0
do oi=1 to objlist.0
   oidcur=objlist.oi
   objfn=substr(oidcur,1,8)
   'EXECIO * DISKR' objfn 'GITOBJ' objectfm '1 (STEM OBJCUR. FINIS'
   if rc\=0 then do
      say 'GIT GC: cannot read object' oidcur
      exit 8
   end
   objtype=''
   objsize=0
   objhex=''
   do bi=1 to OBJCUR.0
      if word(OBJCUR.bi,1)='TYPE' then objtype=translate(word(OBJCUR.bi,2))
      else if word(OBJCUR.bi,1)='SIZE' then objsize=word(OBJCUR.bi,2)
      else if word(OBJCUR.bi,1)='DATA' then do
         objhex=objhex||translate(word(OBJCUR.bi,2))
      end
   end
   if objtype='' | objsize='' then do
      say 'GIT GC: corrupt object' oidcur
      exit 8
   end
   if length(objhex)%2\=objsize then do
      say 'GIT GC: object size mismatch' oidcur
      exit 8
   end
   if objtype='COMMIT' then objcode=1
   else if objtype='TREE' then objcode=2
   else if objtype='BLOB' then objcode=3
   else if objtype='TAG' then objcode=4
   else do
      say 'GIT GC: unknown object type' objtype oidcur
      exit 8
   end
   sn=sn+1
   stgout.sn='OBJ' objcode objsize oidcur
   pos=1
   do while pos<=length(objhex)
      take=min(64,length(objhex)-pos+1)
      sn=sn+1
      stgout.sn=substr(objhex,pos,take)
      pos=pos+take
   end
   if objsize=0 then do
      sn=sn+1
      stgout.sn=''
   end
   packed=packed+1
end
stgout.0=sn
'EXECIO' sn 'DISKW' stagefn 'STAGE' objectfm '1 (STEM STGOUT. FINIS'
if rc\=0 then do
   say 'GIT GC: staging write failed'
   exit 8
end

/* Build packfile.  Prefer the native GITPMKC module when it is available;
   it is far faster than the pure-REXX GITPMK on large closures. */
say 'GIT GC: building pack' packfn' with' packed 'object(s)...'
'STATE OBJOUT STAGE' objectfm
if rc=0 then 'ERASE OBJOUT STAGE' objectfm
'STATE GITPMKC MODULE G'
nativepmk=(rc=0)
if nativepmk then do
   say 'GIT GC: using native GITPMKC builder'
   'FILEDEF OBJSTG DISK' stagefn 'STAGE' objectfm
   'FILEDEF OBJOUT DISK OBJOUT STAGE' objectfm ' (RECFM V LRECL 255'
   'GITPMKC BUILD HEX'
   pmkrc=rc
   'FILEDEF OBJSTG CLEAR'
   'FILEDEF OBJOUT CLEAR'
end
else do
   say 'GIT GC: using REXX GITPMK builder'
   'EXEC GITPMK BUILD' objectfm
   pmkrc=rc
end
if pmkrc\=0 then do
   say 'GIT GC: pack creation failed'
   exit 8
end
'STATE OBJOUT STAGE' objectfm
if rc\=0 then do
   say 'GIT GC: pack output not created'
   exit 8
end
/* GITPMK writes OBJOUT STAGE <fm>; promote it to the final pack name. */
'RENAME OBJOUT STAGE' objectfm packfn 'PACK' objectfm
if rc\=0 then do
   say 'GIT GC: pack rename failed'
   exit 8
end
'ERASE' stagefn 'STAGE' objectfm
'STATE' packfn 'PACK' objectfm
if rc\=0 then do
   say 'GIT GC: pack file not created'
   exit 8
end

say 'GIT GC: pack' packfn' created with' packed 'object(s)'

/* Prune unreachable loose objects (GC only). */
if cmd='GC' & prune=1 then do
   say 'GIT GC: pruning unreachable loose objects...'
   pruned=0
   kept=0
   /* Enumerate all GITOBJ files on the object disk. */
   'FILEDEF OBJENUM DISK * GITOBJ' objectfm
   if rc\=0 then do
      say 'GIT GC: cannot enumerate GITOBJ files'
      exit 8
   end
   drop enum.
   enum.0=0
   'EXECIO * DISKR * GITOBJ' objectfm '1 (STEM ENUM. FINIS'
   enumrc=rc
   'FILEDEF OBJENUM CLEAR'
   if enumrc\=0 then do
      say 'GIT GC: cannot enumerate loose objects RC' enumrc
      exit 8
   end
   do ei=1 to enum.0
      if word(enum.ei,1)\='GITOBJ' then iterate
      objfn=enum.ei
      /* Check if this object is reachable. */
      isreach=0
      do oi=1 to objlist.0
         if substr(objlist.oi,1,8)=objfn then do
            isreach=1
            leave
         end
      end
      if isreach=0 then do
         'ERASE' objfn 'GITOBJ' objectfm
         if rc\=0 then do
            say 'GIT GC: cannot erase unreachable object' objfn
         end
         else pruned=pruned+1
      end
      else kept=kept+1
   end
   say 'GIT GC: pruned' pruned 'unreachable object(s), kept' kept 'reachable'
end

say 'GIT GC: done'
exit 0

/* ======================================================================== */
/* Helper routines                                                          */
/* ======================================================================== */

/* Walk a commit and all reachable objects iteratively (BFS). */
walk_commit: procedure expose objlist. objsseen. objectfm
   parse arg cmt
   drop cqueue.
   cqueue.0=1
   cqueue.1=cmt
   cnext=1
   do while cnext<=cqueue.0
      current=cqueue.cnext
      cnext=cnext+1
      seen=0
      do si=1 to objsseen.0
         if objsseen.si=current then do
            seen=1
            leave
         end
      end
      if seen then iterate
      objsseen.0=objsseen.0+1
      objsseenx=objsseen.0
      objsseen.objsseenx=current
      objlist.0=objlist.0+1
      objlistx=objlist.0
      objlist.objlistx=current

      /* Read commit object. */
      objfn=substr(current,1,8)
      drop cmtobj.
      cmtobj.0=0
      'EXECIO * DISKR' objfn 'GITOBJ' objectfm '1 (STEM CMTOBJ. FINIS'
      if rc\=0 then do
         say 'GIT GC: cannot read commit' current
         exit 8
      end
      ctype=''
      cdata=''
      do bi=1 to CMTOBJ.0
         if word(CMTOBJ.bi,1)='TYPE' then,
            ctype=translate(word(CMTOBJ.bi,2))
         else if word(CMTOBJ.bi,1)='DATA' then,
            cdata=cdata||translate(word(CMTOBJ.bi,2))
      end
      if ctype\='COMMIT' then do
         say 'GIT GC: object is not a commit' current
         exit 8
      end
      cdata=translate(cdata)

      /* Parse tree OID from commit data. */
      treepos=pos('7472656520',cdata)
      if treepos=0 then do
         say 'GIT GC: commit has no tree' current
         exit 8
      end
      /* The commit body is hex-encoded ASCII: a 40-character OID is
         80 hex columns.  X2C alone yields EBCDIC code points, so
         translate through the ASCII table (see asciitocms). */
      call asciitocms substr(cdata,treepos+10,80)
      treeoid=translate(result)
      if length(treeoid)\=40 |,
         verify(treeoid,'0123456789ABCDEF')\=0 then do
         say 'GIT GC: invalid tree OID in commit' current
         exit 8
      end

      /* Walk the commit tree and all of its subtrees. */
      call walk_tree treeoid

      /* Enqueue parents for processing. */
      ppos=1
      do forever
         ppos=pos('706172656E7420',cdata,ppos)
         if ppos=0 then leave
         call asciitocms substr(cdata,ppos+14,80)
         poid=translate(result)
         if length(poid)=40 &,
            verify(poid,'0123456789ABCDEF')=0 then do
            cqueue.0=cqueue.0+1
            cqueuex=cqueue.0
            cqueue.cqueuex=poid
         end
         ppos=ppos+96
      end
   end
   return

/* Walk a tree object and enqueue all referenced objects iteratively. */
walk_tree: procedure expose objlist. objsseen. objectfm
   parse arg treeoid
   drop tqueue.
   tqueue.0=1
   tqueue.1=treeoid
   tnext=1
   do while tnext<=tqueue.0
      current=tqueue.tnext
      tnext=tnext+1
      seen=0
      do si=1 to objsseen.0
         if objsseen.si=current then do
            seen=1
            leave
         end
      end
      if seen then iterate
      objsseen.0=objsseen.0+1
      objsseenx=objsseen.0
      objsseen.objsseenx=current
      objlist.0=objlist.0+1
      objlistx=objlist.0
      objlist.objlistx=current

      /* Read tree object. */
      objfn=substr(current,1,8)
      drop treeobj.
      treeobj.0=0
      'EXECIO * DISKR' objfn 'GITOBJ' objectfm '1 (STEM TREEOBJ. FINIS'
      if rc\=0 then do
         say 'GIT GC: cannot read tree' current
         exit 8
      end
      tdata=''
      do bi=1 to treeobj.0
         if word(treeobj.bi,1)='DATA' then,
            tdata=tdata||translate(word(treeobj.bi,2))
      end
      tdata=translate(tdata)

      /* Parse tree entries. */
      tpos=1
      do while tpos<=length(tdata)-2
         mend=tpos
         do while tpos<=length(tdata)-2 &,
            substr(tdata,tpos,2)\='20'
            tpos=tpos+2
         end
         if tpos>length(tdata)-2 then leave
         modehex=substr(tdata,mend,tpos-mend)
         tpos=tpos+2
         do while tpos<=length(tdata)-2 &,
            substr(tdata,tpos,2)\='00'
            tpos=tpos+2
         end
         if tpos>length(tdata)-2 then leave
         tpos=tpos+2
         childoid=substr(tdata,tpos,40)
         tpos=tpos+40
         if length(childoid)\=40 then do
            say 'GIT GC: invalid entry OID in tree' current
            exit 8
         end
         if verify(childoid,'0123456789ABCDEF')\=0 then do
            say 'GIT GC: invalid entry OID in tree' current
            exit 8
         end
         /* Mode 40000 (hex 3430303030) is a subtree. */
         if modehex='3430303030' then do
            tqueue.0=tqueue.0+1
            tqueuex=tqueue.0
            tqueue.tqueuex=childoid
         end
         else do
            /* Blob (or other leaf) - add to objlist directly. */
            isdup=0
            do si=1 to objsseen.0
               if objsseen.si=childoid then do
                  isdup=1
                  leave
               end
            end
            if isdup\=1 then do
               objsseen.0=objsseen.0+1
               objsseenx=objsseen.0
               objsseen.objsseenx=childoid
               objlist.0=objlist.0+1
               objlistx=objlist.0
               objlist.objlistx=childoid
            end
         end
      end
   end
   return

asciitocms: procedure
 /* Convert an even-length ASCII hex string to CMS characters.  X2C alone
    yields EBCDIC code points, so translate through the ASCII table. */
 parse arg ah
 if ah='' then return ''
 if length(ah)//2\=0 then return 'ERROR'
 ah=translate(ah)
 do ai=1 to length(ah)
  if pos(substr(ah,ai,1),'0123456789ABCDEF')=0 then return 'ERROR'
 end
 ascii=x2c(ah)
 e2a='000102031A091A7F1A1A1A0B0C0D0E0F'
 e2a=e2a||'101112131A1A081A18191A1A1C1D1E1F'
 e2a=e2a||'1A1A1C1A1A0A171B1A1A1A1A1A050607'
 e2a=e2a||'1A1A161A1A1E1A041A1A1A1A14151A1A'
 e2a=e2a||'20A6E180EB909FE2AB8B9B2E3C282B7C'
 e2a=e2a||'26A9AA9CDBA599E3A89E21242A293B5E'
 e2a=e2a||'2D2FDFDC9ADDDE989DACBA2C255F3E3F'
 e2a=e2a||'D78894B0B1B2FCD6FB603A2340273D22'
 e2a=e2a||'F861626364656667686996A4F3AFAEC5'
 e2a=e2a||'8C6A6B6C6D6E6F7071729787CE93F1FE'
 e2a=e2a||'C87E737475767778797AEFC0DA5BF2F9'
 e2a=e2a||'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4'
 e2a=e2a||'7B414243444546474849CBCABEE8ECED'
 e2a=e2a||'7D4A4B4C4D4E4F505152A1ADF5F4A38F'
 e2a=e2a||'5CE7535455565758595AA0858EE9E4D1'
 e2a=e2a||'30313233343536373839B3F7F0FAA7FF'
 if length(e2a)\=512 then return 'ERROR'
 tab=x2c(e2a)
 bytes=xrange('00'x,'FF'x)
 return translate(ascii,bytes,tab)

/* M203 compatibility entry: canonical worker now lives in GITC26. */
address cms
parse upper arg fm mode limit members
if fm\='G' | (mode\='CHECK' & mode\='RUN') then do
 say 'Usage: GITC23 G CHECK|RUN max-body obj1 obj2 ... obj8'
 exit 4
end
/* Delegate full input validation and scratch ownership to GITC26. */
route='OBJECTS'
if mode='RUN' then route='OBJECTSRUN'
'GITC26' fm route limit members
exit rc
